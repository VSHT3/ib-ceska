---
import type { Locale } from '../i18n/dictionaries';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === 'en' ? 'sk' : 'en';
const pathname = Astro.url.pathname;
const otherPath = '/' + otherLocale + pathname.slice(pathname.indexOf('/', 1));
---

<span class="text-xs font-medium tracking-wide text-stone-500">
  <span class={locale === 'en' ? 'text-emerald-700' : ''}>EN</span>
  <span class="mx-1 text-stone-300">/</span>
  <a href={otherPath} class={locale === 'sk' ? 'text-emerald-700' : 'hover:text-emerald-700 transition-colors'}>SK</a>
</span>
