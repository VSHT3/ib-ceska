---
import type { Locale } from '../i18n/dictionaries';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
// Strip the locale prefix; works for "/en", "/en/", and "/en/subjects"
const rest = pathname.replace(/^\/(en|sk)(?=\/|$)/, '') || '/';
const pathFor = (target: Locale) => `/${target}${rest}`;
const locales: { code: Locale; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'sk', label: 'SK' },
];
---

<div
  class="flex items-center rounded-full border border-stone-200 bg-stone-100 p-0.5 text-xs font-semibold tracking-wide"
  role="group"
  aria-label="Language"
>
  {
    locales.map(({ code, label }) =>
      code === locale ? (
        <span
          aria-current="true"
          class="rounded-full bg-white px-2.5 py-1 text-emerald-700 shadow-sm"
        >
          {label}
        </span>
      ) : (
        <a
          href={pathFor(code)}
          data-lang-switch
          class="rounded-full px-2.5 py-1 text-stone-500 transition-colors hover:text-emerald-700"
        >
          {label}
        </a>
      ),
    )
  }
</div>
