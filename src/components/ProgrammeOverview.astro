---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { l } from '../i18n/dictionaries';
import type { Locale } from '../i18n/dictionaries';

interface Principle {
  title: string;
  body: string;
}

interface LinkItem {
  label: string;
  body: string;
  href: string;
}

interface Programme {
  title: string;
  shortTitle: string;
  subtitle: string;
  age: string;
  duration: string;
  label: string;
  introTitle: string;
  introBody: string;
  principlesLabel: string;
  principlesTitle: string;
  principles: Principle[];
  curriculumLabel: string;
  curriculumTitle: string;
  curriculumBody: string;
  curriculumItems: string[];
  featureLabel: string;
  featureTitle: string;
  featureBody: string;
  links: LinkItem[];
  note?: string;
  officialUrl: string;
  officialLink: string;
  exploreLink: string;
  admissionsTitle: string;
  admissionsBody: string;
  admissionsLink: string;
}

interface Props {
  locale: Locale;
  programme: Programme;
  tone: 'myp' | 'dp';
  image: ImageMetadata;
  imageAlt: string;
  logo?: string;
}

const { locale, programme, tone, image, imageAlt, logo } = Astro.props;
const isMyp = tone === 'myp';
const accentText = isMyp ? 'text-myp-700' : 'text-dp-700';
const accentTextHover = isMyp ? 'group-hover:text-myp-700' : 'group-hover:text-dp-700';
const accentSoft = isMyp ? 'bg-myp-50' : 'bg-dp-50';
const accentDark = isMyp ? 'bg-myp-800' : 'bg-dp-800';
const accentButton = isMyp ? 'bg-myp-600 hover:bg-myp-700' : 'bg-dp-600 hover:bg-dp-700';
---

<Layout
  title={programme.title}
  description={programme.subtitle}
  locale={locale}
  pageSchemaType="Course"
  pageSchema={{
    name: programme.title,
    courseCode: programme.shortTitle,
    provider: { '@id': new URL('/#school', Astro.site).href },
  }}
>
  <!-- Hero (edge-to-edge split: brand panel + full-strength photo) -->
  <section class="grid items-stretch lg:grid-cols-2">
    <div
      class:list={[
        'flex items-center px-6 py-20 text-white sm:px-10 lg:px-16 lg:py-28',
        accentDark,
      ]}
    >
      <div class="max-w-xl">
        {
          logo && (
            <img
              src={logo}
              alt={`IB ${programme.shortTitle} logo`}
              class="mb-7 h-16 w-auto rounded-xl bg-white p-2 shadow-md sm:h-20"
              width="640"
              height="256"
            />
          )
        }
        <p class="text-xs font-semibold uppercase tracking-widest text-white/70">
          {programme.label}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
          {programme.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-white/80">{programme.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2"
            >{programme.age}</span
          >
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2"
            >{programme.duration}</span
          >
        </div>
      </div>
    </div>
    <div class="relative min-h-[20rem] lg:min-h-[34rem]">
      <Image
        src={image}
        alt={imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        widths={[768, 1024, 1280]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 sm:py-24">
    <!-- Intro (wide two-column editorial text) -->
    <section class="grid gap-8 lg:grid-cols-[0.85fr_1fr] lg:gap-16 items-start">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>
          {programme.shortTitle}
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          {programme.introTitle}
        </h2>
      </div>
      <div data-reveal style="--reveal-delay: 100ms">
        <p class="text-lg text-stone-600 leading-relaxed">{programme.introBody}</p>
        <a
          href={programme.officialUrl}
          target="_blank"
          rel="noopener"
          class:list={['mt-7 inline-flex text-sm font-semibold hover:underline', accentText]}
        >
          {programme.officialLink} ↗
        </a>
      </div>
    </section>

    <section class="mt-28">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>
          {programme.principlesLabel}
        </p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
          {programme.principlesTitle}
        </h2>
      </div>
      <div class="mt-8 border-t border-stone-300">
        {
          programme.principles.map((principle, i) => (
            <article
              class="grid gap-3 border-b border-stone-300 py-7 sm:grid-cols-[3rem_0.8fr_1.2fr] sm:gap-6"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class:list={['text-xs font-semibold pt-1', accentText]}>0{i + 1}</span>
              <h3 class="text-lg font-semibold">{principle.title}</h3>
              <p class="text-sm leading-relaxed text-stone-600">{principle.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-28 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div class:list={['rounded-3xl p-7 sm:p-10', accentSoft]} data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>
          {programme.curriculumLabel}
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {programme.curriculumTitle}
        </h2>
        <p class="mt-5 text-stone-600 leading-relaxed">
          {programme.curriculumBody}
        </p>
      </div>
      <ol class="grid gap-x-6 gap-y-1 sm:grid-cols-2" data-reveal style="--reveal-delay: 100ms">
        {
          programme.curriculumItems.map((item, i) => (
            <li class="flex gap-3 border-b border-stone-300 py-4 text-sm font-medium">
              <span class:list={['text-xs font-semibold', accentText]}>
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-28">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>
          {programme.featureLabel}
        </p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
          {programme.featureTitle}
        </h2>
        <p class="mt-4 max-w-2xl text-stone-600 leading-relaxed">
          {programme.featureBody}
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          programme.links.map((item, i) => (
            <a
              href={item.href.startsWith('/') ? l(item.href, locale) : item.href}
              class="group border-t border-stone-300 py-6"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <h3 class:list={['font-semibold transition-colors', accentTextHover]}>
                {item.label}
              </h3>
              <p class="mt-2 text-sm text-stone-500 leading-relaxed">{item.body}</p>
              <span
                class:list={[
                  'mt-4 block text-sm font-semibold group-hover:translate-x-1 transition-transform',
                  accentText,
                ]}
              >
                {programme.exploreLink} →
              </span>
            </a>
          ))
        }
      </div>
      {
        programme.note && (
          <p class="mt-8 max-w-3xl text-xs leading-relaxed text-stone-500">{programme.note}</p>
        )
      }
    </section>
  </div>

  <!-- Admissions (full-bleed brand band) -->
  <section class:list={['text-white', accentDark]} data-reveal>
    <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 sm:py-20">
      <div class="grid gap-7 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{programme.admissionsTitle}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-white/75">{programme.admissionsBody}</p>
        </div>
        <a
          href={l('/admissions', locale)}
          class:list={[
            'rounded-full px-6 py-3 text-center text-sm font-semibold text-white transition-colors',
            accentButton,
          ]}
        >
          {programme.admissionsLink}
        </a>
      </div>
    </div>
  </section>
</Layout>
