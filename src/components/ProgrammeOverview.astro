---
import Layout from '../layouts/Layout.astro';
import { l } from '../i18n/dictionaries';
import type { Locale } from '../i18n/dictionaries';

interface Principle {
  title: string;
  body: string;
}

interface LinkItem {
  label: string;
  body: string;
  href: string;
}

interface Programme {
  title: string;
  shortTitle: string;
  subtitle: string;
  age: string;
  duration: string;
  label: string;
  introTitle: string;
  introBody: string;
  principlesLabel: string;
  principlesTitle: string;
  principles: Principle[];
  curriculumLabel: string;
  curriculumTitle: string;
  curriculumBody: string;
  curriculumItems: string[];
  featureLabel: string;
  featureTitle: string;
  featureBody: string;
  links: LinkItem[];
  note?: string;
  officialUrl: string;
  officialLink: string;
  exploreLink: string;
  admissionsTitle: string;
  admissionsBody: string;
  admissionsLink: string;
}

interface Props {
  locale: Locale;
  programme: Programme;
  tone: 'amber' | 'emerald';
  image: string;
  imageAlt: string;
}

const { locale, programme, tone, image, imageAlt } = Astro.props;
const isMyp = tone === 'amber';
const accentText = isMyp ? 'text-amber-700' : 'text-emerald-700';
const accentSoft = isMyp ? 'bg-amber-50' : 'bg-emerald-50';
const accentDark = isMyp ? 'bg-amber-800' : 'bg-emerald-800';
const accentButton = isMyp ? 'bg-amber-600 hover:bg-amber-700' : 'bg-emerald-600 hover:bg-emerald-700';
---

<Layout title={programme.title} description={programme.subtitle} locale={locale}>
  <section class:list={['relative overflow-hidden text-white', accentDark]}>
    <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-25" />
    <div class="absolute inset-0 bg-gradient-to-r from-stone-950/60 via-stone-950/25 to-transparent" />
    <div class="relative mx-auto max-w-5xl px-6 py-24 sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-widest text-white/70">{programme.label}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">{programme.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{programme.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
        <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2">{programme.age}</span>
        <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2">{programme.duration}</span>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <section class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 items-start">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>{programme.shortTitle}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{programme.introTitle}</h2>
        <p class="mt-5 text-stone-600 leading-relaxed">{programme.introBody}</p>
        <a
          href={programme.officialUrl}
          target="_blank"
          rel="noopener"
          class:list={['mt-7 inline-flex text-sm font-semibold hover:underline', accentText]}
        >
          {programme.officialLink} ↗
        </a>
      </div>
      <img
        src={image}
        alt={imageAlt}
        class="h-72 w-full rounded-3xl object-cover shadow-lg sm:h-96"
        loading="lazy"
        data-reveal
        style="--reveal-delay: 100ms"
      />
    </section>

    <section class="mt-28">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>{programme.principlesLabel}</p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight">{programme.principlesTitle}</h2>
      </div>
      <div class="mt-8 border-t border-stone-300">
        {programme.principles.map((principle, i) => (
          <article
            class="grid gap-3 border-b border-stone-300 py-7 sm:grid-cols-[3rem_0.8fr_1.2fr] sm:gap-6"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class:list={['text-xs font-semibold pt-1', accentText]}>0{i + 1}</span>
            <h3 class="text-lg font-semibold">{principle.title}</h3>
            <p class="text-sm leading-relaxed text-stone-600">{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-28 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div class:list={['rounded-3xl p-7 sm:p-10', accentSoft]} data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>{programme.curriculumLabel}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">{programme.curriculumTitle}</h2>
        <p class="mt-5 text-stone-600 leading-relaxed">{programme.curriculumBody}</p>
      </div>
      <ol class="grid gap-x-6 gap-y-1 sm:grid-cols-2" data-reveal style="--reveal-delay: 100ms">
        {programme.curriculumItems.map((item, i) => (
          <li class="flex gap-3 border-b border-stone-300 py-4 text-sm font-medium">
            <span class:list={['text-xs font-semibold', accentText]}>{String(i + 1).padStart(2, '0')}</span>
            <span>{item}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-28">
      <div data-reveal>
        <p class:list={['text-xs font-semibold uppercase tracking-widest', accentText]}>{programme.featureLabel}</p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight">{programme.featureTitle}</h2>
        <p class="mt-4 max-w-2xl text-stone-600 leading-relaxed">{programme.featureBody}</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {programme.links.map((item, i) => (
          <a
            href={item.href.startsWith('/') ? l(item.href, locale) : item.href}
            class="group border-t border-stone-300 py-6"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <h3 class="font-semibold group-hover:text-emerald-700 transition-colors">{item.label}</h3>
            <p class="mt-2 text-sm text-stone-500 leading-relaxed">{item.body}</p>
            <span class:list={['mt-4 block text-sm font-semibold group-hover:translate-x-1 transition-transform', accentText]}>{programme.exploreLink} →</span>
          </a>
        ))}
      </div>
      {programme.note && <p class="mt-8 max-w-3xl text-xs leading-relaxed text-stone-500">{programme.note}</p>}
    </section>

    <section class:list={['mt-28 rounded-3xl p-8 text-white sm:p-12', accentDark]} data-reveal>
      <div class="grid gap-7 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <h2 class="text-3xl font-bold tracking-tight">{programme.admissionsTitle}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-white/75">{programme.admissionsBody}</p>
        </div>
        <a
          href={l('/admissions', locale)}
          class:list={['rounded-full px-6 py-3 text-center text-sm font-semibold text-white transition-colors', accentButton]}
        >
          {programme.admissionsLink}
        </a>
      </div>
    </section>
  </div>
</Layout>
