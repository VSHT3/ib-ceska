---
// Shared, on-brand empty state for collections with no entries yet.
interface Props {
  message: string;
  /** Optional secondary hint line. */
  hint?: string;
}
const { message, hint } = Astro.props;
---

<div
  class="flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-stone-200 bg-white/50 px-6 py-16 text-center"
  data-reveal
>
  <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
    <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
    </svg>
  </div>
  <p class="mt-5 text-base font-medium text-stone-600">{message}</p>
  {hint && <p class="mt-1.5 max-w-sm text-sm text-stone-400">{hint}</p>}
</div>
