---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import MypOrganisation from '../MypOrganisation.astro';
import {
  mypLeadership,
  mypSupport,
  mypSubjectLeaders,
  mypHomerooms,
} from '../../data/myp-organisation';
import { schoolCopy } from './school-copy';
import type { Programme } from './school-copy';
import { teachers } from '../../data/teachers';
import { reader, pick } from '../../lib/keystatic';
import { l, contact } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import type { Teacher } from '../../data/teachers';

interface Props {
  locale: Locale;
  programme: Programme;
}

const { locale, programme } = Astro.props;
const { teachers: copy, candidateNote } = schoolCopy(locale, programme);

// Map each teacher name → the subject pages they teach (matched on the
// subject's `teacher` field). Used to make teacher cards link to their subject.
const allSubjects = programme === 'dp' ? await reader.collections.subjects.all() : [];
const subjectsByTeacher = new Map<string, { slug: string; title: string }[]>();
for (const s of allSubjects) {
  const name = s.entry.teacher?.trim();
  if (!name) continue;
  const title = pick(locale, s.entry.sk.title, s.entry.title);
  const list = subjectsByTeacher.get(name) ?? [];
  list.push({ slug: s.slug, title });
  subjectsByTeacher.set(name, list);
}
const subjectsOf = (teacher: Teacher) => subjectsByTeacher.get(teacher.name.trim()) ?? [];

// Only show teachers who have a photo (others stay in the data for subject pages).
const withPhoto = programme === 'dp' ? teachers.filter((teacher) => teacher.image) : [];
const leadership = withPhoto.filter((teacher) => teacher.leadership);
const faculty = withPhoto.filter((teacher) => !teacher.leadership);

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);

// The separate MYP chart owns MYP and ATL assignments, not the DP directory.
const responsibilitiesOf = (teacher: Teacher) =>
  teacher.responsibilities[locale].filter(
    (_, index) => !/\bMYP\b|\bATL\b/.test(teacher.responsibilities.en[index]),
  );
const roleOf = (teacher: Teacher) => [...teacher.areas[locale], ...responsibilitiesOf(teacher)];

// Core roles ("TOK Coordinator", "Theory of Knowledge", "Koordinátor CAS",
// "Extended Essay Coordinator") link to the matching IB Core page.
const coreHref = (label: string) =>
  /\bTOK\b|Theory of Knowledge|Teória poznania/i.test(label)
    ? l('/dp/tok', locale)
    : /\bCAS\b/.test(label)
      ? l('/dp/cas', locale)
      : /\bEE\b|Extended Essay|Rozšíren\S* esej/i.test(label)
        ? l('/dp/ee', locale)
        : null;

const chip =
  'rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-stone-200';
const chipLink = `${chip} transition-colors hover:bg-emerald-50 hover:text-emerald-900`;
const roleLink =
  'underline decoration-emerald-300 decoration-1 underline-offset-4 transition-colors hover:text-emerald-800 hover:decoration-emerald-600';

const dpPeopleSchemas = withPhoto.map((teacher) => ({
  '@type': 'Person',
  name: teacher.name,
  jobTitle: roleOf(teacher),
  worksFor: { '@id': new URL('/#school', Astro.site).href },
  ...(teacher.image ? { image: new URL(teacher.image.src, Astro.site).href } : {}),
}));

// Only named people and roles actually visible in the MYP chart enter its schema.
const mypPeople = new Map<string, string[]>();
const addMypRole = (name: string | null, role: string) => {
  if (!name) return;
  const roles = mypPeople.get(name) ?? [];
  roles.push(role);
  mypPeople.set(name, roles);
};
if (programme === 'myp') {
  addMypRole(mypLeadership.head.name, mypLeadership.head.title[locale]);
  for (const person of mypLeadership.coordination) {
    addMypRole(person.name, person.title[locale]);
    if ('detail' in person && person.detail) addMypRole(person.name, person.detail[locale]);
  }
  for (const role of [...mypSupport, ...mypSubjectLeaders])
    addMypRole(role.name, role.label[locale]);
  for (const room of mypHomerooms) {
    for (const name of room.teachers) {
      addMypRole(
        name,
        `${locale === 'sk' ? 'Triedny učiteľ' : 'Homeroom teacher'} · ${room.classes.join(' + ')} · MYP ${room.year}`,
      );
    }
  }
}
const peopleSchemas =
  programme === 'dp'
    ? dpPeopleSchemas
    : Array.from(mypPeople, ([name, jobTitle]) => ({
        '@type': 'Person',
        name,
        jobTitle,
        worksFor: { '@id': new URL('/#school', Astro.site).href },
      }));
---

<Layout
  title={`${copy.title} · ${programme === 'myp' ? 'MYP' : 'IB DP'}`}
  description={copy.subtitle}
  locale={locale}
  showProgrammeContext={programme !== 'myp'}
  pageSchemaType="CollectionPage"
  structuredData={peopleSchemas}
>
  {programme === 'dp' && <PageHeader title={copy.title} subtitle={copy.subtitle} tone="sky" />}

  {
    programme === 'myp' && (
      <>
        <MypOrganisation locale={locale} />
        <div class="mx-auto max-w-7xl px-6 pb-12 lg:px-12">
          <p class="max-w-3xl text-sm leading-relaxed text-stone-600">{candidateNote}</p>
        </div>
      </>
    )
  }

  {
    programme === 'dp' && (
      <>
        <section class="mx-auto max-w-7xl px-6 lg:px-12 py-12 sm:py-16">
          <div class="mx-auto max-w-5xl">
            <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl" data-reveal>
              {copy.leadershipTitle}
            </h2>

            <ul class="mt-10 grid gap-10 md:grid-cols-3 lg:gap-12">
              {leadership.map((teacher, index) => (
                <li
                  class="min-w-0 text-center"
                  data-reveal
                  style={`--reveal-delay: ${index * 70}ms`}
                >
                  <div class="group mx-auto aspect-[4/5] w-full max-w-72 overflow-hidden rounded-2xl bg-stone-100">
                    {teacher.image ? (
                      <Image
                        src={teacher.image}
                        alt={teacher.name}
                        class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 336px) 288px, calc(100vw - 48px)"
                        loading={index < 2 ? 'eager' : 'lazy'}
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-emerald-100 text-5xl font-bold text-emerald-700">
                        {initials(teacher.name)}
                      </div>
                    )}
                  </div>
                  <div class="mt-5">
                    <h3 class="text-2xl font-bold tracking-tight text-stone-900">{teacher.name}</h3>
                  </div>
                  <ul class="mt-3 space-y-1.5">
                    {roleOf(teacher).map((role) => (
                      <li class="text-base font-medium leading-relaxed text-stone-600">
                        {coreHref(role) ? (
                          <a href={coreHref(role)!} class={roleLink}>
                            {role}
                          </a>
                        ) : (
                          role
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="bg-stone-100 border-y border-stone-200/70">
          <div class="mx-auto max-w-7xl px-6 lg:px-12 py-12 sm:py-16">
            <h2
              class="max-w-2xl text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
              data-reveal
            >
              {copy.facultyTitle}
            </h2>

            <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {faculty.map((teacher, index) => {
                const subs = subjectsOf(teacher);
                const single = subs.length === 1 ? subs[0] : null;
                const singleHref = single ? l(`/dp/subjects/${single.slug}`, locale) : null;
                // Chips: subject pages when matched, otherwise the area label
                // (linked to a core page when it names TOK, CAS, or EE).
                const chips =
                  subs.length > 0
                    ? subs.map((s) => ({
                        label: s.title,
                        href: l(`/dp/subjects/${s.slug}`, locale),
                      }))
                    : teacher.areas[locale].map((area) => ({ label: area, href: coreHref(area) }));
                const imageHref = singleHref ?? chips[0]?.href ?? null;
                const Frame = imageHref ? 'a' : 'div';
                return (
                  <li
                    class="min-w-0"
                    data-reveal
                    style={`--reveal-delay: ${Math.min(index, 5) * 60}ms`}
                  >
                    <article class="group flex h-full flex-col">
                      <Frame
                        href={imageHref ?? undefined}
                        class="block aspect-[4/5] overflow-hidden rounded-2xl bg-stone-200"
                      >
                        {teacher.image ? (
                          <Image
                            src={teacher.image}
                            alt={teacher.name}
                            class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                            widths={[320, 480, 640]}
                            sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                            loading="lazy"
                          />
                        ) : (
                          <div class="flex h-full items-center justify-center bg-emerald-100 text-5xl font-bold text-emerald-700">
                            {initials(teacher.name)}
                          </div>
                        )}
                      </Frame>
                      <div class="mt-4 flex flex-1 flex-col border-t border-stone-300 pt-4">
                        <h3 class="text-xl font-bold tracking-tight text-stone-900">
                          {teacher.name}
                        </h3>
                        {chips.length > 0 && (
                          <div class="mt-3 flex flex-wrap gap-1.5">
                            {chips.map((c) =>
                              c.href ? (
                                <a href={c.href} class={chipLink}>
                                  {c.label}
                                </a>
                              ) : (
                                <span class={chip}>{c.label}</span>
                              ),
                            )}
                          </div>
                        )}
                        {responsibilitiesOf(teacher).length > 0 && (
                          <ul class="mt-3 space-y-1.5">
                            {responsibilitiesOf(teacher).map((role) => (
                              <li class="text-sm leading-relaxed text-stone-600">
                                {coreHref(role) ? (
                                  <a href={coreHref(role)!} class={roleLink}>
                                    {role}
                                  </a>
                                ) : (
                                  role
                                )}
                              </li>
                            ))}
                          </ul>
                        )}
                        {singleHref && (
                          <a
                            href={singleHref}
                            class="group/link mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-emerald-700 transition-colors hover:text-emerald-800"
                          >
                            {copy.viewSubject}
                            <span
                              class="transition-transform group-hover/link:translate-x-1"
                              aria-hidden="true"
                            >
                              →
                            </span>
                          </a>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      </>
    )
  }

  <!-- Contact (true full-bleed dark band) -->
  <section class="bg-stone-900 text-white">
    <div
      class="mx-auto max-w-7xl px-6 lg:px-12 py-12 sm:py-16 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      data-reveal
    >
      <div class="max-w-xl">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{copy.contactTitle}</h2>
        <p class="mt-4 text-base leading-relaxed text-stone-300">{copy.contactBody}</p>
      </div>
      <div class="flex min-w-0 flex-wrap gap-3">
        <a
          href={l('/admissions', locale)}
          class="rounded-full bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-600"
        >
          {copy.admissionsLink}
        </a>
        <a
          href={`mailto:${contact.email}`}
          data-umami-event="mail-click"
          class="rounded-full border border-stone-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-emerald-400 hover:text-emerald-300"
        >
          {copy.emailLink}
        </a>
      </div>
    </div>
  </section>
</Layout>
