---
type Tone = 'emerald' | 'dark' | 'myp' | 'sky' | 'stone';

interface Props {
  title: string;
  subtitle?: string;
  label?: string;
  tone?: Tone;
}

const { title, subtitle, label, tone = 'emerald' } = Astro.props;

const tones: Record<Tone, { band: string; blob: string; label: string; subtitle: string }> = {
  emerald: {
    band: 'from-emerald-800 via-emerald-700 to-teal-800',
    blob: 'bg-emerald-500/20',
    label: 'text-emerald-200',
    subtitle: 'text-emerald-100/90',
  },
  dark: {
    band: 'from-stone-900 via-stone-800 to-emerald-950',
    blob: 'bg-emerald-500/15',
    label: 'text-emerald-300',
    subtitle: 'text-stone-300',
  },
  myp: {
    band: 'from-myp-700 via-myp-600 to-orange-700',
    blob: 'bg-myp-400/20',
    label: 'text-myp-100',
    subtitle: 'text-myp-50/90',
  },
  sky: {
    band: 'from-sky-800 via-sky-700 to-cyan-800',
    blob: 'bg-sky-400/20',
    label: 'text-sky-200',
    subtitle: 'text-sky-100/90',
  },
  stone: {
    band: 'from-stone-800 via-stone-700 to-stone-900',
    blob: 'bg-stone-400/10',
    label: 'text-stone-300',
    subtitle: 'text-stone-300',
  },
};

const c = tones[tone];
---

<section class:list={['relative overflow-hidden bg-gradient-to-br text-white', c.band]}>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"
  >
  </div>
  <div class:list={['absolute -top-24 -right-24 w-96 h-96 rounded-full blur-3xl', c.blob]}></div>
  <div class="relative mx-auto max-w-7xl px-6 lg:px-12 pt-24 pb-14 sm:pt-32 sm:pb-18">
    {
      label && (
        <span
          class:list={[
            'hero-rise flex items-center gap-3 text-xs font-semibold tracking-widest uppercase',
            c.label,
          ]}
        >
          <span class="h-px w-10 bg-current opacity-60" aria-hidden="true" />
          {label}
        </span>
      )
    }
    <h1
      class="hero-rise mt-5 max-w-[18ch] text-balance text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight"
      style="--rise-delay: 80ms"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p
          class:list={['hero-rise mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed', c.subtitle]}
          style="--rise-delay: 160ms"
        >
          {subtitle}
        </p>
      )
    }
    <slot />
  </div>
</section>
