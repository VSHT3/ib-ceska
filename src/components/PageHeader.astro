---
interface Props {
  title: string;
  subtitle?: string;
  label?: string;
}

const { title, subtitle, label } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-emerald-800 via-emerald-700 to-teal-800 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent" />
  <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-emerald-500/20 blur-3xl" />
  <div class="relative mx-auto max-w-5xl px-6 py-16 sm:py-20">
    {label && <span class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-200 mb-3">{label}</span>}
    <h1 class="hero-rise text-4xl sm:text-5xl font-bold tracking-tight" style="--rise-delay: 80ms">{title}</h1>
    {subtitle && (
      <p class="hero-rise mt-4 max-w-2xl text-lg text-emerald-100/90 leading-relaxed" style="--rise-delay: 160ms">
        {subtitle}
      </p>
    )}
  </div>
</section>
