---
import type { DocItem } from '../data/documents';
import type { Locale } from '../i18n/dictionaries';

interface Props {
  items: DocItem[];
  locale: Locale;
  tone?: 'emerald' | 'amber';
}

const { items, locale, tone = 'emerald' } = Astro.props;
const accent = tone === 'amber' ? 'text-amber-700' : 'text-emerald-700';
const accentHover = tone === 'amber' ? 'hover:text-amber-800' : 'hover:text-emerald-800';
const badge = tone === 'amber' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800';
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    items.map((doc) => (
      <li>
        <a
          href={`/documents/${doc.file}`}
          class:list={[
            'group flex h-full items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-md',
          ]}
        >
          <span
            class:list={['flex h-10 w-10 shrink-0 items-center justify-center rounded-xl', badge]}
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
              />
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-2">
              <span class="font-semibold text-stone-900">{doc.title}</span>
              <span
                class:list={[
                  'rounded-full px-2 py-0.5 text-[0.65rem] font-bold tracking-wide',
                  badge,
                ]}
              >
                {doc.lang}
              </span>
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-stone-600">
              {doc.note[locale]}
            </span>
            <span
              class:list={[
                'mt-3 inline-flex items-center gap-1 text-sm font-semibold',
                accent,
                accentHover,
              ]}
            >
              PDF
              <span class="transition-transform group-hover:translate-x-0.5">↗</span>
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
