---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ProgrammeContext from '../components/ProgrammeContext.astro';
import schoolBuilding from '../assets/school/school-building.jpg';
import { t, l, contact } from '../i18n/dictionaries';
import type { Locale } from '../i18n/dictionaries';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  noindex?: boolean;
  showProgrammeContext?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string | null;
  author?: string | null;
  pageSchemaType?: string;
  pageSchema?: Record<string, unknown>;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  locale,
  noindex = false,
  showProgrammeContext = true,
  ogType = 'website',
  publishedTime,
  author,
  pageSchemaType = 'WebPage',
  pageSchema = {},
  structuredData = [],
} = Astro.props;
const dict = t(locale);
const currentYear = new Date().getFullYear();

const homeLink = { href: l('/', locale), label: dict.nav.home };
const programmeNavigation = [
  {
    id: 'myp',
    label: dict.nav.myp,
    href: l('/myp', locale),
    groups: [
      {
        label: dict.nav.myp,
        links: [
          { href: l('/myp', locale), label: dict.nav.overview },
          { href: l('/myp/subjects', locale), label: dict.nav.subjects },
        ],
      },
      {
        label: dict.nav.mypCore,
        links: [
          {
            href: l('/myp/core/interdisciplinary-learning', locale),
            label: dict.nav.interdisciplinaryLearning,
          },
          {
            href: l('/myp/core/approaches-to-learning', locale),
            label: dict.nav.approachesToLearning,
          },
          { href: l('/myp/core/service-as-action', locale), label: dict.nav.serviceAsAction },
          { href: l('/myp/core/personal-project', locale), label: dict.nav.personalProject },
        ],
      },
      {
        label: dict.nav.about,
        links: [
          { href: l('/myp/mission', locale), label: dict.nav.mission },
          { href: l('/myp/teachers', locale), label: dict.nav.teachers },
          { href: l('/myp/policies', locale), label: dict.nav.policies },
        ],
      },
    ],
  },
  {
    id: 'dp',
    label: dict.nav.dp,
    href: l('/dp', locale),
    groups: [
      {
        label: dict.nav.dp,
        links: [
          { href: l('/dp', locale), label: dict.nav.overview },
          { href: l('/dp/subjects', locale), label: dict.nav.subjects },
          { href: l('/dp/build-your-diploma', locale), label: dict.nav.builder },
        ],
      },
      {
        label: dict.nav.dpCore,
        links: [
          { href: l('/dp/cas', locale), label: dict.nav.cas },
          { href: l('/dp/tok', locale), label: dict.nav.tok },
          { href: l('/dp/ee', locale), label: dict.nav.ee },
        ],
      },
      {
        label: dict.nav.about,
        links: [
          { href: l('/dp/mission', locale), label: dict.nav.mission },
          { href: l('/dp/teachers', locale), label: dict.nav.teachers },
          { href: l('/dp/policies', locale), label: dict.nav.policies },
        ],
      },
    ],
  },
];
const secondaryLinks = [
  { href: l('/news', locale), label: dict.nav.news },
  { href: l('/gallery', locale), label: dict.nav.gallery },
];
const admissionsHref = l('/admissions', locale);
const footerSharedLinks = [
  homeLink,
  ...secondaryLinks,
  { href: admissionsHref, label: dict.nav.apply },
  { href: l('/search', locale), label: dict.nav.search },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) =>
  currentPath === href.replace(/\/$/, '') || currentPath.startsWith(href.replace(/\/$/, '') + '/');
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
const isProgrammeLinkActive = (href: string, overview: string) =>
  href === overview ? isCurrent(href) : isActive(href);
const homeActive = isCurrent(homeLink.href);

const site = Astro.site ?? new URL('https://ib.gymnaziumceska.sk');
const pathSansLocale = Astro.url.pathname.replace(/^\/(en|sk)(?=\/|$)/, '') || '/';
const withTrailingSlash = (path: string) =>
  path === '/' || path.endsWith('/') ? path : `${path}/`;
const altUrl = (code: string) =>
  new URL(withTrailingSlash(`/${code}${pathSansLocale === '/' ? '/' : pathSansLocale}`), site).href;
const canonicalUrl = new URL(withTrailingSlash(Astro.url.pathname), site).href;
const ogImage = new URL(schoolBuilding.src, site).href;
const logoUrl = new URL('/logo-mark.png', site).href;
const fullTitle = title === dict.site.title ? title : `${title} | ${dict.site.title}`;
const metaDescription = description ?? dict.site.tagline;

const routeLabels: Record<string, string> = {
  myp: dict.nav.myp,
  dp: dict.nav.dp,
  'build-your-diploma': dict.nav.builder,
  subjects: dict.nav.subjects,
  cas: dict.nav.cas,
  tok: dict.nav.tok,
  ee: dict.nav.ee,
  core: dict.nav.mypCore,
  'interdisciplinary-learning': dict.nav.interdisciplinaryLearning,
  'approaches-to-learning': dict.nav.approachesToLearning,
  'service-as-action': dict.nav.serviceAsAction,
  'personal-project': dict.nav.personalProject,
  news: dict.nav.news,
  gallery: dict.nav.gallery,
  teachers: dict.nav.teachers,
  mission: dict.nav.mission,
  policies: dict.nav.policies,
  search: dict.nav.search,
  admissions: dict.nav.apply,
};
const segments = pathSansLocale.split('/').filter(Boolean);
const breadcrumbs = [
  { name: dict.site.title, item: new URL(`/${locale}/`, site).href },
  ...segments.flatMap((segment, index) => {
    if (segment === 'core') return [];
    const path = `/${locale}/${segments.slice(0, index + 1).join('/')}/`;
    return [
      {
        name: index === segments.length - 1 ? title : (routeLabels[segment] ?? segment),
        item: new URL(path, site).href,
      },
    ];
  }),
];

const schoolId = new URL('/#school', site).href;
const websiteId = new URL('/#website', site).href;
const webpageId = `${canonicalUrl}#webpage`;
const baseSchemas: Record<string, unknown>[] = [
  {
    '@type': 'HighSchool',
    '@id': schoolId,
    name: dict.site.schoolName,
    alternateName: 'SGČ',
    url: new URL('/', site).href,
    logo: logoUrl,
    image: ogImage,
    email: contact.email,
    telephone: contact.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Česká 10',
      postalCode: '831 03',
      addressLocality: 'Bratislava',
      addressCountry: 'SK',
    },
    sameAs: ['https://www.gymnaziumceska.sk'],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: new URL('/', site).href,
    name: dict.site.title,
    inLanguage: ['en', 'sk'],
    publisher: { '@id': schoolId },
  },
  {
    '@type': pageSchemaType,
    '@id': webpageId,
    url: canonicalUrl,
    name: fullTitle,
    description: metaDescription,
    inLanguage: locale,
    isPartOf: { '@id': websiteId },
    about: { '@id': schoolId },
    image: ogImage,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImage,
    },
    ...pageSchema,
  },
];
if (breadcrumbs.length > 1) {
  baseSchemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  });
}
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseSchemas, ...extraSchemas],
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {!noindex && <link rel="alternate" hreflang="sk" href={altUrl('sk')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={dict.site.title} />
    <meta property="og:locale" content={locale === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'sk' ? 'en_GB' : 'sk_SK'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            defer
            src="https://analytics.morumori.com/script.js"
            data-website-id="3338cf3b-af17-494e-930c-33de48aaf146"
          />
          <script
            is:inline
            defer
            src="https://analytics.morumori.com/recorder.js"
            data-website-id="3338cf3b-af17-494e-930c-33de48aaf146"
          />
        </>
      )
    }
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-sans antialiased">
    <header
      class="border-b border-stone-200/60 bg-white/70 backdrop-blur-xl backdrop-saturate-150 shadow-sm shadow-stone-900/5 sticky top-0 z-50"
    >
      <nav class="flex items-center justify-between px-4 sm:px-6 py-3">
        <a href={l('/', locale)} class="flex items-center gap-3 shrink-0">
          <img
            src="/logo-mark.png"
            alt="Súkromné gymnázium Česká"
            class="h-12 w-auto"
            width="1601"
            height="1456"
          />
          <span class="flex flex-col leading-tight sm:hidden">
            <span class="text-sm font-bold tracking-tight text-stone-900">IB Česká</span>
            <span class="mt-0.5 text-[11px] font-medium text-stone-600">MYP &amp; IB DP</span>
          </span>
          <span class="hidden sm:flex flex-col leading-tight">
            <span class="text-sm font-bold tracking-tight text-stone-900">
              {dict.site.schoolName}
            </span>
            <span class="text-[11px] font-medium text-stone-500">{dict.nav.programmes}</span>
          </span>
        </a>

        <ul
          class="hidden xl:flex flex-nowrap whitespace-nowrap gap-1 text-sm font-medium items-center"
          aria-label={dict.nav.primaryNavigation}
        >
          <li>
            <a
              href={homeLink.href}
              aria-current={homeActive ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-3 py-1.5 transition-colors',
                homeActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
              ]}
            >
              {homeLink.label}
            </a>
          </li>
          {
            programmeNavigation.map((programme) => (
              <li class="relative" data-programme-menu>
                <button
                  type="button"
                  data-programme-toggle
                  aria-expanded="false"
                  aria-controls={`desktop-${programme.id}`}
                  class:list={[
                    'programme-toggle flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors hover:bg-stone-100 hover:text-emerald-700',
                    isActive(programme.href) ? 'bg-emerald-50 text-emerald-700' : 'text-stone-600',
                  ]}
                >
                  {programme.label}
                  <svg
                    class="h-3.5 w-3.5 transition-transform motion-reduce:transition-none"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div
                  id={`desktop-${programme.id}`}
                  data-programme-panel
                  hidden
                  class="absolute left-0 top-full z-50 w-[36rem] max-w-[calc(100vw-2rem)] pt-2 whitespace-normal"
                >
                  <div class="max-h-[calc(100dvh-7rem)] overflow-y-auto rounded-2xl border border-stone-200 bg-white p-5 shadow-lg shadow-stone-900/10">
                    <div class="grid grid-cols-2 gap-x-5 gap-y-4">
                      {programme.groups.map((group, index) => (
                        <div class:list={[index === 1 && 'row-span-2']}>
                          <p class="mb-2 px-3 text-lg font-bold leading-tight tracking-tight text-emerald-950">
                            {group.label}
                          </p>
                          <ul class="space-y-0.5">
                            {group.links.map(({ href, label }) => (
                              <li>
                                <a
                                  href={href}
                                  aria-current={isCurrent(href) ? 'page' : undefined}
                                  class:list={[
                                    'block rounded-lg px-3 py-2 transition-colors hover:bg-stone-100 hover:text-emerald-700',
                                    isProgrammeLinkActive(href, programme.href)
                                      ? 'bg-emerald-50 text-emerald-700'
                                      : 'text-stone-700',
                                  ]}
                                >
                                  {label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
          {
            secondaryLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class:list={[
                    'relative rounded-full px-3 py-1.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li aria-hidden="true" class="mx-1 h-5 w-px bg-stone-200"></li>
          <li class="ml-2 pl-3 border-l border-stone-200">
            <LanguageSwitcher locale={locale} />
          </li>
          <li>
            <a
              href={admissionsHref}
              aria-current={isCurrent(admissionsHref) ? 'page' : undefined}
              class="ml-1 rounded-full bg-emerald-700 px-4 py-2 font-semibold text-white transition-colors hover:bg-emerald-800"
              data-umami-event="cta-primary"
              data-umami-event-target="admissions"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>

        <div class="flex xl:hidden items-center gap-3">
          <LanguageSwitcher locale={locale} />
          <button
            id="menu-toggle"
            type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-stone-600 hover:bg-stone-100 transition-colors"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={dict.nav.menu}
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <path class="menu-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
              <path class="menu-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"
              ></path>
            </svg>
          </button>
        </div>
      </nav>

      <div
        id="mobile-menu"
        class="hidden xl:hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-stone-200 bg-white px-4 py-3"
      >
        <ul class="flex flex-col gap-1 text-sm font-medium">
          <li>
            <a
              href={homeLink.href}
              aria-current={homeActive ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2.5 transition-colors',
                homeActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
              ]}
            >
              {homeLink.label}
            </a>
          </li>
          {
            programmeNavigation.map((programme) => (
              <li class="border-y border-stone-100">
                <button
                  type="button"
                  data-mobile-programme-toggle
                  aria-expanded={isActive(programme.href) ? 'true' : 'false'}
                  aria-controls={`mobile-${programme.id}`}
                  class:list={[
                    'programme-toggle flex w-full items-center justify-between rounded-lg px-3 py-3 text-left',
                    isActive(programme.href) ? 'bg-emerald-50 text-emerald-700' : 'text-stone-700',
                  ]}
                >
                  {programme.label}
                  <svg
                    class="h-4 w-4 transition-transform motion-reduce:transition-none"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div
                  id={`mobile-${programme.id}`}
                  hidden={!isActive(programme.href)}
                  class="pb-3 pl-3"
                >
                  {programme.groups.map((group) => (
                    <div class="mt-3">
                      <p class="px-3 pb-2 text-lg font-bold leading-tight tracking-tight text-emerald-950">
                        {group.label}
                      </p>
                      <ul>
                        {group.links.map(({ href, label }) => (
                          <li>
                            <a
                              href={href}
                              aria-current={isCurrent(href) ? 'page' : undefined}
                              class:list={[
                                'block rounded-lg px-3 py-2.5 transition-colors hover:bg-stone-100 hover:text-emerald-700',
                                isProgrammeLinkActive(href, programme.href)
                                  ? 'bg-emerald-50 text-emerald-700'
                                  : 'text-stone-700',
                              ]}
                            >
                              {label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </li>
            ))
          }
          {
            secondaryLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li class="pt-2">
            <a
              href={admissionsHref}
              aria-current={isActive(admissionsHref) ? 'page' : undefined}
              class="block rounded-lg bg-emerald-700 px-3 py-2.5 text-center font-semibold text-white transition-colors hover:bg-emerald-800"
              data-umami-event="cta-primary"
              data-umami-event-target="admissions"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main>
      {showProgrammeContext && <ProgrammeContext locale={locale} />}
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-300">
      <div class="mx-auto max-w-[110rem] px-6 pt-16 pb-8 sm:pt-20 lg:px-12 xl:px-16">
        <!-- Closing line + primary action -->
        <div class="grid gap-8 border-b border-white/10 pb-12 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-9">
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">
              {dict.site.title} · Bratislava
            </p>
            <p
              class="mt-3 text-4xl font-bold tracking-tighter leading-none text-white sm:text-5xl lg:text-6xl"
            >
              {dict.site.tagline}
            </p>
          </div>
          <a
            href={admissionsHref}
            data-umami-event="cta-primary"
            data-umami-event-target="admissions"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-600 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-500 lg:col-span-3 lg:justify-self-end"
          >
            {dict.footer.visitCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Brand left, link groups right -->
        <div class="grid gap-12 py-12 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-5">
            <div class="flex items-center gap-5">
              <img
                src="/logo-mark.png"
                alt={dict.site.schoolName}
                class="h-16 w-auto"
                width="1601"
                height="1456"
              />
              <span class="h-10 w-px bg-white/15" aria-hidden="true"></span>
              <img
                src="/ib-logo.svg"
                alt="International Baccalaureate"
                class="h-12 w-auto"
                width="135"
                height="135"
              />
            </div>
            <p class="mt-6 max-w-sm text-sm leading-relaxed text-stone-400">
              {dict.footer.mission}
            </p>
            <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              <a
                href="https://www.gymnaziumceska.sk"
                target="_blank"
                rel="noopener"
                class="text-stone-300 transition-colors hover:text-emerald-400"
                >{dict.footer.school} ↗</a
              >
              <a
                href="https://www.ibo.org"
                target="_blank"
                rel="noopener"
                class="text-stone-300 transition-colors hover:text-emerald-400"
                >{dict.footer.ibo} ↗</a
              >
            </p>
          </div>

          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7 lg:col-start-6">
            {
              programmeNavigation.map((programme) => (
                <div>
                  <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-stone-500">
                    {programme.label}
                  </h3>
                  <ul class="space-y-2.5 text-sm">
                    {programme.groups
                      .flatMap((group) => group.links)
                      .map(({ href, label }) => (
                        <li>
                          <a
                            href={href}
                            class="text-stone-400 transition-colors hover:text-emerald-400"
                          >
                            {label}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              ))
            }
            <div class="col-span-2 sm:col-span-1">
              <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-stone-500">
                {dict.footer.contact}
              </h3>
              <ul class="space-y-2.5 text-sm">
                <li>
                  <a
                    href={`tel:${contact.phone.replace(/\s/g, '')}`}
                    data-umami-event="tel-click"
                    class="text-stone-400 transition-colors hover:text-emerald-400"
                    >{contact.phone}</a
                  >
                </li>
                <li>
                  <a
                    href={`mailto:${contact.email}`}
                    data-umami-event="mail-click"
                    class="text-stone-400 transition-colors hover:text-emerald-400"
                    >{contact.email}</a
                  >
                </li>
                <li class="leading-relaxed text-stone-400">{contact.address}</li>
              </ul>
              <h3 class="mt-8 mb-4 text-xs font-semibold uppercase tracking-widest text-stone-500">
                {dict.footer.schoolLifeGroup}
              </h3>
              <ul class="space-y-2.5 text-sm">
                {
                  footerSharedLinks.map(({ href, label }) => (
                    <li>
                      <a
                        href={href}
                        class="text-stone-400 transition-colors hover:text-emerald-400"
                      >
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div
          class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-white/10 pt-6 text-xs text-stone-500"
        >
          <p>
            &copy; {currentYear}{' '}
            {dict.site.title}. {dict.footer.rights}
          </p>
          <a href={l('/privacy', locale)} class="transition-colors hover:text-emerald-400">
            {dict.footer.privacy}
          </a>
        </div>
      </div>
    </footer>

    <style>
      .programme-toggle[aria-expanded='true'] > svg {
        transform: rotate(180deg);
      }
    </style>

    <script>
      let pageController: AbortController | undefined;
      let revealObserver: IntersectionObserver | undefined;

      function initPage() {
        pageController?.abort();
        revealObserver?.disconnect();
        pageController = new AbortController();
        const { signal } = pageController;
        // Scroll-reveal
        const revealEls = document.querySelectorAll('[data-reveal]:not(.revealed)');
        if (revealEls.length > 0) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
          revealObserver = io;
        }

        // Hero parallax: background lags scroll for depth
        const w = window as unknown as { __heroParallax?: () => void };
        if (w.__heroParallax) {
          window.removeEventListener('scroll', w.__heroParallax);
          w.__heroParallax = undefined;
        }
        const heroBg = document.querySelector<HTMLElement>('[data-parallax]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (heroBg && !reduceMotion) {
          const factor = Number(heroBg.dataset.parallax) || 0.3;
          let ticking = false;
          const apply = () => {
            heroBg.style.transform = `translate3d(0, ${window.scrollY * factor}px, 0)`;
            ticking = false;
          };
          const onScroll = () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(apply);
            }
          };
          w.__heroParallax = onScroll;
          window.addEventListener('scroll', onScroll, { passive: true });
          apply();
        }

        // Language switch keeps scroll position (ClientRouter scrolls to top by default)
        document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
          a.addEventListener(
            'click',
            () => {
              sessionStorage.setItem('lang-switch-scroll', String(window.scrollY));
            },
            { signal },
          );
        });
        const savedScroll = sessionStorage.getItem('lang-switch-scroll');
        if (savedScroll !== null) {
          sessionStorage.removeItem('lang-switch-scroll');
          window.scrollTo({ top: Number(savedScroll), behavior: 'instant' });
        }

        const desktopMenus = Array.from(
          document.querySelectorAll<HTMLElement>('[data-programme-menu]'),
        ).flatMap((root) => {
          const button = root.querySelector<HTMLButtonElement>('[data-programme-toggle]');
          const panel = root.querySelector<HTMLElement>('[data-programme-panel]');
          return button && panel ? [{ root, button, panel, pinned: false }] : [];
        });
        type DesktopMenu = (typeof desktopMenus)[number];
        const setDesktopOpen = (menu: DesktopMenu, open: boolean) => {
          if (open) {
            desktopMenus.forEach((other) => {
              if (other !== menu) setDesktopOpen(other, false);
            });
          } else {
            menu.pinned = false;
          }
          menu.button.setAttribute('aria-expanded', String(open));
          menu.panel.hidden = !open;
          if (open) {
            const { left } = menu.root.getBoundingClientRect();
            const width = menu.panel.getBoundingClientRect().width;
            const panelLeft = Math.max(16, Math.min(left, window.innerWidth - width - 16));
            menu.panel.style.left = `${panelLeft - left}px`;
          }
        };
        desktopMenus.forEach((menu) => {
          let pointerFocus = false;
          menu.button.addEventListener(
            'pointerdown',
            () => {
              pointerFocus = true;
            },
            { signal },
          );
          menu.button.addEventListener(
            'pointercancel',
            () => {
              pointerFocus = false;
            },
            { signal },
          );
          menu.button.addEventListener(
            'click',
            () => {
              pointerFocus = false;
              const open = !menu.pinned;
              menu.pinned = open;
              setDesktopOpen(menu, open);
            },
            { signal },
          );
          menu.root.addEventListener(
            'pointerenter',
            (event) => {
              if (event.pointerType !== 'mouse') return;
              setDesktopOpen(menu, true);
            },
            { signal },
          );
          menu.root.addEventListener(
            'pointerleave',
            (event) => {
              if (event.pointerType !== 'mouse') return;
              if (!menu.pinned && !menu.root.contains(document.activeElement))
                setDesktopOpen(menu, false);
            },
            { signal },
          );
          menu.root.addEventListener(
            'focusin',
            () => {
              if (!pointerFocus) setDesktopOpen(menu, true);
            },
            { signal },
          );
          menu.root.addEventListener(
            'focusout',
            () => {
              queueMicrotask(() => {
                if (!signal.aborted && !menu.root.contains(document.activeElement))
                  setDesktopOpen(menu, false);
              });
            },
            { signal },
          );
          menu.button.addEventListener(
            'keydown',
            (event) => {
              if (event.key === 'ArrowDown') {
                event.preventDefault();
                setDesktopOpen(menu, true);
                menu.panel.querySelector<HTMLAnchorElement>('a')?.focus();
              }
            },
            { signal },
          );
        });

        const toggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const setMobileOpen = (open: boolean) => {
          mobileMenu?.classList.toggle('hidden', !open);
          toggle?.setAttribute('aria-expanded', String(open));
          toggle?.querySelector('.menu-open')?.classList.toggle('hidden', open);
          toggle?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
        };
        toggle?.addEventListener(
          'click',
          () => {
            setMobileOpen(toggle.getAttribute('aria-expanded') !== 'true');
          },
          { signal },
        );
        document
          .querySelectorAll<HTMLButtonElement>('[data-mobile-programme-toggle]')
          .forEach((button) => {
            const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
            if (!panel) return;
            button.addEventListener(
              'click',
              () => {
                const open = button.getAttribute('aria-expanded') !== 'true';
                button.setAttribute('aria-expanded', String(open));
                panel.hidden = !open;
              },
              { signal },
            );
          });
        document.addEventListener(
          'pointerdown',
          (event) => {
            const target = event.target;
            if (!(target instanceof Node)) return;
            desktopMenus.forEach((menu) => {
              if (!menu.root.contains(target)) setDesktopOpen(menu, false);
            });
            if (!mobileMenu?.contains(target) && !toggle?.contains(target)) setMobileOpen(false);
          },
          { signal },
        );
        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key !== 'Escape') return;
            const focusedMenu = desktopMenus.find(
              (menu) => menu.root.contains(document.activeElement) && !menu.panel.hidden,
            );
            if (focusedMenu) {
              event.preventDefault();
              focusedMenu.button.focus();
            }
            desktopMenus.forEach((menu) => setDesktopOpen(menu, false));
            if (toggle?.getAttribute('aria-expanded') === 'true') {
              event.preventDefault();
              toggle.focus();
              setMobileOpen(false);
            }
          },
          { signal },
        );
        window.addEventListener(
          'resize',
          () => {
            desktopMenus.forEach((menu) => setDesktopOpen(menu, false));
            setMobileOpen(false);
          },
          { signal },
        );
      }

      document.addEventListener('astro:page-load', initPage);
      document.addEventListener('astro:before-swap', () => {
        pageController?.abort();
        revealObserver?.disconnect();
      });
    </script>
  </body>
</html>
