---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import schoolBuilding from '../assets/school/school-building.jpg';
import { t, l, contact } from '../i18n/dictionaries';
import type { Locale } from '../i18n/dictionaries';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string | null;
  author?: string | null;
  pageSchemaType?: string;
  pageSchema?: Record<string, unknown>;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  locale,
  noindex = false,
  ogType = 'website',
  publishedTime,
  author,
  pageSchemaType = 'WebPage',
  pageSchema = {},
  structuredData = [],
} = Astro.props;
const dict = t(locale);
const currentYear = new Date().getFullYear();

const homeLink = { href: l('/', locale), label: dict.nav.home };
const programmeLinks = [
  { href: l('/myp', locale), label: dict.nav.myp, desc: dict.nav.mypDesc },
  { href: l('/dp', locale), label: dict.nav.dp, desc: dict.nav.dpDesc },
  { href: l('/build-your-diploma', locale), label: dict.nav.builder, desc: dict.nav.builderDesc },
];
const subjectsLink = { href: l('/subjects', locale), label: dict.nav.subjects };
const coreLinks = [
  { href: l('/cas', locale), label: dict.nav.cas, desc: dict.nav.casDesc },
  { href: l('/tok', locale), label: dict.nav.tok, desc: dict.nav.tokDesc },
  { href: l('/ee', locale), label: dict.nav.ee, desc: dict.nav.eeDesc },
];
const newsLink = { href: l('/news', locale), label: dict.nav.news };
const galleryLink = { href: l('/gallery', locale), label: dict.nav.gallery };
const testimonialsLink = {
  href: l('/testimonials', locale),
  label: dict.nav.testimonials,
  desc: dict.nav.testimonialsDesc,
};
const teachersLink = {
  href: l('/teachers', locale),
  label: dict.nav.teachers,
  desc: dict.nav.teachersDesc,
};
const missionLink = {
  href: l('/mission', locale),
  label: dict.nav.mission,
  desc: dict.nav.missionDesc,
};
const policiesLink = {
  href: l('/policies', locale),
  label: dict.nav.policies,
  desc: dict.nav.policiesDesc,
};
const aboutLinks = [missionLink, teachersLink, testimonialsLink, policiesLink];
const secondaryLinks = [newsLink, galleryLink];
const admissionsHref = l('/admissions', locale);

// Footer link groups (label + href only)
const strip = ({ href, label }: { href: string; label: string }) => ({ href, label });
const footerProgramme = [...programmeLinks, subjectsLink, ...coreLinks].map(strip);
const footerSchoolLife = [...secondaryLinks, ...aboutLinks].map(strip);

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) =>
  currentPath === href.replace(/\/$/, '') || currentPath.startsWith(href.replace(/\/$/, '') + '/');
const homeActive = currentPath === homeLink.href.replace(/\/$/, '');
const programmesActive = programmeLinks.some(({ href }) => isActive(href));
const coreActive = coreLinks.some(({ href }) => isActive(href));
const aboutActive = aboutLinks.some(({ href }) => isActive(href));

const site = Astro.site ?? new URL('https://ib.gymnaziumceska.sk');
const pathSansLocale = Astro.url.pathname.replace(/^\/(en|sk)(?=\/|$)/, '') || '/';
const withTrailingSlash = (path: string) =>
  path === '/' || path.endsWith('/') ? path : `${path}/`;
const altUrl = (code: string) =>
  new URL(withTrailingSlash(`/${code}${pathSansLocale === '/' ? '/' : pathSansLocale}`), site).href;
const canonicalUrl = new URL(withTrailingSlash(Astro.url.pathname), site).href;
const ogImage = new URL(schoolBuilding.src, site).href;
const logoUrl = new URL('/logo.svg', site).href;
const fullTitle = title === dict.site.title ? title : `${title} | ${dict.site.title}`;
const metaDescription = description ?? dict.site.tagline;

const routeLabels: Record<string, string> = {
  myp: dict.nav.myp,
  dp: dict.nav.dp,
  'build-your-diploma': dict.nav.builder,
  subjects: dict.nav.subjects,
  cas: dict.nav.cas,
  tok: dict.nav.tok,
  ee: dict.nav.ee,
  news: dict.nav.news,
  gallery: dict.nav.gallery,
  testimonials: dict.nav.testimonials,
  teachers: dict.nav.teachers,
  mission: dict.nav.mission,
  policies: dict.nav.policies,
  search: dict.nav.search,
  admissions: dict.nav.apply,
};
const segments = pathSansLocale.split('/').filter(Boolean);
const breadcrumbs = [
  { name: dict.site.title, item: new URL(`/${locale}/`, site).href },
  ...segments.map((segment, index) => {
    const path = `/${locale}/${segments.slice(0, index + 1).join('/')}/`;
    return {
      name: index === segments.length - 1 ? title : (routeLabels[segment] ?? segment),
      item: new URL(path, site).href,
    };
  }),
];

const schoolId = new URL('/#school', site).href;
const websiteId = new URL('/#website', site).href;
const webpageId = `${canonicalUrl}#webpage`;
const baseSchemas: Record<string, unknown>[] = [
  {
    '@type': 'HighSchool',
    '@id': schoolId,
    name: 'Súkromné Gymnázium Česká',
    alternateName: dict.site.title,
    url: new URL('/', site).href,
    logo: logoUrl,
    image: ogImage,
    email: contact.email,
    telephone: contact.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Česká 10',
      postalCode: '831 03',
      addressLocality: 'Bratislava',
      addressCountry: 'SK',
    },
    sameAs: ['https://www.gymnaziumceska.sk'],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: new URL('/', site).href,
    name: dict.site.title,
    inLanguage: ['en', 'sk'],
    publisher: { '@id': schoolId },
  },
  {
    '@type': pageSchemaType,
    '@id': webpageId,
    url: canonicalUrl,
    name: fullTitle,
    description: metaDescription,
    inLanguage: locale,
    isPartOf: { '@id': websiteId },
    about: { '@id': schoolId },
    image: ogImage,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImage,
    },
    ...pageSchema,
  },
];
if (breadcrumbs.length > 1) {
  baseSchemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  });
}
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseSchemas, ...extraSchemas],
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {!noindex && <link rel="alternate" hreflang="sk" href={altUrl('sk')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={dict.site.title} />
    <meta property="og:locale" content={locale === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'sk' ? 'en_GB' : 'sk_SK'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://analytics.morumori.com/script.js"
          data-website-id="3338cf3b-af17-494e-930c-33de48aaf146"
        />
      )
    }
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-sans antialiased">
    <header
      class="border-b border-stone-200/60 bg-white/70 backdrop-blur-xl backdrop-saturate-150 shadow-sm shadow-stone-900/5 sticky top-0 z-50"
    >
      <nav class="flex items-center justify-between px-4 sm:px-6 py-3">
        <a href={l('/', locale)} class="flex items-center gap-3 shrink-0">
          <img
            src="/logo-mark.svg"
            alt="Súkromné Gymnázium Česká IB Diploma Programme"
            class="h-12 w-auto"
            width="1330"
            height="1260"
          />
          <span class="hidden sm:flex flex-col leading-tight">
            <span class="text-sm font-bold tracking-tight text-stone-900">{dict.site.title}</span>
            <span class="text-[11px] font-medium text-stone-500">Diploma Programme</span>
          </span>
        </a>

        <ul
          class="hidden xl:flex gap-1 xl:gap-2 text-sm font-medium items-center"
          role="navigation"
          aria-label="Primary"
        >
          <li>
            <a
              href={homeLink.href}
              aria-current={homeActive ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-3 py-1.5 transition-colors',
                homeActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
              ]}
            >
              {homeLink.label}
            </a>
          </li>
          <li class="relative group">
            <button
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              class:list={[
                'flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors',
                programmesActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 group-hover:text-emerald-700 group-hover:bg-stone-100',
              ]}
            >
              {dict.nav.programmes}
              <svg
                class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div
              class="invisible opacity-0 translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute left-0 top-full pt-2"
            >
              <div
                class="w-72 rounded-2xl border border-stone-200 bg-white p-1.5 shadow-lg shadow-stone-900/10"
              >
                {
                  programmeLinks.map(({ href, label, desc }) => (
                    <a
                      href={href}
                      aria-current={isActive(href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-xl px-3.5 py-2.5 transition-colors',
                        isActive(href) ? 'bg-emerald-50' : 'hover:bg-stone-100',
                      ]}
                    >
                      <span
                        class:list={[
                          'block font-semibold',
                          isActive(href) ? 'text-emerald-700' : 'text-stone-800',
                        ]}
                      >
                        {label}
                      </span>
                      <span class="block text-xs text-stone-500 mt-0.5">{desc}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </li>
          <li aria-hidden="true" class="mx-1 h-5 w-px bg-stone-200"></li>
          <li>
            <a
              href={subjectsLink.href}
              aria-current={isActive(subjectsLink.href) ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-3 py-1.5 transition-colors',
                isActive(subjectsLink.href)
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
              ]}
            >
              {subjectsLink.label}
            </a>
          </li>
          <li class="relative group">
            <button
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              class:list={[
                'flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors',
                coreActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 group-hover:text-emerald-700 group-hover:bg-stone-100',
              ]}
            >
              {dict.nav.core}
              <svg
                class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div
              class="invisible opacity-0 translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute left-0 top-full pt-2"
            >
              <div
                class="w-72 rounded-2xl border border-stone-200 bg-white p-1.5 shadow-lg shadow-stone-900/10"
              >
                {
                  coreLinks.map(({ href, label, desc }) => (
                    <a
                      href={href}
                      aria-current={isActive(href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-xl px-3.5 py-2.5 transition-colors',
                        isActive(href) ? 'bg-emerald-50' : 'hover:bg-stone-100',
                      ]}
                    >
                      <span
                        class:list={[
                          'block font-semibold',
                          isActive(href) ? 'text-emerald-700' : 'text-stone-800',
                        ]}
                      >
                        {label}
                      </span>
                      <span class="block text-xs text-stone-500 mt-0.5">{desc}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </li>
          <li aria-hidden="true" class="mx-1 h-5 w-px bg-stone-200"></li>
          {
            secondaryLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'relative rounded-full px-3 py-1.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li class="relative group">
            <button
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              class:list={[
                'flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors',
                aboutActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 group-hover:text-emerald-700 group-hover:bg-stone-100',
              ]}
            >
              {dict.nav.about}
              <svg
                class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div
              class="invisible opacity-0 translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute right-0 top-full pt-2"
            >
              <div
                class="w-72 rounded-2xl border border-stone-200 bg-white p-1.5 shadow-lg shadow-stone-900/10"
              >
                {
                  aboutLinks.map(({ href, label, desc }) => (
                    <a
                      href={href}
                      aria-current={isActive(href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-xl px-3.5 py-2.5 transition-colors',
                        isActive(href) ? 'bg-emerald-50' : 'hover:bg-stone-100',
                      ]}
                    >
                      <span
                        class:list={[
                          'block font-semibold',
                          isActive(href) ? 'text-emerald-700' : 'text-stone-800',
                        ]}
                      >
                        {label}
                      </span>
                      <span class="block text-xs text-stone-500 mt-0.5">{desc}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </li>
          <li class="ml-2 pl-3 border-l border-stone-200">
            <LanguageSwitcher locale={locale} />
          </li>
          <li>
            <a
              href={admissionsHref}
              aria-current={isActive(admissionsHref) ? 'page' : undefined}
              class="ml-1 rounded-full bg-emerald-700 px-4 py-2 font-semibold text-white transition-colors hover:bg-emerald-800"
              data-umami-event="cta-primary"
              data-umami-event-target="admissions"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>

        <div class="flex xl:hidden items-center gap-3">
          <LanguageSwitcher locale={locale} />
          <button
            id="menu-toggle"
            type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-stone-600 hover:bg-stone-100 transition-colors"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={dict.nav.menu}
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <path class="menu-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
              <path class="menu-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"
              ></path>
            </svg>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="hidden xl:hidden border-t border-stone-200 bg-white px-4 py-3">
        <ul class="flex flex-col gap-1 text-sm font-medium">
          <li>
            <a
              href={homeLink.href}
              aria-current={homeActive ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2.5 transition-colors',
                homeActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
              ]}
            >
              {homeLink.label}
            </a>
          </li>
          <li aria-hidden="true" class="my-1.5 h-px bg-stone-200/80"></li>
          <li
            class="px-3 pt-1 pb-0.5 text-xs font-semibold uppercase tracking-widest text-stone-400"
          >
            {dict.nav.programmes}
          </li>
          {
            programmeLinks.map(({ href, label, desc }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                  ]}
                >
                  {label}
                  <span class="block text-xs font-normal text-stone-500">{desc}</span>
                </a>
              </li>
            ))
          }
          <li aria-hidden="true" class="my-1.5 h-px bg-stone-200/80"></li>
          <li
            class="px-3 pt-1 pb-0.5 text-xs font-semibold uppercase tracking-widest text-stone-400"
          >
            {dict.nav.core}
          </li>
          {
            coreLinks.map(({ href, label, desc }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                  ]}
                >
                  {label}
                  <span class="block text-xs font-normal text-stone-500">{desc}</span>
                </a>
              </li>
            ))
          }
          <li aria-hidden="true" class="my-1.5 h-px bg-stone-200/80"></li>
          {
            [subjectsLink, ...secondaryLinks].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li aria-hidden="true" class="my-1.5 h-px bg-stone-200/80"></li>
          <li
            class="px-3 pt-1 pb-0.5 text-xs font-semibold uppercase tracking-widest text-stone-400"
          >
            {dict.nav.about}
          </li>
          {
            aboutLinks.map(({ href, label, desc }) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 transition-colors',
                    isActive(href)
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                  ]}
                >
                  {label}
                  <span class="block text-xs font-normal text-stone-500">{desc}</span>
                </a>
              </li>
            ))
          }
          <li class="pt-2">
            <a
              href={admissionsHref}
              aria-current={isActive(admissionsHref) ? 'page' : undefined}
              class="block rounded-lg bg-emerald-700 px-3 py-2.5 text-center font-semibold text-white transition-colors hover:bg-emerald-800"
              data-umami-event="cta-primary"
              data-umami-event-target="admissions"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-300">
      <div class="mx-auto max-w-7xl px-6 pt-16 pb-8 sm:pt-20 lg:px-12">
        <!-- Closing line + primary actions -->
        <div
