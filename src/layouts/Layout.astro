---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import schoolBuilding from '../assets/school/school-building.jpg';
import { t, l, contact } from '../i18n/dictionaries';
import type { Locale } from '../i18n/dictionaries';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string | null;
  author?: string | null;
  pageSchemaType?: string;
  pageSchema?: Record<string, unknown>;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  locale,
  noindex = false,
  ogType = 'website',
  publishedTime,
  author,
  pageSchemaType = 'WebPage',
  pageSchema = {},
  structuredData = [],
} = Astro.props;
const dict = t(locale);
const currentYear = new Date().getFullYear();

const programmeLinks = [
  { href: l('/myp', locale), label: dict.nav.myp, desc: dict.nav.mypDesc },
  { href: l('/dp', locale), label: dict.nav.dp, desc: dict.nav.dpDesc },
  { href: l('/build-your-diploma', locale), label: dict.nav.builder, desc: dict.nav.builderDesc },
];
const academicLinks = [
  { href: l('/subjects', locale), label: dict.nav.subjects },
  { href: l('/cas', locale), label: dict.nav.cas },
  { href: l('/tok', locale), label: dict.nav.tok },
  { href: l('/ee', locale), label: dict.nav.ee },
];
const newsLink = { href: l('/news', locale), label: dict.nav.news };
const eventsLink = { href: l('/events', locale), label: dict.nav.events };
const galleryLink = { href: l('/gallery', locale), label: dict.nav.gallery };
const testimonialsLink = { href: l('/testimonials', locale), label: dict.nav.testimonials };
const secondaryLinks = [newsLink, eventsLink, galleryLink, testimonialsLink];
const navLinks = [...programmeLinks, ...academicLinks, ...secondaryLinks]; // flat list for footer + mobile
const admissionsHref = l('/admissions', locale);

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => currentPath === href.replace(/\/$/, '') || currentPath.startsWith(href.replace(/\/$/, '') + '/');
const programmesActive = programmeLinks.some(({ href }) => isActive(href));

const site = Astro.site ?? new URL('https://ib.gymnaziumceska.sk');
const pathSansLocale = Astro.url.pathname.replace(/^\/(en|sk)(?=\/|$)/, '') || '/';
const withTrailingSlash = (path: string) => (path === '/' || path.endsWith('/') ? path : `${path}/`);
const altUrl = (code: string) => new URL(withTrailingSlash(`/${code}${pathSansLocale === '/' ? '/' : pathSansLocale}`), site).href;
const canonicalUrl = new URL(withTrailingSlash(Astro.url.pathname), site).href;
const ogImage = new URL(schoolBuilding.src, site).href;
const logoUrl = new URL('/logo.png', site).href;
const fullTitle = title === dict.site.title ? title : `${title} | ${dict.site.title}`;
const metaDescription = description ?? dict.site.tagline;

const routeLabels: Record<string, string> = {
  myp: dict.nav.myp,
  dp: dict.nav.dp,
  'build-your-diploma': dict.nav.builder,
  subjects: dict.nav.subjects,
  cas: dict.nav.cas,
  tok: dict.nav.tok,
  ee: dict.nav.ee,
  news: dict.nav.news,
  events: dict.nav.events,
  gallery: dict.nav.gallery,
  testimonials: dict.nav.testimonials,
  admissions: dict.nav.apply,
};
const segments = pathSansLocale.split('/').filter(Boolean);
const breadcrumbs = [
  { name: dict.site.title, item: new URL(`/${locale}/`, site).href },
  ...segments.map((segment, index) => {
    const path = `/${locale}/${segments.slice(0, index + 1).join('/')}/`;
    return {
      name: index === segments.length - 1 ? title : (routeLabels[segment] ?? segment),
      item: new URL(path, site).href,
    };
  }),
];

const schoolId = new URL('/#school', site).href;
const websiteId = new URL('/#website', site).href;
const webpageId = `${canonicalUrl}#webpage`;
const baseSchemas: Record<string, unknown>[] = [
  {
    '@type': 'HighSchool',
    '@id': schoolId,
    name: 'Súkromné Gymnázium Česká',
    alternateName: dict.site.title,
    url: new URL('/', site).href,
    logo: logoUrl,
    image: ogImage,
    email: contact.email,
    telephone: contact.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Česká 10',
      postalCode: '831 03',
      addressLocality: 'Bratislava',
      addressCountry: 'SK',
    },
    sameAs: ['https://www.gymnaziumceska.sk'],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: new URL('/', site).href,
    name: dict.site.title,
    inLanguage: ['en', 'sk'],
    publisher: { '@id': schoolId },
  },
  {
    '@type': pageSchemaType,
    '@id': webpageId,
    url: canonicalUrl,
    name: fullTitle,
    description: metaDescription,
    inLanguage: locale,
    isPartOf: { '@id': websiteId },
    about: { '@id': schoolId },
    image: ogImage,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImage,
    },
    ...pageSchema,
  },
];
if (breadcrumbs.length > 1) {
  baseSchemas.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  });
}
const extraSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseSchemas, ...extraSchemas],
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {!noindex && <link rel="alternate" hreflang="sk" href={altUrl('sk')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <link rel="alternate" type="application/rss+xml" title={`${dict.site.title}: News`} href="/rss.xml" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={dict.site.title} />
    <meta property="og:locale" content={locale === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'sk' ? 'en_GB' : 'sk_SK'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Súkromné Gymnázium Česká in Bratislava" />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <ClientRouter />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-sans antialiased">
    <header class="border-b border-stone-200/60 bg-white/70 backdrop-blur-xl backdrop-saturate-150 shadow-sm shadow-stone-900/5 sticky top-0 z-50">
      <nav class="flex items-center justify-between px-4 sm:px-6 py-3">
        <a href={l('/', locale)} class="flex items-center shrink-0">
          <img
            src="/logo-nav.png"
            alt="Súkromné Gymnázium Česká IB Diploma Programme"
            class="h-11 w-auto"
          />
        </a>

        <ul class="hidden lg:flex gap-1 xl:gap-2 text-sm font-medium items-center" role="navigation" aria-label="Primary">
          <li class="relative group">
            <button
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              class:list={[
                'flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors',
                programmesActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-stone-600 group-hover:text-emerald-700 group-hover:bg-stone-100',
              ]}
            >
              {dict.nav.programmes}
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="invisible opacity-0 translate-y-1 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute left-0 top-full pt-2">
              <div class="w-72 rounded-2xl border border-stone-200/70 bg-white/90 backdrop-blur-xl p-1.5 shadow-lg shadow-stone-900/10">
                {programmeLinks.map(({ href, label, desc }) => (
                  <a
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-xl px-3.5 py-2.5 transition-colors',
                      isActive(href) ? 'bg-emerald-50' : 'hover:bg-stone-100',
                    ]}
                  >
                    <span class:list={['block font-semibold', isActive(href) ? 'text-emerald-700' : 'text-stone-800']}>{label}</span>
                    <span class="block text-xs text-stone-500 mt-0.5">{desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </li>
          <li aria-hidden="true" class="mx-1 h-5 w-px bg-stone-200"></li>
          {academicLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'relative rounded-full px-3 py-1.5 transition-colors',
                  isActive(href)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
          <li aria-hidden="true" class="mx-1 h-5 w-px bg-stone-200"></li>
          {secondaryLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'relative rounded-full px-3 py-1.5 transition-colors',
                  isActive(href)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'text-stone-600 hover:text-emerald-700 hover:bg-stone-100',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
          <li class="ml-2 pl-3 border-l border-stone-200">
            <LanguageSwitcher locale={locale} />
          </li>
          <li>
            <a
              href={admissionsHref}
              aria-current={isActive(admissionsHref) ? 'page' : undefined}
              class="ml-1 rounded-full bg-emerald-700 px-4 py-2 font-semibold text-white transition-colors hover:bg-emerald-800"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>

        <div class="flex lg:hidden items-center gap-3">
          <LanguageSwitcher locale={locale} />
          <button
            id="menu-toggle"
            type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-stone-600 hover:bg-stone-100 transition-colors"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={dict.nav.menu}
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path class="menu-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
              <path class="menu-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200/60 bg-white/90 backdrop-blur-xl px-4 py-3">
        <ul class="flex flex-col gap-1 text-sm font-medium">
          <li class="px-3 pt-1 pb-0.5 text-xs font-semibold uppercase tracking-widest text-stone-400">{dict.nav.programmes}</li>
          {programmeLinks.map(({ href, label, desc }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-2.5 transition-colors',
                  isActive(href)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                ]}
              >
                {label}
                <span class="block text-xs font-normal text-stone-500">{desc}</span>
              </a>
            </li>
          ))}
          <li aria-hidden="true" class="my-1.5 h-px bg-stone-200/80"></li>
          {[...academicLinks, ...secondaryLinks].map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-2.5 transition-colors',
                  isActive(href)
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'text-stone-700 hover:bg-stone-100 hover:text-emerald-700',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a
              href={admissionsHref}
              aria-current={isActive(admissionsHref) ? 'page' : undefined}
              class="block rounded-lg bg-emerald-700 px-3 py-2.5 text-center font-semibold text-white transition-colors hover:bg-emerald-800"
            >
              {dict.nav.apply}
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-300 mt-24">
      <div class="mx-auto max-w-5xl px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <img src="/logo.png" alt={dict.site.title} class="h-14 w-auto mb-4 rounded-lg bg-white/90 p-1.5" />
          <p class="text-sm leading-relaxed text-stone-400">{dict.site.tagline}</p>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-widest text-stone-500 mb-4">{dict.footer.explore}</h3>
          <ul class="space-y-2 text-sm">
            {navLinks.map(({ href, label }) => (
              <li><a href={href} class="hover:text-emerald-400 transition-colors">{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-widest text-stone-500 mb-4">{dict.footer.contact}</h3>
          <ul class="space-y-2 text-sm">
            <li><a href={`mailto:${contact.email}`} class="hover:text-emerald-400 transition-colors">{contact.email}</a></li>
            <li><a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="hover:text-emerald-400 transition-colors">{contact.phone}</a></li>
            <li class="text-stone-400">{contact.address}</li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-widest text-stone-500 mb-4">{dict.footer.links}</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="https://www.gymnaziumceska.sk" target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors">
                {dict.footer.school} ↗
              </a>
            </li>
            <li>
              <a href="https://www.ibo.org" target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors">
                {dict.footer.ibo} ↗
              </a>
            </li>
            <li><a href={admissionsHref} class="hover:text-emerald-400 transition-colors">{dict.footer.admissions}</a></li>
            <li>
              <a href="/rss.xml" class="hover:text-emerald-400 transition-colors">RSS</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-stone-800 py-6">
        <div class="mx-auto max-w-5xl px-6 space-y-3 text-xs text-stone-500">
          <p class="leading-relaxed">{dict.footer.candidateNote}</p>
          <p>
            &copy; {currentYear} {dict.site.title}. {dict.footer.rights}
            {' · '}
            <a href="https://www.gymnaziumceska.sk" target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors">gymnaziumceska.sk</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      function initPage() {
        // Scroll-reveal
        const revealEls = document.querySelectorAll('[data-reveal]:not(.revealed)');
        if (revealEls.length > 0) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        }

        // Language switch keeps scroll position (ClientRouter scrolls to top by default)
        document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
          a.addEventListener('click', () => {
            sessionStorage.setItem('lang-switch-scroll', String(window.scrollY));
          });
        });
        const savedScroll = sessionStorage.getItem('lang-switch-scroll');
        if (savedScroll !== null) {
          sessionStorage.removeItem('lang-switch-scroll');
          window.scrollTo({ top: Number(savedScroll), behavior: 'instant' });
        }

        // Mobile menu
        const toggle = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (toggle && menu) {
          toggle.addEventListener('click', () => {
            const open = menu.classList.toggle('hidden') === false;
            toggle.setAttribute('aria-expanded', String(open));
            toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
            toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
          });
        }
      }

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
