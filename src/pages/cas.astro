---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const activities = await getCollection("cas");
const strands = ["Creativity", "Activity", "Service"] as const;
---

<Layout
    title="CAS"
    description="Creativity, Activity, Service — IB Diploma Programme"
>
    <h1 class="text-3xl font-bold mb-2">CAS</h1>
    <p class="text-stone-600 mb-8">
        Creativity, Activity, Service — a mandatory part of the IB Diploma
        focused on personal development outside academic subjects.
    </p>

    {
        strands.map((strand) => {
            const strandActivities = activities
                .filter((a) => a.data.strand === strand)
                .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

            return (
                <section class="mb-10">
                    <h2 class="text-xl font-semibold mb-3 text-emerald-800">
                        {strand}
                    </h2>
                    {strandActivities.length === 0 ? (
                        <p class="text-sm text-stone-400">No activities yet.</p>
                    ) : (
                        <div class="grid gap-3">
                            {strandActivities.map((a) => (
                                <div class="rounded-lg border border-stone-200 bg-white p-4">
                                    <h3 class="font-semibold">
                                        {a.data.title}
                                    </h3>
                                    <time class="text-xs text-stone-400">
                                        {a.data.date.toLocaleDateString(
                                            "en-GB",
                                        )}
                                    </time>
                                    <p class="text-sm text-stone-600 mt-1">
                                        {a.data.description}
                                    </p>
                                </div>
                            ))}
                        </div>
                    )}
                </section>
            );
        })
    }
</Layout>
