---
import { reader } from '../lib/keystatic';
import Layout from '../layouts/Layout.astro';

const allActivities = await reader.collections.cas.all();
const strands = ['Creativity', 'Activity', 'Service'] as const;
---

<Layout title="CAS" description="Creativity, Activity, Service">
  <h1 class="text-3xl font-bold mb-2">CAS</h1>
  <p class="text-stone-600 mb-8">
    Creativity, Activity, Service — a core component of the IB Diploma Programme
    focused on personal development beyond academics.
  </p>

  {strands.map((strand) => {
    const strandActivities = allActivities
      .filter((a) => a.entry.strand === strand)
      .sort((a, b) => new Date(b.entry.date).getTime() - new Date(a.entry.date).getTime());

    return (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3 text-emerald-800">{strand}</h2>
        {strandActivities.length === 0 ? (
          <p class="text-sm text-stone-400">No activities yet.</p>
        ) : (
          <div class="grid gap-3">
            {strandActivities.map((a) => (
              <div class="rounded-lg border border-stone-200 bg-white p-4">
                <h3 class="font-semibold">{a.entry.title}</h3>
                <time class="text-xs text-stone-400">
                  {new Date(a.entry.date).toLocaleDateString('en-GB')}
                </time>
                <p class="text-sm text-stone-600 mt-1">{a.entry.description}</p>
              </div>
            ))}
          </div>
        )}
      </section>
    );
  })}
</Layout>
