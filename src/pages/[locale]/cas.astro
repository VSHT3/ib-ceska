---
import { Image } from 'astro:assets';
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import DocumentList from '../../components/DocumentList.astro';
import { school } from '../../assets/school';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { guideDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allActivities = await reader.collections.cas.all();
const sorted = [...allActivities].sort(
  (a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime(),
);

const strands = [
  {
    key: 'Creativity',
    letter: 'C',
    label: dict.cas.strandCreativity,
    desc: dict.cas.creativityDesc,
    block:
      'border-myp-200 bg-myp-50 hover:border-myp-400 data-[active]:ring-2 data-[active]:ring-myp-500 data-[active]:border-myp-400',
    letterColor: 'text-myp-500',
    chip: 'bg-myp-100 text-myp-800',
  },
  {
    key: 'Activity',
    letter: 'A',
    label: dict.cas.strandActivity,
    desc: dict.cas.activityDesc,
    block:
      'border-sky-200 bg-sky-50 hover:border-sky-400 data-[active]:ring-2 data-[active]:ring-sky-500 data-[active]:border-sky-400',
    letterColor: 'text-sky-500',
    chip: 'bg-sky-100 text-sky-800',
  },
  {
    key: 'Service',
    letter: 'S',
    label: dict.cas.strandService,
    desc: dict.cas.serviceDesc,
    block:
      'border-emerald-200 bg-emerald-50 hover:border-emerald-400 data-[active]:ring-2 data-[active]:ring-emerald-500 data-[active]:border-emerald-400',
    letterColor: 'text-emerald-600',
    chip: 'bg-emerald-100 text-emerald-800',
  },
] as const;

// strands is a multiselect array; keep the canonical C→A→S order for display.
const strandsOf = (entry: { strands: readonly string[] }) =>
  strands.filter((s) => entry.strands.includes(s.key));
const countOf = (key: string) =>
  sorted.filter((a) => (a.entry.strands as readonly string[]).includes(key)).length;

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
---

<Layout
  title={dict.cas.title}
  description={dict.cas.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Photo hero -->
  <section class="relative overflow-hidden bg-stone-900 text-white">
    <Image
      src={school.volunteering}
      alt=""
      class="ken-burns absolute inset-0 h-full w-full object-cover opacity-40"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-900/50 to-stone-900/30"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-12 pt-24 pb-14 sm:pt-32 sm:pb-16">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-300"
        >IB Core</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.cas.title}
      </h1>
      <p
        class="hero-rise mt-4 max-w-2xl text-lg text-stone-200 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.cas.subtitle}
      </p>
    </div>
  </section>

  <!-- Strand blocks = interactive filters, overlapping the hero -->
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <section
      class="-mt-10 relative z-10 grid sm:grid-cols-3 gap-4"
      aria-label={dict.cas.filterHint}
    >
      {
        strands.map((strand, i) => (
          <button
            type="button"
            data-strand-filter={strand.key}
            aria-pressed="false"
            class:list={[
              'group rounded-3xl border p-6 text-left shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md cursor-pointer',
              strand.block,
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="flex items-start justify-between">
              <span
                class:list={[
                  'text-5xl font-extrabold leading-none tracking-tight select-none',
                  strand.letterColor,
                ]}
                aria-hidden="true"
              >
                {strand.letter}
              </span>
              <span class:list={['text-xs font-bold rounded-full px-2.5 py-1', strand.chip]}>
                {countOf(strand.key)}
              </span>
            </div>
            <h2 class="mt-4 text-lg font-bold text-stone-900">{strand.label}</h2>
            <p class="mt-1.5 text-sm text-stone-600 leading-relaxed">{strand.desc}</p>
          </button>
        ))
      }
    </section>
  </div>

  <!-- Journal: sticky heading rail + hairline entry rows -->
  <section class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.52fr_1.48fr] lg:gap-16 items-start">
      <div class="lg:sticky lg:top-24 self-start" data-reveal>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900">
          {dict.cas.journalHeading}
        </h2>
        <p class="mt-4 max-w-[40ch] text-sm text-stone-500 leading-relaxed">
          {dict.cas.filterHint}
        </p>
        <button
          type="button"
          data-strand-filter="all"
          data-active
          aria-pressed="true"
          class="mt-6 rounded-full border border-stone-200 bg-white px-4 py-1.5 text-xs font-semibold text-stone-600 transition-colors hover:border-emerald-300 hover:text-emerald-700 data-[active]:border-emerald-600 data-[active]:bg-emerald-700 data-[active]:text-white cursor-pointer"
        >
          {dict.cas.filterAll}
        </button>
      </div>

      <div class="min-w-0">
        {
          sorted.length === 0 ? (
            <EmptyState message={dict.cas.noActivities} />
          ) : (
            <ol class="border-t border-stone-200">
              {sorted.map((a, i) => {
                const itemStrands = strandsOf(a.entry);
                const marks = itemStrands.length > 0 ? itemStrands : [strands[0]];
                return (
                  <li
                    data-journal-item
                    data-strands={itemStrands.map((s) => s.key).join(' ')}
                    data-reveal
                    style={`--reveal-delay: ${Math.min(i, 4) * 70}ms`}
                  >
                    <a
                      href={`/${locale}/cas/${a.slug}`}
                      class="group grid grid-cols-[3rem_1fr] sm:grid-cols-[4.5rem_1fr] gap-4 sm:gap-6 items-start border-b border-stone-200 py-7 sm:py-9 sm:-mx-4 sm:px-4 transition-colors hover:bg-white"
                    >
                      <span
                        class="flex flex-col text-3xl sm:text-4xl font-extrabold leading-[0.95] tracking-tighter select-none"
                        aria-hidden="true"
                      >
                        {marks.map((s) => (
                          <span class={s.letterColor}>{s.letter}</span>
                        ))}
                      </span>
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                          {a.entry.date && (
                            <time class="text-xs font-medium text-stone-400">
                              {fmtDate(a.entry.date)}
                            </time>
                          )}
                          {itemStrands.map((s) => (
                            <span
                              class:list={[
                                'text-[11px] font-bold rounded-full px-2 py-0.5',
                                s.chip,
                              ]}
                            >
                              {s.label}
                            </span>
                          ))}
                        </div>
                        <h3 class="mt-2 text-lg sm:text-xl font-semibold text-stone-900 group-hover:text-emerald-700 transition-colors">
                          {pick(locale, a.entry.sk.title, a.entry.title)}
                        </h3>
                        <p class="mt-1.5 max-w-2xl text-sm text-stone-600 leading-relaxed">
                          {pick(locale, a.entry.sk.description, a.entry.description)}
                        </p>
                        <span
                          class="mt-3 inline-block text-sm font-semibold text-emerald-700 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
          )
        }
      </div>
    </div>
  </section>

  <!-- CAS Handbook: full-bleed dark band (school document supplied by the CAS coordinator) -->
  <section class="bg-stone-900 text-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28" data-reveal>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <span
            class="flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-300"
          >
            <span class="h-px w-10 bg-current" aria-hidden="true"></span>
            {dict.cas.handbookLabel}
          </span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight">
            {dict.cas.handbookTitle}
          </h2>
          <p class="mt-5 max-w-xl text-sm text-stone-300 leading-relaxed">
            {dict.cas.handbookIntro}
          </p>
          <a
            href={l('/policies', locale)}
            class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 hover:text-emerald-200 transition-colors"
          >
            {dict.cas.handbookMore}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <DocumentList
            items={guideDocuments.filter((doc) => doc.file === 'cas-handbook.pdf')}
            locale={locale}
            tone="dp"
          />
        </div>
      </div>
    </div>
  </section>

  <script>
    function initCasFilter() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-strand-filter]');
      const items = document.querySelectorAll<HTMLElement>('[data-journal-item]');
      if (buttons.length === 0) return;

      let current = 'all';
      const apply = (filter: string) => {
        current = filter;
        items.forEach((item) => {
          const itemStrands = (item.dataset.strands ?? '').split(' ');
          item.classList.toggle('hidden', filter !== 'all' && !itemStrands.includes(filter));
        });
        buttons.forEach((btn) => {
          const active = btn.dataset.strandFilter === filter;
          btn.toggleAttribute('data-active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.strandFilter ?? 'all';
          // Clicking the active strand again returns to the full journal
          apply(target === current ? 'all' : target);
        });
      });
    }

    document.addEventListener('astro:page-load', initCasFilter);
  </script>
</Layout>
