---
import { Image } from 'astro:assets';
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { school } from '../../assets/school';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allActivities = await reader.collections.cas.all();
const sorted = [...allActivities].sort(
  (a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime(),
);

const strands = [
  {
    key: 'Creativity',
    letter: 'C',
    label: dict.cas.strandCreativity,
    desc: dict.cas.creativityDesc,
    block:
      'border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/40 hover:border-amber-400 data-[active]:ring-2 data-[active]:ring-amber-500 data-[active]:border-amber-400',
    letterColor: 'text-amber-500',
    chip: 'bg-amber-100 text-amber-800',
    dot: 'bg-amber-500',
  },
  {
    key: 'Activity',
    letter: 'A',
    label: dict.cas.strandActivity,
    desc: dict.cas.activityDesc,
    block:
      'border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-900/40 hover:border-sky-400 data-[active]:ring-2 data-[active]:ring-sky-500 data-[active]:border-sky-400',
    letterColor: 'text-sky-500',
    chip: 'bg-sky-100 text-sky-800',
    dot: 'bg-sky-500',
  },
  {
    key: 'Service',
    letter: 'S',
    label: dict.cas.strandService,
    desc: dict.cas.serviceDesc,
    block:
      'border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/40 hover:border-emerald-400 data-[active]:ring-2 data-[active]:ring-emerald-500 data-[active]:border-emerald-400',
    letterColor: 'text-emerald-600 dark:text-emerald-400',
    chip: 'bg-emerald-100 text-emerald-800',
    dot: 'bg-emerald-600',
  },
] as const;

// strands is a multiselect array; keep the canonical C→A→S order for display.
const strandsOf = (entry: { strands: readonly string[] }) =>
  strands.filter((s) => entry.strands.includes(s.key));
const countOf = (key: string) =>
  sorted.filter((a) => (a.entry.strands as readonly string[]).includes(key)).length;

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
---

<Layout
  title={dict.cas.title}
  description={dict.cas.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Photo hero -->
  <section class="relative overflow-hidden bg-stone-900 text-white">
    <Image
      src={school.volunteering}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-900/50 to-stone-900/30"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-24 pb-14 sm:pt-32 sm:pb-16">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-300"
        >IB Core</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.cas.title}
      </h1>
      <p
        class="hero-rise mt-4 max-w-2xl text-lg text-stone-200 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.cas.subtitle}
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Strand blocks = interactive filters -->
    <section
      class="-mt-10 relative z-10 grid sm:grid-cols-3 gap-4"
      aria-label={dict.cas.filterHint}
    >
      {
        strands.map((strand, i) => (
          <button
            type="button"
            data-strand-filter={strand.key}
            aria-pressed="false"
            class:list={[
              'group rounded-3xl border p-6 text-left shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md cursor-pointer',
              strand.block,
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="flex items-start justify-between">
              <span
                class:list={[
                  'text-5xl font-extrabold leading-none tracking-tight select-none',
                  strand.letterColor,
                ]}
                aria-hidden="true"
              >
                {strand.letter}
              </span>
              <span class:list={['text-xs font-bold rounded-full px-2.5 py-1', strand.chip]}>
                {countOf(strand.key)}
              </span>
            </div>
            <h2 class="mt-4 text-lg font-bold text-stone-900 dark:text-stone-100">
              {strand.label}
            </h2>
            <p class="mt-1.5 text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
              {strand.desc}
            </p>
          </button>
        ))
      }
    </section>

    <!-- Journal -->
    <section class="py-14 max-w-3xl">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
        <h2 class="text-2xl font-bold tracking-tight">{dict.cas.journalHeading}</h2>
        <button
          type="button"
          data-strand-filter="all"
          data-active
          aria-pressed="true"
          class="rounded-full border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-4 py-1.5 text-xs font-semibold text-stone-600 dark:text-stone-400 transition-colors hover:border-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-300 data-[active]:border-emerald-600 data-[active]:bg-emerald-700 data-[active]:text-white cursor-pointer"
        >
          {dict.cas.filterAll}
        </button>
      </div>

      {
        sorted.length === 0 ? (
          <EmptyState message={dict.cas.noActivities} />
        ) : (
          <ol class="relative border-l-2 border-stone-200 dark:border-stone-800 ml-2.5 space-y-8">
            {sorted.map((a, i) => {
              const itemStrands = strandsOf(a.entry);
              const primary = itemStrands[0] ?? strands[0];
              return (
                <li
                  class="relative pl-8"
                  data-journal-item
                  data-strands={itemStrands.map((s) => s.key).join(' ')}
                  data-reveal
                  style={`--reveal-delay: ${Math.min(i, 4) * 70}ms`}
                >
                  <span
                    class:list={[
                      'absolute -left-[7px] top-2 h-3 w-3 rounded-full ring-4 ring-stone-50 dark:ring-stone-950',
                      primary.dot,
                    ]}
                    aria-hidden="true"
                  />
                  <a
                    href={`/${locale}/cas/${a.slug}`}
                    class="group block rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5 sm:p-6 transition-all hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5"
                  >
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                      {a.entry.date && (
                        <time class="text-xs font-medium text-stone-400 dark:text-stone-500">
                          {fmtDate(a.entry.date)}
                        </time>
                      )}
                      {itemStrands.map((s) => (
                        <span
                          class:list={['text-[11px] font-bold rounded-full px-2 py-0.5', s.chip]}
                        >
                          {s.label}
                        </span>
                      ))}
                    </div>
                    <h3 class="mt-2 text-lg font-semibold text-stone-900 dark:text-stone-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors">
                      {pick(locale, a.entry.sk.title, a.entry.title)}
                    </h3>
                    <p class="mt-1.5 text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                      {pick(locale, a.entry.sk.description, a.entry.description)}
                    </p>
                    <span
                      class="mt-3 inline-block text-sm font-semibold text-emerald-700 dark:text-emerald-300 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        )
      }
    </section>
  </div>

  <script>
    function initCasFilter() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-strand-filter]');
      const items = document.querySelectorAll<HTMLElement>('[data-journal-item]');
      if (buttons.length === 0) return;

      let current = 'all';
      const apply = (filter: string) => {
        current = filter;
        items.forEach((item) => {
          const itemStrands = (item.dataset.strands ?? '').split(' ');
          item.classList.toggle('hidden', filter !== 'all' && !itemStrands.includes(filter));
        });
        buttons.forEach((btn) => {
          const active = btn.dataset.strandFilter === filter;
          btn.toggleAttribute('data-active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.strandFilter ?? 'all';
          // Clicking the active strand again returns to the full journal
          apply(target === current ? 'all' : target);
        });
      });
    }

    document.addEventListener('astro:page-load', initCasFilter);
  </script>
</Layout>
