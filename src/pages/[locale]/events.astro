---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const loc = locale === 'sk' ? 'sk-SK' : 'en-GB';

const all = await reader.collections.events.all();

// An event counts as "upcoming" through the end of its (end)date.
const now = new Date();
now.setHours(0, 0, 0, 0);
const endOf = (e: (typeof all)[number]) => new Date(e.entry.endDate ?? e.entry.date ?? 0);

const upcoming = all
  .filter((e) => endOf(e) >= now)
  .sort((a, b) => new Date(a.entry.date ?? 0).getTime() - new Date(b.entry.date ?? 0).getTime());
const past = all
  .filter((e) => endOf(e) < now)
  .sort((a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime());

const parts = (date: string | null) => {
  if (!date) return null;
  const d = new Date(date);
  return {
    day: d.toLocaleDateString(loc, { day: '2-digit' }),
    month: d.toLocaleDateString(loc, { month: 'short' }).replace('.', ''),
    year: d.getFullYear(),
    weekday: d.toLocaleDateString(loc, { weekday: 'long' }),
  };
};
const rangeNote = (e: (typeof all)[number]) => {
  if (!e.entry.endDate || e.entry.endDate === e.entry.date) return null;
  return new Date(e.entry.endDate).toLocaleDateString(loc, { day: 'numeric', month: 'long' });
};
---

<Layout title={dict.events.title} description="Key dates and events in the IB calendar at Česká" locale={locale}>
  <!-- Editorial hero -->
  <section class="relative overflow-hidden border-b border-stone-200/80 bg-white">
    <span class="absolute -right-6 -bottom-16 text-[11rem] sm:text-[17rem] font-extrabold leading-none tracking-tighter text-stone-100 select-none" aria-hidden="true">＊</span>
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 py-14 sm:py-20">
      <span class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.events.label}</span>
      <h1 class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight" style="--rise-delay: 80ms">{dict.events.title}</h1>
      <p class="hero-rise mt-5 max-w-2xl text-lg text-stone-600 leading-relaxed" style="--rise-delay: 160ms">{dict.events.subtitle}</p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-14">
    {all.length === 0 ? (
      <p class="text-sm text-stone-400">{dict.events.noEvents}</p>
    ) : (
      <>
        {upcoming.length > 0 && (
          <section data-reveal>
            <h2 class="flex items-center gap-2.5 text-xs font-semibold uppercase tracking-widest text-emerald-700 mb-6">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse" aria-hidden="true" />
              {dict.events.upcoming}
            </h2>
            <ul class="space-y-4">
              {upcoming.map((e, i) => {
                const p = parts(e.entry.date);
                const end = rangeNote(e);
                return (
                  <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 70}ms`}>
                    <article class="group grid grid-cols-[auto_1fr] gap-5 sm:gap-7 rounded-3xl border border-stone-200 bg-white p-5 sm:p-7 transition-all hover:border-emerald-300 hover:shadow-md">
                      <div class="flex flex-col items-center justify-center rounded-2xl bg-emerald-700 px-4 py-3 text-white min-w-[4.5rem] self-start">
                        <span class="text-2xl sm:text-3xl font-extrabold leading-none">{p?.day}</span>
                        <span class="mt-1 text-xs font-semibold uppercase tracking-wide text-emerald-100">{p?.month}</span>
                      </div>
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-400">
                          <span>{p?.weekday}{end && ` → ${end}`}</span>
                          <span class="font-medium text-stone-500">· {e.entry.time || dict.events.allDay}</span>
                        </div>
                        <h3 class="mt-1.5 text-xl sm:text-2xl font-bold tracking-tight text-stone-900 group-hover:text-emerald-700 transition-colors">
                          {pick(locale, e.entry.sk.title, e.entry.title)}
                        </h3>
                        {e.entry.description && (
                          <p class="mt-2 text-sm sm:text-base text-stone-600 leading-relaxed max-w-2xl">
                            {pick(locale, e.entry.sk.description, e.entry.description)}
                          </p>
                        )}
                        {e.entry.location && (
                          <p class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-stone-500">
                            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                            {e.entry.location}
                          </p>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {past.length > 0 && (
          <section class={upcoming.length > 0 ? 'mt-16' : ''} data-reveal>
            <h2 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-6">{dict.events.past}</h2>
            <ol class="relative border-l-2 border-stone-200 ml-2 space-y-6">
              {past.map((e) => {
                const p = parts(e.entry.date);
                return (
                  <li class="relative pl-7" data-reveal>
                    <span class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-stone-300 ring-4 ring-stone-50" aria-hidden="true" />
                    <p class="text-xs text-stone-400">{p?.day} {p?.month} {p?.year}</p>
                    <h3 class="mt-0.5 text-base font-semibold text-stone-700">{pick(locale, e.entry.sk.title, e.entry.title)}</h3>
                    {e.entry.location && <p class="mt-0.5 text-xs text-stone-400">{e.entry.location}</p>}
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </>
    )}
  </div>
</Layout>
