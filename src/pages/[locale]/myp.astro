---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { school } from '../../assets/school';
import DocumentList from '../../components/DocumentList.astro';
import { mypDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const p = t(locale).myp;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<Layout
  title={p.title}
  description={p.subtitle}
  locale={locale}
  pageSchemaType="Course"
  pageSchema={{
    name: p.title,
    courseCode: p.shortTitle,
    provider: { '@id': new URL('/#school', Astro.site).href },
  }}
>
  <!-- Hero: edge-to-edge split, entrance + scroll parallax on the photo -->
  <section class="grid items-stretch lg:grid-cols-2">
    <div class="flex items-center bg-amber-800 px-6 py-20 text-white sm:px-10 lg:px-16 lg:py-28">
      <div class="max-w-xl">
        <img
          src="/ib-myp-logo.png"
          alt="IB MYP logo"
          class="hero-rise mb-7 h-16 w-auto rounded-xl bg-white p-2 shadow-md sm:h-20"
          width="640"
          height="256"
          style="--rise-delay: 0ms"
        />
        <p
          class="hero-rise text-xs font-semibold uppercase tracking-widest text-white/70"
          style="--rise-delay: 120ms"
        >
          {p.label}
        </p>
        <h1
          class="hero-rise mt-3 text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
          style="--rise-delay: 200ms"
        >
          {p.title}
        </h1>
        <p class="hero-rise mt-5 text-lg leading-relaxed text-white/80" style="--rise-delay: 320ms">
          {p.subtitle}
        </p>
        <div
          class="hero-rise mt-8 flex flex-wrap gap-3 text-sm font-semibold"
          style="--rise-delay: 420ms"
        >
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2">{p.age}</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2">{p.duration}</span
          >
        </div>
      </div>
    </div>
    <div class="relative min-h-[20rem] overflow-hidden lg:min-h-[34rem]">
      <div
        class="hero-parallax absolute inset-x-0 -top-[25%] h-[150%] will-change-transform"
        data-parallax
      >
        <Image
          src={school.studentsReading}
          alt="Students reading together at Česká"
          class="absolute inset-0 h-full w-full object-cover"
          widths={[768, 1024, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- What is MYP: plain-language explainer + concrete points -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">
          {p.whatIsLabel}
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl lg:text-6xl">
          {p.whatIsTitle}
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:pt-6" data-reveal style="--reveal-delay: 100ms">
        <p class="text-lg leading-relaxed text-stone-600">{p.whatIsBody}</p>
        <a
          href={p.officialUrl}
          target="_blank"
          rel="noopener"
          class="mt-7 inline-flex text-sm font-semibold text-amber-700 hover:underline"
        >
          {p.officialLink} ↗
        </a>
      </div>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
      {
        p.whatIsPoints.map((point, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="text-xs font-semibold text-amber-700">{pad(i)}</span>
            <h3 class="mt-2 text-lg font-bold tracking-tight">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{point.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Approaches to learning: full-bleed amber band, accordion -->
  <section class="bg-amber-50 border-y-2 border-amber-900/15">
    <div class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5" data-reveal>
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">
            {p.atlLabel}
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            {p.atlTitle}
          </h2>
          <p class="mt-5 leading-relaxed text-stone-600">{p.atlIntro}</p>
        </div>

        <div
          class="lg:col-span-6 lg:col-start-7"
          data-atl
          data-reveal
          style="--reveal-delay: 100ms"
        >
          {
            p.atl.map((a, i) => (
              <div class="border-b border-amber-200">
                <button
                  type="button"
                  data-atl-trigger={i}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`atl-panel-${i}`}
                  class="flex w-full items-center justify-between gap-4 py-5 text-left font-semibold text-stone-900 transition-colors hover:text-amber-700"
                >
                  <span class="flex items-baseline gap-4">
                    <span class="text-xs font-semibold text-amber-700">{pad(i)}</span>
                    <span class="text-lg">{a.title}</span>
                  </span>
                  <svg
                    class="h-5 w-5 shrink-0 text-amber-700 transition-transform duration-300 data-[open]:rotate-45"
                    data-atl-icon
                    data-open={i === 0 ? '' : undefined}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                  </svg>
                </button>
                <div
                  id={`atl-panel-${i}`}
                  data-atl-panel={i}
                  class:list={[
                    'grid transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]',
                    i === 0 ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]',
                  ]}
                >
                  <div class="overflow-hidden">
                    <p class="pb-5 pr-8 leading-relaxed text-stone-600">{a.desc}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond lessons: Personal Project + Service as full-bleed two-panel -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
    <div data-reveal class="lg:max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">
        {p.featureLabel}
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        {p.featureTitle}
      </h2>
      <p class="mt-4 leading-relaxed text-stone-600">{p.featureBody}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <div
        class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-8 transition-all hover:-translate-y-1 hover:shadow-lg sm:p-10"
        data-reveal
      >
        <span class="text-5xl font-extrabold leading-none text-amber-200 select-none">01</span>
        <h3 class="mt-4 text-2xl font-bold tracking-tight">{p.personalProjectTitle}</h3>
        <p class="mt-3 leading-relaxed text-stone-600">{p.personalProjectBody}</p>
      </div>
      <div
        class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-8 transition-all hover:-translate-y-1 hover:shadow-lg sm:p-10"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        <span class="text-5xl font-extrabold leading-none text-amber-200 select-none">02</span>
        <h3 class="mt-4 text-2xl font-bold tracking-tight">{p.serviceTitle}</h3>
        <p class="mt-3 leading-relaxed text-stone-600">{p.serviceBody}</p>
      </div>
    </div>

    <!-- Links row -->
    <div class="mt-12 grid gap-4 sm:grid-cols-3" data-reveal>
      {
        p.links.map((item) => (
          <a
            href={item.href.startsWith('/') ? l(item.href, locale) : item.href}
            class="group border-t border-stone-300 py-6"
          >
            <h3 class="font-semibold text-stone-900 transition-colors group-hover:text-amber-700">
              {item.label}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-500">{item.body}</p>
            <span class="mt-4 block text-sm font-semibold text-amber-700 transition-transform group-hover:translate-x-1">
              {p.exploreLink} →
            </span>
          </a>
        ))
      }
    </div>

    {p.note && <p class="mt-10 max-w-3xl text-xs leading-relaxed text-stone-500">{p.note}</p>}
  </section>

  <!-- After MYP: transition to DP -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28" data-reveal>
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">
          {p.afterMypLabel}
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
          {p.afterMypTitle}
        </h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-3">
        <p class="text-lg leading-relaxed text-stone-600">{p.afterMypBody}</p>
        <a
          href={l('/dp', locale)}
          class="mt-7 inline-flex text-sm font-semibold text-amber-700 hover:underline"
        >
          {t(locale).dp.title} →
        </a>
      </div>
    </div>
  </section>

  <!-- MYP documents: short info + official IB parent pack -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">
        {p.documentsLabel}
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{p.documentsTitle}</h2>
      <p class="mt-5 leading-relaxed text-stone-600">{p.documentsIntro}</p>
    </div>
    <div class="mt-10" data-reveal style="--reveal-delay: 100ms">
      <DocumentList items={mypDocuments} locale={locale} tone="amber" />
    </div>
  </section>

  <!-- Admissions band: full-bleed -->
  <section class="bg-amber-800 text-white" data-reveal>
    <div class="px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
      <div class="grid gap-7 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{p.admissionsTitle}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-white/75">{p.admissionsBody}</p>
        </div>
        <a
          href={l('/admissions', locale)}
          class="rounded-full bg-amber-600 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-amber-700"
        >
          {p.admissionsLink}
        </a>
      </div>
    </div>
  </section>

  <script>
    function initMyp() {
      // ---- ATL accordion ----
      const atlTriggers = document.querySelectorAll<HTMLButtonElement>('[data-atl-trigger]');
      atlTriggers.forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = btn.dataset.atlTrigger;
          const panel = document.querySelector<HTMLElement>(`[data-atl-panel="${i}"]`);
          if (!panel) return;
          const open = panel.classList.contains('grid-rows-[1fr]');
          panel.classList.toggle('grid-rows-[1fr]', !open);
          panel.classList.toggle('grid-rows-[0fr]', open);
          btn.setAttribute('aria-expanded', String(!open));
          const icon = btn.querySelector<SVGElement>('[data-atl-icon]');
          if (icon) icon.toggleAttribute('data-open', !open);
        });
      });
    }

    document.addEventListener('astro:page-load', initMyp);
  </script>
</Layout>
