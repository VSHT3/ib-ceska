---
import ProgrammeOverview from '../../components/ProgrammeOverview.astro';
import { school } from '../../assets/school';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
---

<ProgrammeOverview
  locale={locale}
  programme={t(locale).myp}
  tone="amber"
  image={school.studentsReading}
  imageAlt="Students reading together at Česká"
/>
