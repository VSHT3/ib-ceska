---
import Layout from '../../layouts/Layout.astro';
import { t, l, contact } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const galleryPhotos = [
  { src: '/images/school/classroom.jpg', alt: 'Students in class' },
  { src: '/images/school/students-reading.jpg', alt: 'Students reading in the library' },
  { src: '/images/school/project-presentation.jpg', alt: 'Students presenting a project' },
  { src: '/images/school/hallway-library.jpg', alt: 'School hallway and library' },
  { src: '/images/school/volunteering.png', alt: 'Students volunteering' },
  { src: '/images/school/students-fun.jpg', alt: 'Students having fun' },
  { src: '/images/school/entrance-banner.jpg', alt: 'School entrance' },
  { src: '/images/school/students-selfie.jpg', alt: 'Students with their teacher' },
];

const workItems = [
  { href: l('/cas', locale), title: dict.home.workCasTitle, desc: dict.home.workCasDesc, number: '01' },
  { href: l('/tok', locale), title: dict.home.workTokTitle, desc: dict.home.workTokDesc, number: '02' },
  { href: l('/ee', locale), title: dict.home.workEeTitle, desc: dict.home.workEeDesc, number: '03' },
];

const exploreCards = [
  { href: l('/subjects', locale), label: dict.home.subjectsLabel, desc: dict.home.subjectsDesc, color: 'emerald', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { href: l('/cas', locale), label: dict.home.casLabel, desc: dict.home.casDesc, color: 'emerald', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  { href: l('/tok', locale), label: dict.home.tokLabel, desc: dict.home.tokDesc, color: 'amber', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
  { href: l('/ee', locale), label: dict.home.eeLabel, desc: dict.home.eeDesc, color: 'emerald', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
  { href: l('/news', locale), label: dict.home.newsLabel, desc: dict.home.newsDesc, color: 'emerald', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
];
---

<Layout
  title={dict.site.title}
  description="IB Diploma Programme at Súkromné Gymnázium Česká"
  locale={locale}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-stone-900 text-white">
    <img
      src="/images/school/school-building.jpg"
      alt=""
      class="ken-burns absolute inset-0 h-full w-full object-cover opacity-50"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-950/90 via-emerald-900/70 to-stone-900/60" />
    <div class="relative mx-auto max-w-5xl px-6 py-28 sm:py-36 lg:py-44 text-center">
      <span class="hero-rise inline-flex items-center gap-2 rounded-full border border-emerald-400/40 bg-emerald-400/10 px-4 py-1.5 text-xs sm:text-sm font-semibold text-emerald-200 backdrop-blur-sm mb-6">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400" />
        </span>
        {dict.home.badge}
      </span>
      <h1 class="hero-rise text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6" style="--rise-delay: 100ms">
        {dict.home.hero}
      </h1>
      <p class="hero-rise text-lg sm:text-xl text-emerald-100/90 max-w-2xl mx-auto leading-relaxed mb-10" style="--rise-delay: 200ms">
        {dict.home.heroSub}
      </p>
      <div class="hero-rise flex flex-wrap justify-center gap-4" style="--rise-delay: 300ms">
        <a
          href={l('/subjects', locale)}
          class="rounded-full bg-emerald-500 px-7 py-3 text-sm sm:text-base font-semibold text-white shadow-lg shadow-emerald-900/40 transition-all hover:bg-emerald-400 hover:scale-105 active:scale-100"
        >
          {dict.home.ctaPrimary}
        </a>
        <a
          href={l('/admissions', locale)}
          class="rounded-full border border-white/30 bg-white/10 px-7 py-3 text-sm sm:text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-105 active:scale-100"
        >
          {dict.home.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4">
    <!-- What is IB -->
    <section class="my-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative" data-reveal>
          <div class="absolute -top-4 -left-4 w-full h-full rounded-3xl bg-emerald-100" />
          <img
            src="/images/school/students-reading.jpg"
            alt="Students reading together in the school library"
            class="relative rounded-3xl object-cover h-72 sm:h-80 lg:h-96 w-full shadow-lg"
            loading="lazy"
          />
        </div>
        <div data-reveal style="--reveal-delay: 120ms">
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.home.whatIsIBLabel}</span>
          <h2 class="text-3xl font-bold mt-2 mb-4 tracking-tight">{dict.home.whatIsIB}</h2>
          <p class="text-stone-600 leading-relaxed">{dict.home.whatIsIBBody1}</p>
          <p class="text-stone-600 leading-relaxed mt-3">{dict.home.whatIsIBBody2}</p>
        </div>
      </div>
    </section>

    <!-- MYP vs DP -->
    <section class="my-24">
      <div class="text-center mb-10" data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.home.programmesLabel}</span>
        <h2 class="text-3xl font-bold mt-2 tracking-tight">{dict.home.programmesHeading}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="rounded-3xl border border-stone-200 bg-white p-8 sm:p-10 hover:border-amber-300 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group" data-reveal>
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <span class="text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1">{dict.home.mypAges}</span>
          </div>
          <h3 class="text-xl font-semibold mb-3">{dict.home.mypTitle}</h3>
          <p class="text-stone-600 leading-relaxed mb-4">{dict.home.mypDesc}</p>
          <ul class="text-sm text-stone-500 space-y-2">
            <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5 shrink-0">&bull;</span> {dict.home.mypItem1}</li>
            <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5 shrink-0">&bull;</span> {dict.home.mypItem2}</li>
            <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5 shrink-0">&bull;</span> {dict.home.mypItem3}</li>
            <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5 shrink-0">&bull;</span> {dict.home.mypItem4}</li>
          </ul>
          <p class="mt-5 pt-4 border-t border-stone-100 text-xs text-stone-400 leading-relaxed">{dict.home.mypNote}</p>
        </div>

        <div class="rounded-3xl border border-stone-200 bg-white p-8 sm:p-10 hover:border-emerald-300 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group" data-reveal style="--reveal-delay: 120ms">
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <span class="text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1">{dict.home.dpAges}</span>
          </div>
          <h3 class="text-xl font-semibold mb-3">{dict.home.dpTitle}</h3>
          <p class="text-stone-600 leading-relaxed mb-4">{dict.home.dpDesc}</p>
          <ul class="text-sm text-stone-500 space-y-2">
            <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span> {dict.home.dpItem1}</li>
            <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span> {dict.home.dpItem2}</li>
            <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span> {dict.home.dpItem3}</li>
            <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span> {dict.home.dpItem4}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Student work -->
    <section class="my-24">
      <div class="grid lg:grid-cols-[1.15fr_1fr] gap-10 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28" data-reveal>
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.home.benefitsLabel}</span>
          <h2 class="text-3xl sm:text-4xl font-bold mt-2 tracking-tight max-w-lg">{dict.home.benefitsHeading}</h2>
          <p class="mt-4 text-stone-600 leading-relaxed max-w-lg">{dict.home.benefitsIntro}</p>
          <p class="mt-3 text-stone-500 leading-relaxed max-w-lg">{dict.home.workBody}</p>
          <img
            src="/images/school/project-presentation.jpg"
            alt="Students presenting project work at Česká"
            class="mt-8 h-72 sm:h-80 w-full rounded-3xl object-cover shadow-lg"
            loading="lazy"
          />
        </div>
        <div class="border-t border-stone-300">
          {workItems.map((item, i) => (
            <a
              href={item.href}
              class="group grid grid-cols-[2.5rem_1fr_auto] gap-3 sm:gap-5 border-b border-stone-300 py-7 sm:py-9"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="text-xs font-semibold text-emerald-700 pt-1">{item.number}</span>
              <span>
                <span class="block text-lg sm:text-xl font-semibold group-hover:text-emerald-700 transition-colors">{item.title}</span>
                <span class="block mt-2 text-sm text-stone-500 leading-relaxed">{item.desc}</span>
              </span>
              <span class="text-sm font-semibold text-emerald-700 pt-1 group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Photo marquee (full bleed) -->
  <section class="my-24 overflow-hidden">
    <div class="text-center mb-10 px-4" data-reveal>
      <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.home.galleryLabel}</span>
      <h2 class="text-3xl font-bold mt-2 tracking-tight">{dict.home.galleryHeading}</h2>
    </div>
    <div class="marquee relative" data-reveal>
      <div class="marquee-track flex w-max gap-4">
        {[...galleryPhotos, ...galleryPhotos].map((photo) => (
          <img
            src={photo.src}
            alt={photo.alt}
            class="h-52 sm:h-64 w-auto rounded-2xl object-cover shadow-sm hover:scale-[1.03] transition-transform duration-300"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4">
    <!-- Explore Sections -->
    <section class="my-24">
      <div class="text-center mb-10" data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">{dict.home.exploreLabel}</span>
        <h2 class="text-3xl font-bold mt-2 tracking-tight">{dict.home.exploreHeading}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {exploreCards.map((card, i) => (
          <a
            href={card.href}
            class="group rounded-2xl border border-stone-200 bg-white p-6 hover:border-emerald-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class:list={[
              'w-10 h-10 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform',
              card.color === 'amber' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700',
            ]}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={card.icon}/></svg>
            </div>
            <h3 class="font-semibold text-lg mb-1 group-hover:text-emerald-700 transition-colors">{card.label}</h3>
            <p class="text-sm text-stone-500">{card.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="my-24" data-reveal>
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-800 via-emerald-700 to-teal-800 text-white px-8 py-16 sm:px-16 text-center">
        <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-emerald-400/20 blur-3xl" />
        <div class="absolute -bottom-24 -left-16 w-72 h-72 rounded-full bg-teal-400/15 blur-3xl" />
        <div class="relative">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">{dict.home.ctaHeading}</h2>
          <p class="text-emerald-100/90 text-lg mb-8 max-w-xl mx-auto">{dict.home.ctaBody}</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={l('/admissions', locale)}
              class="rounded-full bg-white px-7 py-3 font-semibold text-emerald-800 shadow-lg transition-all hover:bg-emerald-50 hover:scale-105 active:scale-100"
            >
              {dict.home.ctaButton}
            </a>
            <a
              href={`tel:${contact.phone.replace(/\s/g, '')}`}
              class="rounded-full border border-white/30 bg-white/10 px-7 py-3 font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-105 active:scale-100"
            >
              {dict.home.ctaCall} · {contact.phone}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
