---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { school } from '../../assets/school';
import { reader, pick } from '../../lib/keystatic';
import { t, l, contact } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const galleryPhotos = [
  { src: school.classroom, alt: 'Students in class' },
  { src: school.studentsReading, alt: 'Students reading in the library' },
  { src: school.projectPresentation, alt: 'Students presenting a project' },
  { src: school.hallwayLibrary, alt: 'School hallway and library' },
  { src: school.volunteering, alt: 'Students volunteering' },
  { src: school.studentsFun, alt: 'Students having fun' },
  { src: school.entranceBanner, alt: 'School entrance' },
  { src: school.studentsSelfie, alt: 'Students with their teacher' },
];

const workItems = [
  {
    href: l('/cas', locale),
    title: dict.home.workCasTitle,
    desc: dict.home.workCasDesc,
    number: '01',
  },
  {
    href: l('/tok', locale),
    title: dict.home.workTokTitle,
    desc: dict.home.workTokDesc,
    number: '02',
  },
  {
    href: l('/ee', locale),
    title: dict.home.workEeTitle,
    desc: dict.home.workEeDesc,
    number: '03',
  },
];

const allTestimonials = await reader.collections.testimonials.all();
const featuredTestimonials = allTestimonials
  .filter((s) => s.entry.featured)
  .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0))
  .slice(0, 3);

const exploreCards = [
  {
    href: l('/subjects', locale),
    label: dict.home.subjectsLabel,
    desc: dict.home.subjectsDesc,
    color: 'emerald',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    href: l('/cas', locale),
    label: dict.home.casLabel,
    desc: dict.home.casDesc,
    color: 'emerald',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  },
  {
    href: l('/tok', locale),
    label: dict.home.tokLabel,
    desc: dict.home.tokDesc,
    color: 'amber',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    href: l('/ee', locale),
    label: dict.home.eeLabel,
    desc: dict.home.eeDesc,
    color: 'emerald',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  },
  {
    href: l('/news', locale),
    label: dict.home.newsLabel,
    desc: dict.home.newsDesc,
    color: 'emerald',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  },
  {
    href: l('/teachers', locale),
    label: dict.home.teachersLabel,
    desc: dict.home.teachersDesc,
    color: 'emerald',
    icon: 'M17 20h5v-2a4 4 0 00-4-4h-1m-5 6H2v-2a5 5 0 0110 0v2zm0-10a4 4 0 110-8 4 4 0 010 8zm6 1a3 3 0 100-6',
  },
];
---

<Layout title={dict.site.title} description={dict.home.heroSub} locale={locale}>
  <!-- Hero (full-bleed, full-height, left-aligned editorial) -->
  <section class="relative flex min-h-[85vh] items-center overflow-hidden bg-stone-900 text-white">
    <Image
      src={school.schoolBuilding}
      alt=""
      class="hero-fade ken-burns absolute inset-0 h-full w-full object-cover opacity-50"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-linear-to-r from-emerald-950/95 via-emerald-900/70 to-emerald-950/30"
    >
    </div>
    <div class="relative mx-auto w-full max-w-7xl px-6 sm:px-10 py-24">
      <div class="max-w-3xl">
        <h1
          class="hero-rise text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.02] mb-6"
          style="--rise-delay: 120ms"
        >
          {dict.home.hero}
        </h1>
        <p
          class="hero-rise text-lg sm:text-xl text-emerald-100/90 max-w-xl leading-relaxed mb-10"
          style="--rise-delay: 360ms"
        >
          {dict.home.heroSub}
        </p>
        <div class="hero-rise flex flex-wrap gap-4" style="--rise-delay: 560ms">
          <a
            href={l('/subjects', locale)}
            class="rounded-full bg-emerald-500 px-7 py-3 text-sm sm:text-base font-semibold text-white shadow-lg shadow-emerald-900/40 transition-all hover:bg-emerald-400 hover:scale-105 active:scale-100"
          >
            {dict.home.ctaPrimary}
          </a>
          <a
            href={l('/admissions', locale)}
            class="rounded-full border border-white/30 bg-white/10 px-7 py-3 text-sm sm:text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-105 active:scale-100"
          >
            {dict.home.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What is IB (edge-to-edge split: photo bleeds left, text panel right) -->
  <section class="grid items-stretch lg:grid-cols-2">
    <div class="relative min-h-[22rem] lg:min-h-[36rem]" data-reveal>
      <Image
        src={school.studentsReading}
        alt="Students reading together in the school library"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[768, 1024, 1280]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
      />
    </div>
    <div
      class="flex items-center bg-white px-6 py-16 sm:px-10 lg:px-16 lg:py-24"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      <div class="max-w-xl">
        <div class="flex items-center gap-4 mb-5">
          <img
            src="/ib-logo.svg"
            alt="International Baccalaureate"
            class="h-14 w-auto shrink-0"
            width="135"
            height="135"
          />
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
            >{dict.home.whatIsIBLabel}</span
          >
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5">
          {dict.home.whatIsIB}
        </h2>
        <p class="text-stone-600 leading-relaxed">
          {dict.home.whatIsIBBody1}
        </p>
        <p class="text-stone-600 leading-relaxed mt-3">
          {dict.home.whatIsIBBody2}
        </p>
      </div>
    </div>
  </section>

  <!-- Programmes (full-bleed band, left-aligned header) -->
  <section class="bg-stone-100 border-y border-stone-200/70">
    <div class="mx-auto max-w-7xl px-6 sm:px-10 py-20 sm:py-28">
      <div class="max-w-2xl mb-12" data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{dict.home.programmesLabel}</span
        >
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 tracking-tight">
          {dict.home.programmesHeading}
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div data-reveal>
          <a
            href={l('/myp', locale)}
            class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-8 sm:p-10 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform hover:border-amber-300 hover:shadow-xl hover:-translate-y-1.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <div class="flex items-center justify-between gap-3 mb-6">
              <img
                src="/ib-myp-logo.png"
                alt="IB Middle Years Programme logo"
                width="640"
                height="256"
                class="h-12 w-auto transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03] motion-reduce:transition-none"
              />
              <span
                class="text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1 shrink-0"
                >{dict.home.mypAges}</span
              >
            </div>
            <h3 class="text-xl font-semibold mb-3">{dict.home.mypTitle}</h3>
            <p class="text-stone-600 leading-relaxed mb-4">
              {dict.home.mypDesc}
            </p>
            <ul class="text-sm text-stone-500 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-amber-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.mypItem1}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.mypItem2}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.mypItem3}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.mypItem4}
              </li>
            </ul>
            <p class="mt-5 pt-4 border-t border-stone-100 text-xs text-stone-400 leading-relaxed">
              {dict.home.mypNote}
            </p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-amber-700">
              {dict.home.mypCta}
              <span
                class="transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1 motion-reduce:transition-none"
                aria-hidden="true">→</span
              >
            </span>
          </a>
        </div>

        <div data-reveal style="--reveal-delay: 120ms">
          <a
            href={l('/dp', locale)}
            class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-8 sm:p-10 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform hover:border-emerald-300 hover:shadow-xl hover:-translate-y-1.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <div class="flex items-center justify-between gap-3 mb-6">
              <img
                src="/ib-dp-logo.png"
                alt="IB Diploma Programme logo"
                width="640"
                height="256"
                class="h-12 w-auto transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03] motion-reduce:transition-none"
              />
              <span
                class="text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 shrink-0"
                >{dict.home.dpAges}</span
              >
            </div>
            <h3 class="text-xl font-semibold mb-3">{dict.home.dpTitle}</h3>
            <p class="text-stone-600 leading-relaxed mb-4">
              {dict.home.dpDesc}
            </p>
            <ul class="text-sm text-stone-500 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.dpItem1}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.dpItem2}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.dpItem3}
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5 shrink-0">&bull;</span>
                {dict.home.dpItem4}
              </li>
            </ul>
            <span
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700"
            >
              {dict.home.dpCta}
              <span
                class="transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1 motion-reduce:transition-none"
                aria-hidden="true">→</span
              >
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Student work (contained, asymmetric sticky split) -->
  <section class="mx-auto max-w-7xl px-6 sm:px-10 py-20 sm:py-28">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-20 items-start">
      <div class="lg:sticky lg:top-28" data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{dict.home.benefitsLabel}</span
        >
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 tracking-tight max-w-xl">
          {dict.home.benefitsHeading}
        </h2>
        <p class="mt-4 text-stone-600 leading-relaxed max-w-lg">
          {dict.home.benefitsIntro}
        </p>
        <p class="mt-3 text-stone-500 leading-relaxed max-w-lg">
          {dict.home.workBody}
        </p>
        <Image
          src={school.projectPresentation}
          alt="Students presenting project work at Česká"
          class="mt-8 h-72 sm:h-96 w-full rounded-3xl object-cover shadow-lg"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          loading="lazy"
        />
      </div>
      <div class="border-t border-stone-300">
        {
          workItems.map((item, i) => (
            <a
              href={item.href}
              class="group grid grid-cols-[2.5rem_1fr_auto] gap-3 sm:gap-5 border-b border-stone-300 py-7 sm:py-10"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="text-xs font-semibold text-emerald-700 pt-1">{item.number}</span>
              <span>
                <span class="block text-lg sm:text-2xl font-semibold group-hover:text-emerald-700 transition-colors">
                  {item.title}
                </span>
                <span class="block mt-2 text-sm text-stone-500 leading-relaxed">{item.desc}</span>
              </span>
              <span
                class="text-sm font-semibold text-emerald-700 pt-1 group-hover:translate-x-1 transition-transform"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    featuredTestimonials.length > 0 && (
      <section class="bg-emerald-50/50 border-y border-emerald-100/70">
        <div class="mx-auto max-w-7xl px-6 sm:px-10 py-20 sm:py-28" data-reveal>
          <div class="max-w-2xl mb-12">
            <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">
              {dict.testimonials.homeLabel}
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 tracking-tight">
              {dict.testimonials.homeHeading}
            </h2>
          </div>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredTestimonials.map((s, i) => {
              const quote = pick(locale, s.entry.sk.quote, s.entry.quote ?? '');
              const role = pick(locale, s.entry.sk.role, s.entry.role ?? '');
              return (
                <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 70}ms`}>
                  <figure class="flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-6 transition-all hover:border-emerald-300 hover:shadow-md">
                    <span
                      class="text-4xl leading-none text-emerald-200 font-serif"
                      aria-hidden="true"
                    >
                      “
                    </span>
                    <blockquote class="mt-1 flex-1 text-stone-700 leading-relaxed">
                      {quote}
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4">
                      {s.entry.photo ? (
                        <img
                          src={s.entry.photo}
                          alt={s.entry.name}
                          width="40"
                          height="40"
                          loading="lazy"
                          class="h-10 w-10 rounded-full object-cover"
                        />
                      ) : (
                        <span
                          class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700"
                          aria-hidden="true"
                        >
                          {s.entry.name.trim().charAt(0).toUpperCase()}
                        </span>
                      )}
                      <div class="min-w-0">
                        <p class="text-sm font-semibold text-stone-900 truncate">{s.entry.name}</p>
                        {role && <p class="text-xs text-stone-500 truncate">{role}</p>}
                      </div>
                    </figcaption>
                  </figure>
                </li>
              );
            })}
          </ul>
          <div class="mt-10">
            <a
              href={l('/testimonials', locale)}
              class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors"
            >
              {dict.testimonials.homeCta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Daffodil Day 2026 (full-bleed dark split: text left, poster right) -->
  <section class="grid items-stretch bg-stone-900 text-white lg:grid-cols-2">
    <div
      class="order-2 flex items-center px-6 py-16 sm:px-10 lg:order-1 lg:px-16 lg:py-24"
      data-reveal
    >
      <div class="max-w-xl">
        <span class="text-xs font-semibold tracking-widest uppercase text-amber-400"
          >{dict.home.daffodilLabel}</span
        >
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 mb-5 tracking-tight">
          {dict.home.daffodilHeading}
        </h2>
        <p class="text-stone-300 leading-relaxed">
          {dict.home.daffodilBody1}
        </p>
        <p class="text-stone-300 leading-relaxed mt-3">
          {dict.home.daffodilBody2}
        </p>
        <p class="text-stone-300 leading-relaxed mt-3">
          {dict.home.daffodilBody3}
        </p>
        <a
          href={l('/cas/daffodil-day-2026', locale)}
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-amber-300 hover:text-amber-200 transition-colors"
        >
          {dict.home.daffodilCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <figure
      class="order-1 flex items-center justify-center bg-stone-950 p-8 sm:p-12 lg:order-2"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      <Image
        src={school.daffodilDay}
        alt={dict.home.daffodilCaption}
        class="max-h-[32rem] w-auto rounded-2xl object-contain shadow-2xl"
        widths={[480, 768, 1024]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="lazy"
      />
      <figcaption class="sr-only">{dict.home.daffodilCaption}</figcaption>
    </figure>
  </section>

  <!-- Photo marquee (full bleed, left-aligned header) -->
  <section class="overflow-hidden py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 sm:px-10 mb-10" data-reveal>
      <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >{dict.home.galleryLabel}</span
      >
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 tracking-tight">
        {dict.home.galleryHeading}
      </h2>
    </div>
    <div class="marquee relative" data-reveal>
      <div class="marquee-track flex w-max gap-4">
        {
          [...galleryPhotos, ...galleryPhotos].map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              class="h-56 sm:h-72 w-auto rounded-2xl object-cover shadow-sm hover:scale-[1.03] transition-transform duration-300"
              height={288}
              widths={[288, 576]}
              sizes="288px"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Explore (contained, left-aligned header) -->
  <section class="mx-auto max-w-7xl px-6 sm:px-10 py-20 sm:py-28">
    <div class="max-w-2xl mb-12" data-reveal>
      <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >{dict.home.exploreLabel}</span
      >
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 tracking-tight">
        {dict.home.exploreHeading}
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        exploreCards.map((card, i) => (
          <a
            href={card.href}
            class="group rounded-2xl border border-stone-200 bg-white p-6 hover:border-emerald-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div
              class:list={[
                'w-10 h-10 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform',
                card.color === 'amber'
                  ? 'bg-amber-100 text-amber-700'
                  : 'bg-emerald-100 text-emerald-700',
              ]}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={card.icon}
                />
              </svg>
            </div>
            <h3 class="font-semibold text-lg mb-1 group-hover:text-emerald-700 transition-colors">
              {card.label}
            </h3>
            <p class="text-sm text-stone-500">{card.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA (full-bleed gradient band) -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-emerald-800 via-emerald-700 to-teal-800 text-white"
    data-reveal
  >
    <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-emerald-400/20 blur-3xl"></div>
