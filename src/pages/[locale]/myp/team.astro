---
import ProgrammeTeam from '../../../components/ProgrammeTeam.astro';
import type { Locale } from '../../../i18n/dictionaries';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
---

<ProgrammeTeam locale={locale} programme="myp" />
