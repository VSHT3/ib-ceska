---
import { reader, pick } from '../../../../lib/keystatic';
import { mypSubjectGroups, formatMypYears } from '../../../../data/myp-subjects';
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import { t, l, contact } from '../../../../i18n/dictionaries';
import type { Locale } from '../../../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const copy = dict.mypSubjects;
const allSubjects = await reader.collections.mypSubjects.all();
const groups = mypSubjectGroups
  .map((group) => ({
    ...group,
    id: `group-${group.value}`,
    subjects: allSubjects
      .filter((subject) => subject.entry.group.discriminant === group.value)
      .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0)),
  }))
  .filter((group) => group.subjects.length > 0);
---

<Layout
  title={copy.title}
  description={copy.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <PageHeader title={copy.title} subtitle={copy.subtitle} label={copy.catalogueLabel} tone="myp">
    <nav aria-label={copy.breadcrumbLabel} class="hero-rise mt-8 text-sm text-white/90">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={l('/myp', locale)} class="underline underline-offset-4 hover:text-white">
            {dict.nav.myp}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{copy.title}</li>
      </ol>
    </nav>
  </PageHeader>

  <div class="mx-auto max-w-7xl px-6 py-14 sm:py-16 lg:px-12">
    {
      groups.length === 0 ? (
        <EmptyState message={copy.emptyMessage} hint={copy.emptyHint} />
      ) : (
        <div class="lg:grid lg:grid-cols-[14rem_1fr] lg:gap-16">
          <aside class="mb-10 lg:mb-0">
            <nav class="lg:sticky lg:top-28" aria-label={copy.onThisPage}>
              <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-stone-500">
                {copy.onThisPage}
              </p>
              <ul class="space-y-1 border-l border-stone-200">
                {groups.map((group) => (
                  <li>
                    <a
                      href={`#${group.id}`}
                      class="-ml-px block border-l-2 border-transparent py-2 pl-4 pr-2 text-sm text-stone-600 transition-colors hover:border-myp-600 hover:text-myp-700"
                    >
                      {group.label[locale]}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
          <div class="min-w-0">
            {groups.map((group, groupIndex) => (
              <section
                id={group.id}
                aria-labelledby={`${group.id}-title`}
                class:list={['scroll-mt-28', groupIndex > 0 && 'mt-16 sm:mt-20']}
                data-reveal
              >
                <header class="border-b-2 border-stone-900 pb-3">
                  <h2
                    id={`${group.id}-title`}
                    class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl"
                  >
                    {group.label[locale]}
                  </h2>
                </header>
                <ul class="mt-5 grid gap-4 sm:grid-cols-2">
                  {group.subjects.map((subject, index) => (
                    <li data-reveal style={`--reveal-delay: ${(index % 2) * 70}ms`}>
                      <a
                        href={l(`/myp/subjects/${subject.slug}`, locale)}
                        class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 transition-colors hover:border-myp-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-myp-700 sm:p-6"
                      >
                        <h3 class="text-lg font-semibold leading-snug tracking-tight text-stone-900 transition-colors group-hover:text-myp-700 sm:text-xl">
                          {pick(locale, subject.entry.sk.title, subject.entry.title)}
                        </h3>
                        <div class="mt-3 flex flex-wrap gap-2">
                          <span class="rounded-full bg-myp-100 px-2.5 py-1 text-xs font-semibold text-myp-800">
                            {formatMypYears(subject.entry.years)}
                          </span>
                          {subject.entry.group.discriminant === 'mathematics' &&
                            subject.entry.group.value.level === 'extended' && (
                              <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-700">
                                {copy.extendedLevel}
                              </span>
                            )}
                        </div>
                        <p class="mt-4 text-sm leading-relaxed text-stone-600">
                          {pick(locale, subject.entry.sk.description, subject.entry.description)}
                        </p>
                        <span class="mt-auto pt-5 text-sm font-semibold text-myp-700">
                          {copy.viewSubject} <span aria-hidden="true">→</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      )
    }

    <section
      class="mt-14 border-t border-stone-200 pt-10 sm:mt-16"
      aria-labelledby="myp-subject-contact"
      data-reveal
    >
      <h2 id="myp-subject-contact" class="text-2xl font-bold tracking-tight">
        {copy.contactTitle}
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">{copy.contactBody}</p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
        <a
          href={l('/myp/team', locale)}
          class="text-sm font-semibold text-myp-700 underline underline-offset-4 hover:text-myp-800"
        >
          {copy.teamLink}
        </a>
        <a
          href={`mailto:${contact.email}`}
          class="text-sm font-semibold text-myp-700 underline underline-offset-4 hover:text-myp-800"
        >
          {copy.emailLink}
        </a>
      </div>
    </section>
  </div>
</Layout>
