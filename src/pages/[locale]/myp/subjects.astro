---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DocumentList from '../../../components/DocumentList.astro';
import { l, t, type Locale } from '../../../i18n/dictionaries';
import { mypSubjectLeaders } from '../../../data/myp-organisation';
import { mypDocuments } from '../../../data/documents';
import {
  getMypCoreTopics,
  mypCurriculumCopy,
  mypSubjectDescriptions,
} from '../../../data/myp-programme';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const p = t(locale).myp;
const copy = mypCurriculumCopy[locale];
const topics = getMypCoreTopics(locale);
---

<Layout title={`${copy.subjectsTitle} · Česká`} description={copy.subjectsSubtitle} locale={locale}>
  <PageHeader
    title={copy.subjectsTitle}
    subtitle={copy.subjectsSubtitle}
    label={locale === 'sk' ? 'MYP · Kandidátsky program' : 'MYP · Candidate programme'}
    tone="myp"
  />

  <div class="border-b border-myp-200 bg-myp-50 px-6 py-6 lg:px-12">
    <p class="mx-auto max-w-7xl text-sm leading-relaxed text-stone-700">{p.note}</p>
  </div>

  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-12 lg:py-16">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-16" data-reveal>
      <h2 class="max-w-lg text-3xl font-bold tracking-tight sm:text-4xl">{copy.introTitle}</h2>
      <div class="min-w-0 max-w-prose space-y-5 leading-relaxed text-stone-600">
        <p>{copy.intro}</p>
        <p>{copy.scope}</p>
      </div>
    </div>

    <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:mt-12">
      {
        mypSubjectLeaders.map((group, index) => (
          <article
            id={group.id}
            class="min-w-0 scroll-mt-28 border-t border-stone-300 pt-6"
            data-reveal
          >
            <span class="text-xs font-semibold text-myp-700">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 break-words text-2xl font-bold tracking-tight">
              {group.label[locale]}
            </h3>
            <p class="mt-4 max-w-prose leading-relaxed text-stone-600">
              {mypSubjectDescriptions[group.label.en][locale]}
            </p>
            <p class="mt-5 text-sm text-stone-600">
              <span class="font-semibold text-stone-900">{copy.leader}: </span>
              {group.name}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-myp-200 bg-myp-50 px-6 py-12 lg:px-12 lg:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0" data-reveal>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{copy.assessmentTitle}</h2>
        <p class="mt-5 max-w-prose leading-relaxed text-stone-600">{copy.assessment}</p>
        <a
          href={l('/myp/policies', locale)}
          class="mt-6 inline-flex font-semibold text-myp-700 hover:underline"
        >
          {copy.policies} →
        </a>
      </div>
      <div class="min-w-0" data-reveal>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{copy.connectionsTitle}</h2>
        <p class="mt-5 max-w-prose leading-relaxed text-stone-600">{copy.connectionsBody}</p>
        <ul class="mt-6 space-y-3">
          {
            topics.map((topic) => (
              <li>
                <a
                  href={l(`/myp/core/${topic.slug}`, locale)}
                  class="break-words font-semibold text-myp-700 hover:underline"
                >
                  {topic.title} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-12 lg:py-16" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight">{copy.guidesTitle}</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-stone-600">{copy.guidesBody}</p>
    <div class="mt-8"><DocumentList items={mypDocuments} locale={locale} tone="myp" /></div>
    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4 text-sm font-semibold text-myp-700">
      <a href={l('/myp/teachers', locale)} class="hover:underline">{copy.team} →</a>
      <a href={l('/admissions', locale)} class="hover:underline">{p.admissionsLink} →</a>
      <a href={p.officialUrl} target="_blank" rel="noopener" class="hover:underline"
        >{p.officialLink} ↗</a
      >
    </div>
  </section>
</Layout>
