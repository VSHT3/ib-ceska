---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const b = dict.builder;

const allSubjects = await reader.collections.subjects.all();

type Choice = {
  slug: string;
  title: string;
  group: string;
  offered: 'both' | 'HL' | 'SL';
};

const subjectsOf = (group: string): Choice[] =>
  allSubjects
    .filter((s) => s.entry.group === group)
    .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0))
    .map((s) => ({
      slug: s.slug,
      title: pick(locale, s.entry.sk.title, s.entry.title),
      group: group,
      offered: (s.entry.offeredLevels ?? 'both') as Choice['offered'],
    }));

// Groups 1–5 are single-select. The sixth subject is an elective:
// any group-6 subject, or a second from groups 1–4.
const coreGroups = [
  { key: '1', label: dict.subjects.group1 },
  { key: '2', label: dict.subjects.group2 },
  { key: '3', label: dict.subjects.group3 },
  { key: '4', label: dict.subjects.group4 },
  { key: '5', label: dict.subjects.group5 },
].map((g) => ({ ...g, subjects: subjectsOf(g.key) }));

const electiveSubjects = [
  ...subjectsOf('6'),
  ...subjectsOf('1'),
  ...subjectsOf('2'),
  ...subjectsOf('3'),
  ...subjectsOf('4'),
];

const shortLabel = (label: string) => label.replace(/^[^:]+:\s*/, '');
const levelChips = (offered: Choice['offered']) => (offered === 'both' ? ['HL', 'SL'] : [offered]);
---

<Layout
  title={b.title}
  description={b.subtitle}
  locale={locale}
  pageSchemaType="WebApplication"
  pageSchema={{ applicationCategory: 'EducationalApplication', browserRequirements: 'JavaScript' }}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-stone-200/80 bg-white">
    <span
      class="absolute -right-8 -bottom-20 text-[13rem] sm:text-[20rem] font-extrabold leading-none tracking-tighter text-stone-100 select-none"
      aria-hidden="true">IB</span
    >
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >{b.label}</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {b.title}
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg text-stone-600 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {b.subtitle}
      </p>
      <div
        class="hero-rise mt-8 max-w-2xl rounded-2xl border border-stone-200 bg-stone-50 p-5"
        style="--rise-delay: 240ms"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-500">
          {b.ruleHeading}
        </p>
        <ul class="mt-3 space-y-1.5 text-sm text-stone-600">
          {
            b.rules.map((r) => (
              <li class="flex gap-2.5">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500" />
                {r}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div
    class="mx-auto max-w-6xl px-4 sm:px-6 py-12 lg:grid lg:grid-cols-[1fr_320px] lg:gap-12 lg:items-start"
  >
    <!-- Picker -->
    <form id="diploma-builder" class="min-w-0 space-y-10">
      {
        coreGroups.map((g) => (
          <fieldset class="border-t-2 border-stone-900 pt-4" data-group={g.key} data-reveal>
            <legend class="flex items-baseline gap-3">
              <span class="text-xs font-semibold uppercase tracking-widest text-emerald-700">
                {g.label.split(':')[0]}
              </span>
              <span class="text-lg font-bold tracking-tight">{shortLabel(g.label)}</span>
            </legend>
            {g.subjects.length === 0 ? (
              <p class="mt-3 text-sm text-stone-400">{b.noSubjectsInGroup}</p>
            ) : (
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {g.subjects.map((s) => (
                  <label class="group relative flex cursor-pointer items-start justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-4 transition-all hover:border-emerald-300 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 has-[:checked]:ring-1 has-[:checked]:ring-emerald-500 data-[taken]:cursor-not-allowed data-[taken]:hover:border-stone-200">
                    <div class="min-w-0">
                      <input
                        type="radio"
                        name={`group-${g.key}`}
                        value={s.slug}
                        data-slug={s.slug}
                        data-group={g.key}
                        data-offered={s.offered}
                        class="peer sr-only"
                      />
                      <span class="block font-semibold text-stone-900 peer-checked:text-emerald-800">
                        {s.title}
                      </span>
                      <span class="mt-2 inline-flex gap-1.5" data-level-group={`group-${g.key}`}>
                        {levelChips(s.offered).map((lv) => (
                          <button
                            type="button"
                            data-level={lv}
                            class:list={[
                              'rounded-full border px-2.5 py-0.5 text-xs font-bold transition-colors',
                              lv === 'HL'
                                ? 'border-emerald-200 text-emerald-700 hover:border-emerald-400 data-[on]:border-emerald-600 data-[on]:bg-emerald-600 data-[on]:text-white'
                                : 'border-sky-200 text-sky-700 hover:border-sky-400 data-[on]:border-sky-600 data-[on]:bg-sky-600 data-[on]:text-white',
                            ]}
                          >
                            {lv}
                          </button>
                        ))}
                      </span>
                    </div>
                    <span
                      class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-stone-300 transition-colors peer-checked:border-emerald-600 peer-checked:bg-emerald-600"
                      aria-hidden="true"
                      data-dot
                    />
                  </label>
                ))}
              </div>
            )}
          </fieldset>
        ))
      }

      <!-- Sixth subject (elective) -->
      <fieldset class="border-t-2 border-stone-900 pt-4" data-group="6" data-reveal>
        <legend class="flex items-baseline gap-3">
          <span class="text-xs font-semibold uppercase tracking-widest text-emerald-700"
            >{dict.subjects.group6.split(':')[0]} / +</span
          >
          <span class="text-lg font-bold tracking-tight">{shortLabel(dict.subjects.group6)}</span>
        </legend>
        <p class="mt-2 text-sm text-stone-500">{b.group6Note}</p>
        {
          electiveSubjects.length === 0 ? (
            <p class="mt-3 text-sm text-stone-400">{b.noSubjectsInGroup}</p>
          ) : (
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {electiveSubjects.map((s) => (
                <label class="group relative flex cursor-pointer items-start justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-4 transition-all hover:border-emerald-300 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 has-[:checked]:ring-1 has-[:checked]:ring-emerald-500 data-[taken]:cursor-not-allowed data-[taken]:hover:border-stone-200">
                  <div class="min-w-0">
                    <input
                      type="radio"
                      name="group-6"
                      value={s.slug}
                      data-slug={s.slug}
                      data-group="6"
                      data-source-group={s.group}
                      data-offered={s.offered}
                      class="peer sr-only"
                    />
                    <span class="block font-semibold text-stone-900 peer-checked:text-emerald-800">
                      {s.title}
                    </span>
                    <span class="mt-1 block text-[11px] text-stone-400">
                      {shortLabel(
                        coreGroups.find((g) => g.key === s.group)?.label ?? dict.subjects.group6,
                      )}
                    </span>
                    <span class="mt-2 inline-flex gap-1.5" data-level-group="group-6">
                      {levelChips(s.offered).map((lv) => (
                        <button
                          type="button"
                          data-level={lv}
                          class="rounded-full border border-stone-200 px-2.5 py-0.5 text-[11px] font-bold text-stone-500 transition-colors hover:border-emerald-400 data-[on]:border-emerald-600 data-[on]:bg-emerald-600 data-[on]:text-white"
                        >
                          {lv}
                        </button>
                      ))}
                    </span>
                  </div>
                  <span
                    class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-stone-300 transition-colors peer-checked:border-emerald-600 peer-checked:bg-emerald-600"
                    aria-hidden="true"
                    data-dot
                  />
                </label>
              ))}
            </div>
          )
        }
      </fieldset>
    </form>

    <!-- Summary panel -->
    <aside class="mt-12 lg:mt-0 lg:sticky lg:top-28">
      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold tracking-tight">{b.summaryTitle}</h2>

        <div class="mt-5 grid grid-cols-3 gap-3 text-center">
          <div class="rounded-xl bg-stone-50 py-3" data-count-tile>
            <p id="count-total" class="text-2xl font-extrabold text-stone-900">0</p>
            <p class="mt-0.5 text-[11px] text-stone-500">{b.totalLabel}</p>
          </div>
          <div class="rounded-xl bg-emerald-50 py-3" data-count-tile>
            <p id="count-hl" class="text-2xl font-extrabold text-emerald-700">0</p>
            <p class="mt-0.5 text-[11px] text-emerald-700/70">{b.hlCount}</p>
          </div>
          <div class="rounded-xl bg-sky-50 py-3" data-count-tile>
            <p id="count-sl" class="text-2xl font-extrabold text-sky-700">0</p>
            <p class="mt-0.5 text-[11px] text-sky-700/70">{b.slCount}</p>
          </div>
        </div>

        <ol id="summary-list" class="mt-5 space-y-2 text-sm"></ol>
        <p id="summary-empty" class="mt-5 text-sm text-stone-400">
          {b.summaryEmpty}
        </p>

        <p
          id="builder-status"
          class="mt-5 hidden rounded-xl px-4 py-3 text-sm font-medium"
          role="status"
        >
        </p>

        <button
          type="button"
          id="builder-reset"
          class="mt-5 w-full rounded-full border border-stone-200 py-2.5 text-sm font-semibold text-stone-600 transition-colors hover:border-stone-400 hover:text-stone-900"
        >
          {b.reset}
        </button>

        <div class="mt-6 border-t border-stone-200 pt-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">
            {b.coreLabel}
          </p>
          <p class="mt-2 text-sm text-stone-500 leading-relaxed">
            {b.coreNote}
          </p>
        </div>
      </div>
    </aside>
  </div>

  <script
    is:inline
    type="application/json"
    id="builder-strings"
    set:html={JSON.stringify({
      validComplete: b.validComplete,
      errSix: b.errSix,
      errHlRange: b.errHlRange,
    }).replaceAll('<', '\\u003c')}
  />

  <script>
    import { animate, createSpring, stagger, utils } from 'animejs';

    function initDiplomaBuilder() {
      const $ = (id: string) => document.getElementById(id);
      const formEl = $('diploma-builder');
      const listEl = $('summary-list');
      const emptyEl = $('summary-empty');
      const statusEl = $('builder-status');
      const totalEl = $('count-total');
      const hlEl = $('count-hl');
      const slEl = $('count-sl');
      const reset = $('builder-reset');
      const stringsEl = $('builder-strings');
      if (!formEl || !listEl || !emptyEl || !statusEl || !totalEl || !hlEl || !slEl || !stringsEl)
        return;
      // rebind: narrowed consts survive into the closures below
      const form = formEl;
      const list = listEl;
      const empty = emptyEl;
      const status = statusEl;
      const elTotal = totalEl;
      const elHl = hlEl;
      const elSl = slEl;

      const strings = JSON.parse(stringsEl.textContent ?? '{}') as Record<string, string>;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pop = () => createSpring({ stiffness: 260, damping: 13 });

      // level chosen per radio input slug; defaults to first available
      const levelFor = new Map<string, string>();
      const counters = { total: { v: 0 }, hl: { v: 0 }, sl: { v: 0 } };
      let prevSlugs = new Set<string>();
      let lastStatusKey = '';
      let prevHl = 0;

      const radios = () => Array.from(form.querySelectorAll<HTMLInputElement>('input[type=radio]'));
      const checked = () => radios().filter((r) => r.checked);
      const levelOf = (input: HTMLInputElement) =>
        levelFor.get(input.value) || (input.dataset.offered === 'SL' ? 'SL' : 'HL');

      function shake(el: Element) {
        if (reduced) return;
        utils.remove(el);
        animate(el, { x: [-7, 6, -4, 2, 0], duration: 400, ease: 'outQuad' });
      }

      // Counter ticks: number counts to the new value while the digit pops
      function tick(el: HTMLElement, state: { v: number }, next: number) {
        if (state.v === next) return;
        if (reduced) {
          state.v = next;
          el.textContent = String(next);
          return;
        }
        utils.remove(state);
        animate(state, {
          v: next,
          duration: 450,
          ease: 'outQuad',
          onUpdate: () => {
            el.textContent = String(Math.round(state.v));
          },
        });
        utils.remove(el);
        animate(el, { scale: [1, 1.16, 1], duration: 350, ease: 'outQuad' });
      }

      function setLevelButtons(label: HTMLLabelElement) {
        const wrap = label.querySelector('[data-level-group]');
        const input = label.querySelector<HTMLInputElement>('input[type=radio]');
        if (!wrap || !input) return;
        const chosen = levelOf(input);
        levelFor.set(input.value, chosen);
        wrap.querySelectorAll<HTMLButtonElement>('button[data-level]').forEach((btn) => {
          btn.toggleAttribute('data-on', btn.dataset.level === chosen);
        });
      }

      // A subject picked anywhere greys out its duplicate card in other groups
      function syncTaken() {
        const selected = new Map<string, HTMLInputElement>();
        checked().forEach((r) => selected.set(r.value, r));
        radios().forEach((r) => {
          const dup = selected.get(r.value);
          const taken = !!dup && dup !== r && !r.checked;
          const label = r.closest('label');
          if (!label || label.hasAttribute('data-taken') === taken) return;
          label.toggleAttribute('data-taken', taken);
          r.disabled = taken;
          if (reduced) {
            label.style.opacity = taken ? '0.45' : '1';
          } else {
            utils.remove(label);
            animate(label, {
              opacity: taken ? 0.45 : 1,
              scale: taken ? 0.98 : 1,
              duration: 300,
              ease: 'outQuad',
            });
          }
        });
      }

      function updateStatus(total: number, hl: number) {
        status.classList.remove('bg-emerald-50', 'text-emerald-800', 'bg-myp-50', 'text-myp-800');
        if (total === 0) {
          status.classList.add('hidden');
          lastStatusKey = '';
          return;
        }
        let kind: 'ok' | 'error' = 'ok';
        let text = strings.validComplete;
        if (total !== 6) {
          kind = 'error';
          text = strings.errSix;
        } else if (hl < 3 || hl > 4) {
          kind = 'error';
          text = strings.errHlRange;
        }
        status.textContent = text ?? '';
        status.classList.add(
          ...(kind === 'ok'
            ? ['bg-emerald-50', 'text-emerald-800']
            : ['bg-myp-50', 'text-myp-800']),
        );
        status.classList.remove('hidden');
        const key = `${kind}:${text}`;
        if (key === lastStatusKey) return;
        lastStatusKey = key;
        if (reduced) return;
        if (kind === 'error') {
          shake(status);
        } else {
          // valid diploma: status springs in, counter tiles cascade
          utils.remove(status);
          animate(status, {
            scale: [0.94, 1],
            y: [8, 0],
            opacity: [0, 1],
            duration: 550,
            ease: pop(),
          });
          animate('[data-count-tile]', {
            scale: [1, 1.1, 1],
            duration: 450,
            delay: stagger(70),
            ease: 'outQuad',
          });
        }
      }

      function render() {
        const sel = checked();
        list.innerHTML = '';
        let hl = 0;
        let sl = 0;
        const current = new Set<string>();

        sel.forEach((input) => {
          const label = input.closest('label');
          const title = label?.querySelector('span')?.textContent?.trim() ?? '';
          const level = levelOf(input);
          if (level === 'HL') hl++;
          else sl++;
          current.add(input.value);

          const li = document.createElement('li');
          li.dataset.slug = input.value;
          li.className = 'flex items-center justify-between gap-2 rounded-lg bg-stone-50 px-3 py-2';
          const name = document.createElement('span');
          name.className = 'truncate text-stone-700';
          name.textContent = title;
          const badge = document.createElement('span');
          badge.className =
            'shrink-0 rounded-full px-2 py-0.5 text-[11px] font-bold ' +
            (level === 'HL' ? 'bg-emerald-100 text-emerald-800' : 'bg-sky-100 text-sky-800');
          badge.textContent = level;
          li.append(name, badge);
          list.append(li);
        });

        const total = sel.length;
        tick(elTotal, counters.total, total);
        tick(elHl, counters.hl, hl);
        tick(elSl, counters.sl, sl);
        empty.classList.toggle('hidden', total > 0);

        // spring in rows that weren't in the summary before
        if (!reduced) {
          const fresh = Array.from(list.querySelectorAll<HTMLElement>('li')).filter(
            (li) => !prevSlugs.has(li.dataset.slug ?? ''),
          );
          if (fresh.length) {
            animate(fresh, {
              opacity: [0, 1],
              x: [14, 0],
              duration: 500,
              delay: stagger(45),
              ease: pop(),
            });
          }
        }
        prevSlugs = current;

        // climbing past 4 HL nudges the HL tile
        if (hl > 4 && prevHl <= 4) {
          const tile = elHl.closest('[data-count-tile]');
          if (tile) shake(tile);
        }
        prevHl = hl;

        syncTaken();
        updateStatus(total, hl);
      }

      // Initialise level button states
      form.querySelectorAll('label').forEach(setLevelButtons);

      form.addEventListener('change', (e) => {
        const input = e.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'radio') return;
        if (!reduced) {
          const dot = input.closest('label')?.querySelector('[data-dot]');
          if (dot) {
            utils.remove(dot);
            animate(dot, { scale: [0.4, 1], duration: 500, ease: pop() });
          }
        }
        render();
      });

      form.addEventListener('click', (e) => {
        const target = e.target as Element;

        // duplicate of an already-picked subject: refuse with a shake
        const takenLabel = target.closest('label[data-taken]');
        if (takenLabel) {
          e.preventDefault();
          shake(takenLabel);
          return;
        }

        // Level chip clicks (inside labels) must not toggle the radio
        const btn = target.closest<HTMLButtonElement>('button[data-level]');
        if (!btn) return;
        e.preventDefault();
        const label = btn.closest('label');
        const input = label?.querySelector<HTMLInputElement>('input[type=radio]');
        if (!label || !input) return;
        levelFor.set(input.value, btn.dataset.level ?? 'HL');
        setLevelButtons(label);
        if (!reduced) {
          utils.remove(btn);
          animate(btn, { scale: [1, 1.25, 1], duration: 300, ease: 'outQuad' });
        }
        if (input.checked) render();
      });

      reset?.addEventListener('click', () => {
        const clear = () => {
          radios().forEach((r) => {
            r.checked = false;
          });
          render();
        };
        const items = Array.from(list.querySelectorAll('li'));
        if (reduced || items.length === 0) {
          clear();
          return;
        }
        animate(items, {
          opacity: 0,
          x: -12,
          duration: 200,
          delay: stagger(28),
          ease: 'inQuad',
          onComplete: clear,
        });
      });

      render();
    }

    document.addEventListener('astro:page-load', initDiplomaBuilder);
  </script>
</Layout>
