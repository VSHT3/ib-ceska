---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allSubjects = await reader.collections.subjects.all();
const groups = [
  { key: '1', label: dict.subjects.group1 },
  { key: '2', label: dict.subjects.group2 },
  { key: '3', label: dict.subjects.group3 },
  { key: '4', label: dict.subjects.group4 },
  { key: '5', label: dict.subjects.group5 },
  { key: '6', label: dict.subjects.group6 },
  { key: 'core', label: dict.subjects.core },
];
---

<Layout title={dict.subjects.title} description="IB subject listings by group" locale={locale}>
  <PageHeader title={dict.subjects.title} subtitle={dict.subjects.subtitle} label="IB DP" />

  <div class="mx-auto max-w-5xl px-4 py-12">
    {
      groups.map((group) => {
        const groupSubjects = allSubjects
          .filter((s) => s.entry.group === group.key)
          .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0));

        if (groupSubjects.length === 0) return null;

        return (
          <section class="mb-12" data-reveal>
            <h2 class="text-xl font-semibold mb-4 text-emerald-800 flex items-center gap-3">
              <span class="inline-block h-6 w-1 rounded-full bg-emerald-600" />
              {group.label}
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {groupSubjects.map((s) => (
                <a
                  href={`/${locale}/subjects/${s.slug}`}
                  class="block rounded-2xl border border-stone-200 bg-white p-5 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                  <div class="flex items-center justify-between mb-1 gap-3">
                    <h3 class="font-semibold">{pick(locale, s.entry.sk.title, s.entry.title)}</h3>
                    {s.entry.level && (
                      <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-medium shrink-0">{s.entry.level}</span>
                    )}
                  </div>
                  <p class="text-sm text-stone-600">{pick(locale, s.entry.sk.description, s.entry.description)}</p>
                  {s.entry.teacher && (
                    <p class="text-xs text-stone-400 mt-2">{dict.subjects.teacher}: {s.entry.teacher}</p>
                  )}
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</Layout>
