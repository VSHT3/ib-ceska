---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const all = await reader.collections.testimonials.all();
const testimonials = all.sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0));

const initial = (name: string) => name.trim().charAt(0).toUpperCase();
---

<Layout
  title={dict.testimonials.title}
  description={dict.testimonials.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Editorial hero -->
  <section
    class="relative overflow-hidden border-b border-stone-200/80 bg-white"
  >
    <span
      class="absolute -right-6 -bottom-20 text-[12rem] sm:text-[18rem] font-extrabold leading-none tracking-tighter text-stone-100 select-none"
      aria-hidden="true">“</span
    >
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 py-14 sm:py-20">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >{dict.testimonials.label}</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.testimonials.title}
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg text-stone-600 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.testimonials.subtitle}
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-14">
    {
      testimonials.length === 0 ? (
        <EmptyState message={dict.testimonials.none} />
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2">
          {testimonials.map((s, i) => {
            const name = s.entry.name;
            const role = pick(locale, s.entry.sk.role, s.entry.role ?? '');
            const quote = pick(locale, s.entry.sk.quote, s.entry.quote ?? '');
            return (
              <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 70}ms`}>
                <figure class="flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-6 sm:p-8 transition-all hover:border-emerald-300 hover:shadow-md">
                  <span
                    class="text-5xl leading-none text-emerald-200 font-serif"
                    aria-hidden="true"
                  >
                    “
                  </span>
                  <blockquote class="mt-1 flex-1 text-lg text-stone-700 leading-relaxed">
                    {quote}
                  </blockquote>
                  <figcaption class="mt-6 flex items-center gap-4 border-t border-stone-100 pt-5">
                    {s.entry.photo ? (
                      <img
                        src={s.entry.photo}
                        alt={name}
                        width="48"
                        height="48"
                        loading="lazy"
                        class="h-12 w-12 rounded-full object-cover"
                      />
                    ) : (
                      <span
                        class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-lg font-bold text-emerald-700"
                        aria-hidden="true"
                      >
                        {initial(name)}
                      </span>
                    )}
                    <div class="min-w-0">
                      <p class="font-semibold text-stone-900 truncate">
                        {name}
                      </p>
                      {role && (
                        <p class="text-sm text-stone-500 truncate">{role}</p>
                      )}
                    </div>
                  </figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Layout>
