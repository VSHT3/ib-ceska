---
import Layout from '../../../layouts/Layout.astro';
import RecommendTool from '../../../components/RecommendTool.tsx';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const PROJECT_URL = 'https://menstrual-products-comparison.vercel.app/';

const physicsData = [
  { product: 'Naturella Pad', capacity: 16.0, capacityRank: 1, rate: 44.23, rateRank: 7 },
  { product: 'Always Platinum', capacity: 11.3, capacityRank: 2, rate: 7.76, rateRank: 1 },
  { product: 'Ria Ultra Pad', capacity: 8.6, capacityRank: 3, rate: 13.73, rateRank: 5 },
  { product: 'Ria Tampon', capacity: 8.0, capacityRank: 4, rate: 12.73, rateRank: 4 },
  { product: 'o.b. Tampon', capacity: 8.0, capacityRank: 4, rate: 14.07, rateRank: 6 },
  { product: 'Jessa Cotton Pad', capacity: 7.8, capacityRank: 6, rate: 8.6, rateRank: 2 },
  { product: 'Jessa Cloth Pad', capacity: 2.5, capacityRank: 7, rate: 10.08, rateRank: 3 },
];

const axes = [
  {
    label: 'Biology',
    emoji: '🧫',
    desc: 'TSS risk, bacterial growth, skin irritation, and chemical exposure through literature review',
  },
  {
    label: 'Chemistry',
    emoji: '⚗️',
    desc: 'Chemical composition: VOCs, phthalates, heavy metals, bleaching residues, endocrine disruptors',
  },
  {
    label: 'Physics',
    emoji: '📐',
    desc: 'Hands-on lab experiments measuring absorption capacity (g/g) and absorption rate (s/5 mL)',
  },
  {
    label: 'Environmental Science',
    emoji: '🌱',
    desc: 'Waste volume, decomposition timelines, marine pollution, and reusability analysis',
  },
  {
    label: 'Computer Science',
    emoji: '💻',
    desc: 'Website, interactive recommendation tool, data analysis, and source gathering',
  },
];

const healthFindings = [
  {
    title: 'TSS Risk',
    finding:
      'Tampons are the only product type associated with Toxic Shock Syndrome. Incidence is about 1 in 100,000, but all five pad products in this study carry zero TSS risk.',
    source: 'Clue, 2024; CDC',
  },
  {
    title: 'Heavy Metals',
    finding:
      'A 2024 study found lead in all 30 tampons tested, plus arsenic, cadmium, and mercury across 14 brands. Heavy metals are absorbed by cotton from soil.',
    source: 'Shearston et al., Environment International, 2024',
  },
  {
    title: 'PFAS in Reusables',
    finding:
      '33% of period underwear and 25% of reusable pads had intentionally added PFAS at parts-per-million levels, far above typical trace contamination.',
    source: 'Wicks et al., EST Letters, 2025',
  },
  {
    title: 'VOCs and Phthalates',
    finding:
      'Commercial pads contain volatile organic compounds and phthalates from fragrances, adhesives, and plastic packaging, linked to menstrual irregularities and cancer risk.',
    source: 'Brookings Institution, 2024',
  },
];

const envStats = [
  { value: '80.85B', label: 'products per menstrual cycle globally', color: 'rose' },
  { value: '4.3B', label: 'disposable products used annually in the UK', color: 'rose' },
  { value: '~800', label: 'years to fully decompose in landfills', color: 'rose' },
  { value: '2B', label: 'items flushed down UK toilets yearly', color: 'amber' },
  { value: '18,000', label: 'products wash up on beaches annually worldwide', color: 'amber' },
  { value: '100K', label: 'marine animals killed by plastic debris each year', color: 'emerald' },
];
---

<Layout
  title="Collaborative Sciences Project Presentations"
  description="Two DP student groups present their Collaborative Sciences Project investigations. Group 1 compared menstrual products across five scientific disciplines."
  locale="en"
  ogType="article"
  publishedTime="2026-06-10"
  pageSchemaType="Event"
  pageSchema={{
    name: 'Collaborative Sciences Project Presentations',
    startDate: '2026-06-10',
    location: { '@type': 'Place', name: 'Súkromné Gymnázium Česká, Bratislava' },
  }}
>
  {/* Hero */}
  <section
    class="relative overflow-hidden bg-gradient-to-br from-rose-600 via-rose-500 to-pink-700 text-white"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"
    >
    </div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full blur-3xl bg-rose-300/20"></div>
    <div class="relative mx-auto max-w-5xl px-6 py-16 sm:py-24">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase mb-3 text-rose-100"
      >
        IB Collaborative Sciences Project · 10 June 2026
      </span>
      <h1
        class="hero-rise text-4xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        Comparing Menstrual Products
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg sm:text-xl leading-relaxed text-rose-50/90"
        style="--rise-delay: 160ms"
      >
        A cross-disciplinary study examining organic pads, commercial pads, reusable cloth pads, and
        tampons through the lenses of Biology, Chemistry, Physics, Environmental Science, and
        Computer Science.
      </p>
      <div class="hero-rise mt-7 flex flex-wrap gap-3" style="--rise-delay: 240ms">
        <a
          href={PROJECT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white text-rose-600 font-semibold text-sm hover:bg-rose-50 transition-all duration-200"
        >
          Visit Project Website
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="#recommendation-tool"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-rose-700/40 text-white font-medium text-sm hover:bg-rose-700/60 border border-rose-300/30 transition-all duration-200 backdrop-blur-sm"
        >
          Try the Recommendation Tool
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
    {/* Group members */}
    <div class="mb-12 sm:mb-16">
      <h2 class="text-xs font-semibold text-rose-500 uppercase tracking-widest mb-3">
        Group 1 Members
      </h2>
      <p class="text-lg sm:text-xl text-stone-700 leading-relaxed">
        Hui Ru Yang, Anna Udicova, Ela Sabolova, Milana Golubkova, Alexander Hvezdon Stefko
      </p>
    </div>

    {/* Global Issue + Aim */}
    <div class="grid sm:grid-cols-2 gap-4 sm:gap-6 mb-12 sm:mb-16">
      <div class="border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-sm">
        <h3 class="text-xs font-semibold text-rose-500 uppercase tracking-widest mb-2">
          Global Issue
        </h3>
        <p class="text-lg sm:text-xl font-bold text-stone-900 leading-relaxed">
          Global women's health issues
        </p>
        <p class="text-sm sm:text-base text-stone-600 mt-2 sm:mt-3 leading-relaxed">
          Millions of women use menstrual products daily without full knowledge of their chemical
          composition, bacterial safety, or environmental footprint. This project addresses that gap
          through rigorous cross-disciplinary analysis.
        </p>
      </div>
      <div class="bg-rose-50 rounded-2xl p-6 sm:p-8">
        <h3 class="text-xs font-semibold text-rose-500 uppercase tracking-widest mb-2">Our Aim</h3>
        <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
          To compare menstrual products across five scientific disciplines and a cost analysis to
          determine which product type minimizes health and environmental risks, and to recommend
          safer options for women.
        </p>
      </div>
    </div>

    {/* Research Question */}
    <div class="max-w-4xl mx-auto mb-12 sm:mb-16 text-center">
      <h3 class="text-sm font-semibold text-amber-600 uppercase tracking-widest mb-3 sm:mb-4">
        Research Question
      </h3>
      <p class="text-2xl sm:text-3xl font-bold text-stone-900 leading-snug">
        Which type of menstrual product best minimizes health risks and environmental impact across
        biological, chemical, physical, and environmental dimensions?
      </p>
    </div>

    {/* Evaluation Axes */}
    <div class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-4 sm:mb-6">
        Five Evaluation Axes
      </h2>
      <div class="grid sm:grid-cols-2 xl:grid-cols-5 gap-4 sm:gap-5">
        {
          axes.map((item) => (
            <div class="border border-stone-200 rounded-xl p-5 shadow-sm hover:border-rose-300 hover:bg-rose-50/40 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
              <div class="text-2xl mb-2">{item.emoji}</div>
              <h3 class="text-base font-bold text-stone-900 mb-1">{item.label}</h3>
              <p class="text-sm text-stone-600 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Physics experiment data */}
    <div class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-2">Physics Lab Results</h2>
      <p class="text-sm text-stone-500 mb-5">
        Hands-on experiments with simulated fluid (water + glycerol, blood-mimicking viscosity).
        Three trials per product, averaged.
      </p>
      <div class="border border-stone-200 rounded-2xl overflow-hidden shadow-sm overflow-x-auto">
        <table class="w-full text-sm sm:text-base">
          <thead>
            <tr class="bg-stone-50">
              <th class="px-5 py-3 text-left font-bold text-stone-800">Product</th>
              <th class="px-5 py-3 text-left font-bold text-stone-800">Absorption Capacity (g/g)</th
              >
              <th class="px-5 py-3 text-left font-bold text-stone-800">Capacity Rank</th>
              <th class="px-5 py-3 text-left font-bold text-stone-800">Absorption Rate (s/5 mL)</th>
              <th class="px-5 py-3 text-left font-bold text-stone-800">Rate Rank</th>
            </tr>
          </thead>
          <tbody>
            {
              physicsData.map((row, i) => (
                <tr class={i % 2 === 0 ? '' : 'bg-stone-50/50'}>
                  <td class="px-5 py-3 font-medium text-stone-900">{row.product}</td>
                  <td class="px-5 py-3 text-stone-700">{row.capacity.toFixed(1)}</td>
                  <td class="px-5 py-3">
                    <span
                      class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${row.capacityRank === 1 ? 'bg-emerald-100 text-emerald-700' : 'bg-stone-100 text-stone-600'}`}
                    >
                      {row.capacityRank}
                    </span>
                  </td>
                  <td class="px-5 py-3 text-stone-700">{row.rate.toFixed(2)}</td>
                  <td class="px-5 py-3">
                    <span
                      class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${row.rateRank === 1 ? 'bg-emerald-100 text-emerald-700' : 'bg-stone-100 text-stone-600'}`}
                    >
                      {row.rateRank}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    {/* Key Health Findings */}
    <div class="border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-12 sm:mb-16">
      <h2 class="text-xs sm:text-sm font-bold text-stone-800 uppercase tracking-wider mb-5 sm:mb-6">
        Key Health Findings from Literature
      </h2>
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
        {
          healthFindings.map(({ title, finding, source }) => (
            <div class="border-l-2 border-rose-300 pl-4">
              <p class="text-sm sm:text-base font-bold text-stone-900 mb-1">{title}</p>
              <p class="text-sm sm:text-base text-stone-600 mb-2 leading-relaxed">{finding}</p>
              <p class="text-xs sm:text-sm text-stone-400 italic">{source}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Environmental Impact Stats */}
    <div class="border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-12 sm:mb-16">
      <h2 class="text-xs sm:text-sm font-bold text-stone-800 uppercase tracking-wider mb-5 sm:mb-6">
        Environmental Impact at Scale
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
        {
          envStats.map((stat) => (
            <div
              class={`rounded-xl p-5 text-center ${stat.color === 'rose' ? 'bg-rose-50' : stat.color === 'amber' ? 'bg-amber-50' : 'bg-emerald-50'}`}
            >
              <p
                class={`text-3xl font-bold ${stat.color === 'rose' ? 'text-rose-500' : stat.color === 'amber' ? 'text-amber-600' : 'text-emerald-600'}`}
              >
                {stat.value}
              </p>
              <p class="text-sm text-stone-600 mt-1">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Recommendation Tool */}
    <div id="recommendation-tool" class="mb-12 sm:mb-16 scroll-mt-8">
      <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-2">
        Interactive Recommendation Tool
      </h2>
      <p class="text-sm text-stone-500 mb-6">
        Reproduced from the group's website. Adjust the sliders to see how priorities change the
        ranking.
      </p>
      <RecommendTool client:load />
    </div>

    {/* Overall Finding */}
    <div class="bg-rose-50 rounded-2xl p-6 sm:p-8 mb-12 sm:mb-16">
      <h2 class="text-lg sm:text-xl font-bold text-stone-900 mb-2 sm:mb-3">Overall Finding</h2>
      <p class="text-base text-stone-700 leading-relaxed mb-4">
        Physics data shows commercial pads (especially Naturella) absorb significantly more fluid
        per gram than cloth pads. However, absorption rate tells a different story: Always Platinum
        absorbed 5 mL in just 7.76 seconds (rank 1), while Naturella took 44.23 seconds (rank 7).
      </p>
      <p class="text-sm sm:text-base text-stone-700 leading-relaxed mb-4">
        Literature research reveals a critical health tradeoff: tampons carry the highest bacterial
        growth risk and are the only product type associated with Toxic Shock Syndrome (TSS), caused
        by <em>Staphylococcus aureus</em> toxin release. A 2024 study detected 16 heavy metals, including
        lead, arsenic, and cadmium, across all 14 tampon brands tested (Shearston et al.,
        <em>Environment International</em>). Meanwhile, a 2025 Notre Dame study found PFAS "forever
        chemicals" in 33% of reusable period products at parts-per-million levels (Wicks et al.,
        <em>EST Letters</em>).
      </p>
      <p class="text-sm sm:text-base text-stone-700 leading-relaxed">
        No single product excels across all axes. The optimal choice depends on user priorities:
        performance (commercial pads), safety and comfort (organic pads), or environmental impact
        (reusable cloth).
      </p>
    </div>

    {/* Proposed Improved Product */}
    <div class="border-2 border-rose-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-12 sm:mb-16">
      <h2 class="text-lg sm:text-xl font-bold text-stone-900 mb-1">Proposed Improved Product</h2>
      <p class="text-sm sm:text-base text-rose-500 mb-4 font-medium">
        Design based on the group's findings
      </p>
      <ul class="space-y-3 text-sm sm:text-base text-stone-700">
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span
            >Organic cotton top layer (safety and comfort: low bacterial growth, no synthetic fibres
            against skin, no fragrance or dye exposure)</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span
            >High-absorbency polymer core (performance: maximum capacity like Naturella, but with
            faster wicking like Always Platinum)</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span
            >Biodegradable outer shell (environment: reduced decomposition time vs conventional
            polyethylene film)</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span>Reusable or compostable packaging (environment: lower CO₂ footprint per use)</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span
            >No fragrance additives or chlorine bleaching (safety: eliminates dioxin and phthalate
            risks found in commercial products)</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span class="text-rose-500 mt-0.5">→</span>
          <span
            >PFAS-free waterproofing if reusable (environment: avoids the 25-33% of reusable
            products found with intentionally added PFAS per Wicks et al., 2025)</span
          >
        </li>
      </ul>
    </div>

    {/* CTA to full website */}
    <div class="bg-rose-500 rounded-2xl p-8 sm:p-10 text-center text-white mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold mb-2 sm:mb-3">Explore the full project</h2>
      <p class="text-rose-100 mb-5 sm:mb-6 text-sm sm:text-base">
        The group built an interactive website with radar charts, a correlation explorer, product
        detail pages, and the full recommendation tool.
      </p>
      <a
        href={PROJECT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block w-full sm:w-auto bg-white text-rose-500 font-semibold px-6 py-3 rounded-xl hover:bg-rose-50 transition-all duration-200 text-sm"
      >
        Visit menstrual-products-comparison.vercel.app ↗
      </a>
    </div>

    {/* Group 2 placeholder */}
    <div class="border border-dashed border-stone-300 rounded-2xl p-8 sm:p-12 text-center">
      <h2 class="text-lg font-bold text-stone-400 mb-2">Group 2</h2>
      <p class="text-sm text-stone-400">
        Details about the second group's project will be added soon.
      </p>
    </div>
  </div>
</Layout>
