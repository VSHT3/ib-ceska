---
import Layout from '../../../layouts/Layout.astro';
import RecommendTool from '../../../components/RecommendTool.tsx';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const PROJECT_URL = 'https://menstrual-products-comparison.vercel.app/';

const physicsData = [
  { product: 'Naturella Pad', capacity: 16.0, rate: 44.23 },
  { product: 'Always Platinum', capacity: 11.3, rate: 7.76 },
  { product: 'Ria Ultra Pad', capacity: 8.6, rate: 13.73 },
  { product: 'Ria Tampon', capacity: 8.0, rate: 12.73 },
  { product: 'o.b. Tampon', capacity: 8.0, rate: 14.07 },
  { product: 'Jessa Cotton Pad', capacity: 7.8, rate: 8.6 },
  { product: 'Jessa Cloth Pad', capacity: 2.5, rate: 10.08 },
];
---

<Layout
  title="Collaborative Sciences Project Presentations"
  description="Group 1 compared menstrual products across five scientific disciplines. Try the interactive recommendation tool reproduced from their project website."
  locale="en"
  ogType="article"
  publishedTime="2026-06-10"
  pageSchemaType="Event"
  pageSchema={{
    name: 'Collaborative Sciences Project Presentations',
    startDate: '2026-06-10',
    location: { '@type': 'Place', name: 'Súkromné Gymnázium Česká, Bratislava' },
  }}
>
  {/* Hero */}
  <section
    class="relative overflow-hidden bg-gradient-to-br from-rose-600 via-rose-500 to-pink-700 text-white"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"
    >
    </div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full blur-3xl bg-rose-300/20"></div>
    <div class="relative px-6 sm:px-12 lg:px-20 py-14 sm:py-20">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase mb-3 text-rose-100"
      >
        IB Collaborative Sciences Project · 10 June 2026
      </span>
      <h1
        class="hero-rise text-4xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        Group 1: Comparing Menstrual Products
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg sm:text-xl leading-relaxed text-rose-50/90"
        style="--rise-delay: 160ms"
      >
        Which product type minimizes health risks and environmental impact?
      </p>
      <div class="hero-rise mt-7" style="--rise-delay: 240ms">
        <a
          href={PROJECT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white text-rose-600 font-semibold text-sm hover:bg-rose-50 transition-all duration-200"
        >
          Full Project Website ↗
        </a>
      </div>
    </div>
  </section>
  <div class="px-6 sm:px-12 lg:px-20 py-12 sm:py-16">
    {/* Physics results + Recommendation tool side by side on large screens */}
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-6 sm:gap-10 mb-12 sm:mb-16 items-start">
      {/* Left column: intro paragraph + physics table */}
      <div>
        <p class="text-justify text-base sm:text-lg text-stone-600 leading-relaxed mb-8">
          Hui Ru Yang, Anna Udicova, Ela Sabolova, Milana Golubkova, and Alexander Hvezdon Stefko
          compared seven products from three brands across five evaluation axes: safety, comfort,
          performance, environment, and cost. Below is a snippet of their work: the physics lab
          results and the interactive recommendation tool, reproduced from their website.
        </p>

        <h2 class="text-lg font-bold text-stone-900 mb-1">Physics Lab Results</h2>
        <p class="text-sm text-stone-500 mb-4">
          Absorption capacity (g/g) and rate (s/5 mL), averaged over 3 trials with simulated fluid.
        </p>
        <div class="border border-stone-200 rounded-xl overflow-hidden overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-stone-50">
                <th class="px-4 py-2.5 text-left font-semibold text-stone-700">Product</th>
                <th class="px-4 py-2.5 text-right font-semibold text-stone-700">Capacity (g/g)</th>
                <th class="px-4 py-2.5 text-right font-semibold text-stone-700">Rate (s/5 mL)</th>
              </tr>
            </thead>
            <tbody>
              {
                physicsData.map((row, i) => (
                  <tr class={i % 2 === 0 ? '' : 'bg-stone-50/50'}>
                    <td class="px-4 py-2.5 font-medium text-stone-900">{row.product}</td>
                    <td class="px-4 py-2.5 text-right tabular-nums text-stone-700">
                      {row.capacity.toFixed(1)}
                    </td>
                    <td class="px-4 py-2.5 text-right tabular-nums text-stone-700">
                      {row.rate.toFixed(2)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-xs text-stone-400 mt-3">
          Naturella absorbs the most per gram but is the slowest. Always Platinum is the fastest. No
          product wins on both metrics.
        </p>
      </div>

      {/* Right column: recommendation tool */}
      <div id="recommendation-tool" class="scroll-mt-8">
        <h2 class="text-lg font-bold text-stone-900 mb-1">Recommendation Tool</h2>
        <p class="text-sm text-stone-500 mb-4">
          Adjust the sliders to match your priorities. The tool re-ranks all seven products using
          the group's research data.
        </p>
        <RecommendTool client:load />
      </div>
    </div>

    {/* Group 2 + link */}
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="border border-dashed border-stone-300 rounded-xl p-6 text-center">
        <h3 class="text-sm font-bold text-stone-400 mb-1">Group 2</h3>
        <p class="text-xs text-stone-400">Details coming soon.</p>
      </div>
      <a
        href={PROJECT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between rounded-xl bg-rose-500 p-6 text-white hover:bg-rose-600 transition-colors"
      >
        <div>
          <h3 class="text-sm font-bold">Explore the full project website</h3>
          <p class="text-xs text-rose-100 mt-0.5">
            Radar charts, correlation explorer, product pages
          </p>
        </div>
        <span class="text-lg font-bold group-hover:translate-x-1 transition-transform">↗</span>
      </a>
    </div>
  </div>
</Layout>
