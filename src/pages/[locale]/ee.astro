---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { school } from '../../assets/school';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const ee = dict.ee;

// "October: choose topic and supervisor" → phase + task
const steps = [
  ee.timelineItem1,
  ee.timelineItem2,
  ee.timelineItem3,
  ee.timelineItem4,
  ee.timelineItem5,
].map((item) => {
  const [phase, ...rest] = item.split(':');
  return { phase: phase.trim(), task: rest.join(':').trim() };
});

const facts = [
  { value: ee.factWords, label: ee.factWordsLabel },
  { value: ee.factSubjects, label: ee.factSubjectsLabel },
  { value: ee.factHours, label: ee.factHoursLabel },
  { value: ee.factPoints, label: ee.factPointsLabel },
];

const reflections = [
  { title: ee.reflection1Title, body: ee.reflection1Body },
  { title: ee.reflection2Title, body: ee.reflection2Body },
  { title: ee.reflection3Title, body: ee.reflection3Body },
];

const resources = [
  {
    label: ee.resourceIbo,
    note: ee.resourceIboNote,
    href: 'https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/',
    external: true,
  },
  {
    label: ee.resourceIntegrity,
    note: ee.resourceIntegrityNote,
    href: '/documents/academic-integrity-policy.pdf',
    pdf: true,
  },
  { label: ee.resourcePolicies, note: ee.resourcePoliciesNote, href: l('/policies', locale) },
];
---

<Layout title={ee.title} description={ee.subtitle} locale={locale}>
  <!-- Split hero: copy + facts on the left, photograph running to the edge on the right -->
  <section class="grid bg-white lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-12">
    <div
      class="flex items-center px-6 pt-20 pb-16 sm:pt-28 sm:pb-20 lg:col-span-7 lg:px-12 lg:py-24 xl:pl-16 xl:pr-20"
    >
      <div class="w-full">
        <span
          class="hero-rise inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>IB Core
        </span>
        <h1
          class="hero-rise mt-4 text-5xl font-bold tracking-tighter leading-[0.95] sm:text-6xl xl:text-7xl"
          style="--rise-delay: 80ms"
        >
          {ee.title}
        </h1>
        <p
          class="hero-rise mt-6 max-w-xl text-lg leading-relaxed text-stone-600 sm:text-xl"
          style="--rise-delay: 160ms"
        >
          {ee.subtitle}
        </p>
        <dl
          class="hero-rise mt-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:mt-16 lg:grid-cols-4"
          style="--rise-delay: 240ms"
        >
          {
            facts.map((f) => (
              <div class="border-t border-stone-300 pt-4">
                <dd class="text-4xl font-extrabold tracking-tighter text-stone-900 tabular-nums sm:text-5xl">
                  {f.value}
                </dd>
                <dt class="mt-2 text-sm leading-snug text-stone-500">{f.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
    <div class="relative min-h-[22rem] bg-stone-900 sm:min-h-[28rem] lg:col-span-5 lg:min-h-full">
      <Image
        src={school.studentsReading}
        alt="Two students reading a textbook together in the school library"
        class="hero-fade absolute inset-0 h-full w-full object-cover"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- What it is: sticky essay column on the left, supervisor + reflections rail on the right -->
  <section class="border-t border-stone-200 bg-stone-50">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-6 py-20 sm:py-28 lg:grid-cols-12 lg:gap-16 lg:px-12"
    >
      <div class="lg:col-span-5 lg:self-start lg:sticky lg:top-28" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{ee.whatLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
          {ee.whatTitle}
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-600">{ee.whatBody1}</p>
        <p class="mt-4 max-w-xl leading-relaxed text-stone-600">{ee.whatBody2}</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div
          class="rounded-3xl bg-stone-900 p-8 text-white sm:p-10"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-300"
            >{ee.supervisorLabel}</span
          >
          <h3 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">{ee.supervisorTitle}</h3>
          <p class="mt-4 leading-relaxed text-stone-300">{ee.supervisorBody}</p>
        </div>

        <div class="mt-14 sm:mt-16">
          <span
            class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
            data-reveal
          >
            <span class="h-px w-10 bg-current" aria-hidden="true"></span>{ee.reflectionLabel}
          </span>
          <h3
            class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
            data-reveal
            style="--reveal-delay: 60ms"
          >
            {ee.reflectionTitle}
          </h3>
          <p
            class="mt-4 max-w-xl leading-relaxed text-stone-600"
            data-reveal
            style="--reveal-delay: 120ms"
          >
            {ee.reflectionIntro}
          </p>
          <ol class="mt-8 border-t border-stone-300">
            {
              reflections.map((r, i) => (
                <li
                  class="grid gap-3 border-b border-stone-300 py-6 sm:grid-cols-[4rem_1fr] sm:gap-6"
                  data-reveal
                  style={`--reveal-delay: ${160 + i * 70}ms`}
                >
                  <span
                    class="text-4xl font-extrabold leading-none tracking-tighter text-stone-300 tabular-nums select-none"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h4 class="text-lg font-semibold tracking-tight text-stone-900">{r.title}</h4>
                    <p class="mt-1.5 leading-relaxed text-stone-600">{r.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey: five hairline cells across the full shell -->
  <section class="border-t border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-12">
      <div class="max-w-2xl" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{ee.journeyLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          {ee.journeyTitle}
        </h2>
        <p class="mt-5 leading-relaxed text-stone-600">{ee.journeyIntro}</p>
      </div>

      <ol class="mt-12 grid gap-px sm:mt-16 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step, i) => (
            <li
              class="group relative flex min-h-52 flex-col bg-white p-6 outline-1 outline-stone-200 transition-colors hover:bg-emerald-50/60 lg:min-h-60 lg:p-7"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span
                class="text-5xl font-extrabold leading-none tracking-tighter text-stone-200 transition-colors group-hover:text-emerald-200 select-none"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="mt-10 text-xs font-semibold tracking-widest uppercase text-emerald-700">
                {step.phase}
              </span>
              <h3 class="mt-2 text-lg font-semibold leading-snug tracking-tight text-stone-900">
                {step.task}
              </h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Resources: dark closing band, intro left and link rows right -->
  <section class="bg-stone-900 text-white">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-6 py-20 sm:py-28 lg:grid-cols-12 lg:gap-16 lg:px-12"
    >
      <div class="lg:col-span-5" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-300"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{ee.resourcesLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{ee.resourcesTitle}</h2>
        <p class="mt-5 max-w-lg leading-relaxed text-stone-300">{ee.resourcesIntro}</p>
      </div>
      <ul class="border-t border-white/15 lg:col-span-7 lg:col-start-6">
        {
          resources.map((r, i) => (
            <li data-reveal style={`--reveal-delay: ${80 + i * 70}ms`}>
              <a
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener' : undefined}
                data-umami-event={r.pdf ? 'pdf-download' : undefined}
                data-umami-event-doc={r.pdf ? 'academic-integrity-policy' : undefined}
                class="group flex items-start justify-between gap-6 border-b border-white/15 py-6 transition-colors hover:bg-white/[0.04] sm:py-7"
              >
                <span class="min-w-0">
                  <span class="block text-lg font-semibold tracking-tight text-white sm:text-xl">
                    {r.label}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-stone-400">{r.note}</span>
                </span>
                <span
                  class="mt-1 shrink-0 text-lg text-emerald-300 transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  {r.external || r.pdf ? '↗' : '→'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
