---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

// "October: choose topic and supervisor" → phase + task
const steps = [
  dict.ee.timelineItem1,
  dict.ee.timelineItem2,
  dict.ee.timelineItem3,
  dict.ee.timelineItem4,
  dict.ee.timelineItem5,
].map((item) => {
  const [phase, ...rest] = item.split(':');
  return { phase: phase.trim(), task: rest.join(':').trim() };
});

const stats = [
  { value: locale === 'sk' ? '4 000' : '4,000', label: dict.ee.statWords },
  { value: '1', label: dict.ee.statQuestion },
  { value: '1', label: dict.ee.statSupervisor },
];

const downloads = [
  { label: 'EE Guide (PDF)', href: '#' },
  { label: 'RPPF Form', href: '#' },
  { label: 'Assessment Criteria', href: '#' },
];
const resources = [
  {
    label: 'Official IBO Page',
    href: 'https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/',
    external: true,
  },
  { label: 'Sample Essays', href: '#' },
  { label: 'Citation Guide', href: '#' },
];
---

<Layout title={dict.ee.title} description={dict.ee.subtitle} locale={locale}>
  <!-- Editorial stat hero -->
  <section
    class="relative overflow-hidden border-b border-stone-200/80 dark:border-stone-800/80 bg-white dark:bg-stone-900"
  >
    <span
      class="absolute -right-10 -bottom-20 text-[16rem] sm:text-[22rem] font-extrabold leading-none tracking-tighter text-stone-100 select-none"
      aria-hidden="true">EE</span
    >
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-emerald-700 dark:text-emerald-300"
        >IB Core</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.ee.title}
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg text-stone-600 dark:text-stone-400 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.ee.subtitle}
      </p>
      <dl class="hero-rise mt-10 grid grid-cols-3 gap-6 max-w-xl" style="--rise-delay: 240ms">
        {
          stats.map((stat) => (
            <div class="border-l-2 border-emerald-600 pl-4">
              <dd class="text-3xl sm:text-4xl font-extrabold tracking-tight text-stone-900 dark:text-stone-100">
                {stat.value}
              </dd>
              <dt class="mt-1 text-xs sm:text-sm text-stone-500 dark:text-stone-400 leading-snug">
                {stat.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <!-- Journey stepper -->
    <section data-reveal>
      <span
        class="text-xs font-semibold tracking-widest uppercase text-emerald-700 dark:text-emerald-300"
        >{dict.ee.journeyLabel}</span
      >
      <h2 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight">{dict.ee.journeyTitle}</h2>

      <div class="relative mt-12">
        <div
          class="absolute top-5 left-[10%] right-[10%] h-0.5 bg-emerald-100 hidden md:block"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute md:hidden left-5 top-5 bottom-8 w-0.5 bg-emerald-100"
          aria-hidden="true"
        >
        </div>
        <ol class="grid gap-10 md:gap-6 md:grid-cols-5">
          {
            steps.map((step, i) => (
              <li
                class="relative flex md:flex-col items-start md:items-center gap-5 md:gap-0 md:text-center"
                data-reveal
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-700 dark:bg-emerald-600 dark:hover:bg-emerald-500 text-sm font-bold text-white ring-8 ring-stone-50 dark:ring-stone-950">
                  {i + 1}
                </span>
                <div class="md:mt-5">
                  <p class="font-bold text-stone-900 dark:text-stone-100">{step.phase}</p>
                  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400 leading-relaxed md:max-w-[180px]">
                    {step.task}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Documents + resources -->
    <section class="mt-20 grid sm:grid-cols-2 gap-6 max-w-3xl">
      <div
        class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-7"
        data-reveal
      >
        <div
          class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 mb-4"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
            ></path></svg
          >
        </div>
        <h2 class="text-lg font-bold mb-3">{dict.ee.documents}</h2>
        <ul class="text-sm space-y-2.5">
          {
            downloads.map((d) => (
              <li>
                <a
                  href={d.href}
                  class="text-emerald-700 dark:text-emerald-300 font-medium hover:text-emerald-800 dark:hover:text-emerald-200 hover:underline underline-offset-2"
                >
                  {d.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-7"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        <div
          class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 mb-4"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
            ></path></svg
          >
        </div>
        <h2 class="text-lg font-bold mb-3">{dict.ee.resources}</h2>
        <ul class="text-sm space-y-2.5">
          {
            resources.map((r) => (
              <li>
                <a
                  href={r.href}
                  target={r.external ? '_blank' : undefined}
                  rel={r.external ? 'noopener' : undefined}
                  class="text-emerald-700 dark:text-emerald-300 font-medium hover:text-emerald-800 dark:hover:text-emerald-200 hover:underline underline-offset-2"
                >
                  {r.label}
                  {r.external && ' ↗'}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Layout>
