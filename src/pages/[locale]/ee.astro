---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

// "October: choose topic and supervisor" → phase + task
const steps = [
  dict.ee.timelineItem1,
  dict.ee.timelineItem2,
  dict.ee.timelineItem3,
  dict.ee.timelineItem4,
  dict.ee.timelineItem5,
].map((item) => {
  const [phase, ...rest] = item.split(':');
  return { phase: phase.trim(), task: rest.join(':').trim() };
});

const stats = [
  { value: locale === 'sk' ? '4 000' : '4,000', label: dict.ee.statWords },
  { value: '1', label: dict.ee.statQuestion },
  { value: '1', label: dict.ee.statSupervisor },
];

const downloads = [
  { label: 'EE Guide (PDF)', href: '#' },
  { label: 'RPPF Form', href: '#' },
  { label: 'Assessment Criteria', href: '#' },
];
const resources = [
  {
    label: 'Official IBO Page',
    href: 'https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/',
    external: true,
  },
  { label: 'Sample Essays', href: '#' },
  { label: 'Citation Guide', href: '#' },
];
---

<Layout title={dict.ee.title} description={dict.ee.subtitle} locale={locale}>
  <!-- Editorial stat hero -->
  <section class="relative overflow-hidden border-b border-stone-200/80 bg-white">
    <span
      class="absolute -right-10 -bottom-20 text-[16rem] sm:text-[22rem] font-extrabold leading-none tracking-tighter text-stone-100 select-none"
      aria-hidden="true">EE</span
    >
    <div class="relative mx-auto max-w-7xl px-6 lg:px-12 py-16 sm:py-24">
      <span
        class="hero-rise inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        ><span class="h-px w-10 bg-current" aria-hidden="true"></span>IB Core</span
      >
      <h1
        class="hero-rise mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.ee.title}
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg text-stone-600 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.ee.subtitle}
      </p>
      <dl
        class="hero-rise mt-12 grid grid-cols-3 gap-6 sm:gap-12 max-w-4xl"
        style="--rise-delay: 240ms"
      >
        {
          stats.map((stat) => (
            <div class="border-l-2 border-emerald-600 pl-4 sm:pl-6">
              <dd class="text-4xl sm:text-5xl font-extrabold tracking-tight text-stone-900">
                {stat.value}
              </dd>
              <dt class="mt-2 text-xs sm:text-sm text-stone-500 leading-snug max-w-[16ch]">
                {stat.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Journey: hairline rows with ghost numerals -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 pt-16 sm:pt-20 pb-20 sm:pb-28">
      <div class="max-w-2xl" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
          ><span class="h-px w-10 bg-current" aria-hidden="true"></span>{dict.ee.journeyLabel}</span
        >
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">
          {dict.ee.journeyTitle}
        </h2>
      </div>

      <ol class="mt-12 sm:mt-16 border-t border-stone-300">
        {
          steps.map((step, i) => (
            <li
              class="border-b border-stone-300 py-8 sm:py-10 lg:grid lg:grid-cols-12 lg:gap-8"
              data-reveal
              style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}
            >
              <div class="flex items-start gap-5 sm:gap-6 lg:col-span-5">
                <span
                  class="text-4xl sm:text-5xl font-extrabold leading-none tracking-tighter text-stone-200 select-none"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="pt-1 text-xl sm:text-2xl font-bold tracking-tight text-stone-900">
                  {step.phase}
                </h3>
              </div>
              <p class="mt-4 lg:mt-0 lg:pt-1 lg:col-span-6 lg:col-start-7 text-stone-600 leading-relaxed max-w-xl">
                {step.task}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Closing full-bleed band: documents + resources in an asymmetric split -->
  <section class="bg-stone-900 text-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28 lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <div
          class="mb-5 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-emerald-300"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
            ></path></svg
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">{dict.ee.documents}</h2>
        <ul class="mt-6 border-t border-white/10 divide-y divide-white/10">
          {
            downloads.map((d) => (
              <li>
                <a
                  href={d.href}
                  class="group flex items-center justify-between gap-4 py-4 text-sm font-medium text-stone-200 transition-colors hover:text-white"
                >
                  {d.label}
                  <span
                    class="text-emerald-300 transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="mt-16 lg:mt-0 lg:col-span-6 lg:col-start-7"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div
          class="mb-5 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-emerald-300"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
            ></path></svg
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">{dict.ee.resources}</h2>
        <ul class="mt-6 border-t border-white/10 divide-y divide-white/10">
          {
            resources.map((r) => (
              <li>
                <a
                  href={r.href}
                  target={r.external ? '_blank' : undefined}
                  rel={r.external ? 'noopener' : undefined}
                  class="group flex items-center justify-between gap-4 py-4 text-sm font-medium text-stone-200 transition-colors hover:text-white"
                >
                  <span>
                    {r.label}
                    {r.external && ' ↗'}
                  </span>
                  <span
                    class="text-emerald-300 transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>
