---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
---

<Layout title={dict.ee.title} description="Extended Essay" locale={locale}>
  <h1 class="text-3xl font-bold mb-2">{dict.ee.title}</h1>
  <p class="text-stone-600 mb-8">{dict.ee.subtitle}</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="rounded-xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold mb-2">{dict.ee.timeline}</h2>
      <ul class="text-sm text-stone-600 space-y-2">
        <li>{dict.ee.timelineItem1}</li>
        <li>{dict.ee.timelineItem2}</li>
        <li>{dict.ee.timelineItem3}</li>
        <li>{dict.ee.timelineItem4}</li>
        <li>{dict.ee.timelineItem5}</li>
      </ul>
    </div>

    <div class="rounded-xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold mb-2">{dict.ee.documents}</h2>
      <ul class="text-sm text-stone-600 space-y-2">
        <li><a href="#" class="text-emerald-700 hover:underline">EE Guide (PDF)</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">RPPF Form</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Assessment Criteria</a></li>
      </ul>
    </div>

    <div class="rounded-xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold mb-2">{dict.ee.resources}</h2>
      <ul class="text-sm text-stone-600 space-y-2">
        <li><a href="https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/" class="text-emerald-700 hover:underline" target="_blank">Official IBO Page</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Sample Essays</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Citation Guide</a></li>
      </ul>
    </div>
  </div>
</Layout>
