---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const timeline = [
  dict.ee.timelineItem1,
  dict.ee.timelineItem2,
  dict.ee.timelineItem3,
  dict.ee.timelineItem4,
  dict.ee.timelineItem5,
];
---

<Layout title={dict.ee.title} description="Extended Essay" locale={locale}>
  <PageHeader title={dict.ee.title} subtitle={dict.ee.subtitle} label="IB Core" />

  <div class="mx-auto max-w-5xl px-4 py-12 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1 rounded-2xl border border-stone-200 bg-white p-6" data-reveal>
      <h2 class="text-lg font-semibold mb-5">{dict.ee.timeline}</h2>
      <ol class="relative border-l-2 border-emerald-100 ml-2 space-y-6">
        {timeline.map((item, i) => (
          <li class="pl-5 relative">
            <span class="absolute -left-[9px] top-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-600 text-[9px] font-bold text-white ring-4 ring-white">{i + 1}</span>
            <p class="text-sm text-stone-600 leading-relaxed">{item}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="rounded-2xl border border-stone-200 bg-white p-6 h-fit" data-reveal style="--reveal-delay: 100ms">
      <h2 class="text-lg font-semibold mb-3">{dict.ee.documents}</h2>
      <ul class="text-sm text-stone-600 space-y-2">
        <li><a href="#" class="text-emerald-700 hover:underline">EE Guide (PDF)</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">RPPF Form</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Assessment Criteria</a></li>
      </ul>
    </div>

    <div class="rounded-2xl border border-stone-200 bg-white p-6 h-fit" data-reveal style="--reveal-delay: 200ms">
      <h2 class="text-lg font-semibold mb-3">{dict.ee.resources}</h2>
      <ul class="text-sm text-stone-600 space-y-2">
        <li><a href="https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/" class="text-emerald-700 hover:underline" target="_blank" rel="noopener">Official IBO Page</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Sample Essays</a></li>
        <li><a href="#" class="text-emerald-700 hover:underline">Citation Guide</a></li>
      </ul>
    </div>
  </div>
</Layout>
