---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import DocumentList from '../../components/DocumentList.astro';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { guideDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allEssays = (await reader.collections.tok.all()).sort(
  (a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime(),
);

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
---

<Layout
  title={dict.tok.title}
  description={dict.tok.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Contemplative dark hero: wide shell, asymmetric title/quote split -->
  <section class="relative overflow-hidden bg-stone-900 text-white">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-myp-500/10 via-transparent to-transparent"
    >
    </div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-emerald-500/10 blur-3xl">
    </div>
    <span
      class="absolute -right-8 -top-24 text-[20rem] sm:text-[26rem] font-extrabold leading-none text-white/[0.04] select-none"
      aria-hidden="true">?</span
    >
    <div class="relative mx-auto max-w-7xl px-6 lg:px-12 py-24 sm:py-32">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-8 lg:items-end">
        <div class="lg:col-span-7">
          <span
            class="hero-rise flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-myp-300"
          >
            <span class="h-px w-10 bg-current" aria-hidden="true"></span>
            IB Core
          </span>
          <h1
            class="hero-rise mt-4 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight"
            style="--rise-delay: 80ms"
          >
            {dict.tok.title}
          </h1>
          <p
            class="hero-rise mt-6 max-w-xl text-lg text-stone-300 leading-relaxed"
            style="--rise-delay: 160ms"
          >
            {dict.tok.subtitle}
          </p>
        </div>
        <div
          class="hero-rise border-l-2 border-myp-400/60 pl-5 lg:col-span-4 lg:col-start-9 lg:pl-6"
          style="--rise-delay: 240ms"
        >
          <p class="text-xs font-semibold tracking-widest uppercase text-stone-400">
            {dict.tok.heroQuoteLabel}
          </p>
          <p class="mt-2 text-2xl sm:text-3xl font-medium italic text-myp-100 tracking-tight">
            “{dict.tok.heroQuote}”
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Essay index: ghost-numeral rows across full-width hairlines -->
  <section class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" data-reveal>{dict.tok.heading}</h2>

    {
      allEssays.length === 0 ? (
        <div class="mt-12">
          <EmptyState message={dict.tok.noMaterials} />
        </div>
      ) : (
        <ol class="mt-12 border-t border-stone-300">
          {allEssays.map((e, i) => (
            <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}>
              <a
                href={`/${locale}/tok/${e.slug}`}
                class="group grid gap-4 border-b border-stone-300 py-8 sm:py-10 lg:grid-cols-12 lg:gap-8"
              >
                <div class="flex items-start gap-4 sm:gap-6 lg:col-span-5">
                  <span
                    class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-none tracking-tighter text-stone-200 group-hover:text-myp-200 transition-colors select-none"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 pt-1">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-2">
                      <span class="text-[11px] font-bold rounded-full bg-myp-100 text-myp-800 px-2.5 py-0.5">
                        {e.entry.theme}
                      </span>
                      {e.entry.date && (
                        <time class="text-xs text-stone-400">{fmtDate(e.entry.date)}</time>
                      )}
                    </div>
                    <h3 class="text-xl sm:text-2xl font-semibold italic tracking-tight text-stone-900 group-hover:text-myp-800 transition-colors">
                      “{pick(locale, e.entry.sk.title, e.entry.title)}”
                    </h3>
                  </div>
                </div>
                <div class="flex items-start gap-4 lg:col-span-6 lg:col-start-7 lg:pt-2">
                  <p class="flex-1 max-w-[65ch] text-sm sm:text-base text-stone-600 leading-relaxed">
                    {pick(locale, e.entry.sk.description, e.entry.description)}
                  </p>
                  <span
                    class="pt-1 text-myp-700 font-semibold opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <!-- TOK Handbook: full-bleed dark closing band echoing the hero -->
  <section class="relative overflow-hidden bg-stone-900 text-white" data-reveal>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-emerald-500/10 via-transparent to-transparent"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-24">
      <div class="grid gap-10 items-start lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <span
            class="flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-myp-300"
          >
            <span class="h-px w-10 bg-current" aria-hidden="true"></span>
            {dict.tok.handbookLabel}
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">
            {dict.tok.handbookTitle}
          </h2>
          <p class="mt-4 max-w-[65ch] text-sm sm:text-base text-stone-300 leading-relaxed">
            {dict.tok.handbookIntro}
          </p>
          <a
            href={l('/policies', locale)}
            class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-myp-200 hover:text-white transition-colors"
          >
            {dict.tok.handbookMore}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <DocumentList
            items={guideDocuments.filter((doc) => doc.file === 'tok-handbook.pdf')}
            locale={locale}
            tone="dp"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
