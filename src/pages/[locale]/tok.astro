---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import DocumentList from '../../components/DocumentList.astro';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { guideDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allEssays = (await reader.collections.tok.all()).sort(
  (a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime(),
);

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
---

<Layout
  title={dict.tok.title}
  description={dict.tok.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Contemplative dark hero -->
  <section class="relative overflow-hidden bg-stone-900 text-white">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-myp-500/10 via-transparent to-transparent"
    >
    </div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-emerald-500/10 blur-3xl">
    </div>
    <span
      class="absolute -right-8 -top-24 text-[20rem] sm:text-[26rem] font-extrabold leading-none text-white/[0.04] select-none"
      aria-hidden="true">?</span
    >
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-20 sm:py-28">
      <span
        class="hero-rise inline-block text-xs font-semibold tracking-widest uppercase text-myp-300"
        >IB Core</span
      >
      <h1
        class="hero-rise mt-3 text-5xl sm:text-6xl font-bold tracking-tight"
        style="--rise-delay: 80ms"
      >
        {dict.tok.title}
      </h1>
      <p
        class="hero-rise mt-5 max-w-2xl text-lg text-stone-300 leading-relaxed"
        style="--rise-delay: 160ms"
      >
        {dict.tok.subtitle}
      </p>
      <div class="hero-rise mt-10 border-l-2 border-myp-400/60 pl-5" style="--rise-delay: 240ms">
        <p class="text-xs font-semibold tracking-widest uppercase text-stone-400">
          {dict.tok.heroQuoteLabel}
        </p>
        <p class="mt-2 text-2xl sm:text-3xl font-medium italic text-myp-100 tracking-tight">
          “{dict.tok.heroQuote}”
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-14">
    <h2 class="text-2xl font-bold tracking-tight mb-2" data-reveal>{dict.tok.heading}</h2>

    {
      allEssays.length === 0 ? (
        <div class="mt-6">
          <EmptyState message={dict.tok.noMaterials} />
        </div>
      ) : (
        <ol class="mt-8 border-t border-stone-300">
          {allEssays.map((e, i) => (
            <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}>
              <a
                href={`/${locale}/tok/${e.slug}`}
                class="group grid grid-cols-[3.5rem_1fr_auto] sm:grid-cols-[4.5rem_1fr_auto] gap-4 sm:gap-6 items-start border-b border-stone-300 py-8 sm:py-10"
              >
                <span
                  class="text-4xl sm:text-5xl font-extrabold leading-none tracking-tighter text-stone-200 group-hover:text-myp-200 transition-colors select-none"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-2">
                    <span class="text-[11px] font-bold rounded-full bg-myp-100 text-myp-800 px-2.5 py-0.5">
                      {e.entry.theme}
                    </span>
                    {e.entry.date && (
                      <time class="text-xs text-stone-400">{fmtDate(e.entry.date)}</time>
                    )}
                  </div>
                  <h3 class="text-xl sm:text-2xl font-semibold italic tracking-tight text-stone-900 group-hover:text-myp-800 transition-colors">
                    “{pick(locale, e.entry.sk.title, e.entry.title)}”
                  </h3>
                  <p class="mt-2.5 text-sm sm:text-base text-stone-600 leading-relaxed">
                    {pick(locale, e.entry.sk.description, e.entry.description)}
                  </p>
                </div>
                <span
                  class="pt-1 text-myp-700 font-semibold opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>

  <!-- TOK Handbook (school document supplied by the DP coordinator) -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 pb-16">
    <section class="border-t border-stone-300 pt-12" data-reveal>
      <div class="grid gap-8 sm:grid-cols-[0.85fr_1.15fr] sm:gap-12 items-start">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">
            {dict.tok.handbookLabel}
          </span>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">
            {dict.tok.handbookTitle}
          </h2>
          <p class="mt-4 text-sm text-stone-600 leading-relaxed">{dict.tok.handbookIntro}</p>
          <a
            href={l('/policies', locale)}
            class="group mt-5 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors"
          >
            {dict.tok.handbookMore}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
        <DocumentList
          items={guideDocuments.filter((doc) => doc.file === 'tok-handbook.pdf')}
          locale={locale}
          tone="dp"
        />
      </div>
    </section>
  </div>
</Layout>
