---
import { Image } from 'astro:assets';
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import DocumentList from '../../components/DocumentList.astro';
import { school } from '../../assets/school';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { guideDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const tok = dict.tok;

const allEssays = (await reader.collections.tok.all()).sort(
  (a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime(),
);

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;

const essayCols =
  allEssays.length >= 3
    ? 'sm:grid-cols-2 lg:grid-cols-3'
    : allEssays.length === 2
      ? 'sm:grid-cols-2'
      : '';
---

<Layout
  title={tok.title}
  description={tok.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <!-- Photo hero: classroom discussion behind a left-to-right scrim, question anchored bottom-right -->
  <section class="relative overflow-hidden bg-stone-950 text-white">
    <Image
      src={school.classroom}
      alt=""
      class="hero-fade ken-burns absolute inset-0 h-full w-full object-cover object-[70%_center]"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/80 to-stone-950/25"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-stone-950 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid min-h-[72svh] max-w-7xl content-end gap-10 px-6 pt-28 pb-16 sm:pt-36 sm:pb-20 lg:grid-cols-12 lg:items-end lg:gap-8 lg:px-12"
    >
      <div class="lg:col-span-7">
        <span
          class="hero-rise inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-300"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>IB Core
        </span>
        <h1
          class="hero-rise mt-4 text-5xl font-bold tracking-tighter leading-[0.95] sm:text-6xl xl:text-7xl"
          style="--rise-delay: 80ms"
        >
          {tok.title}
        </h1>
        <p
          class="hero-rise mt-6 max-w-xl text-lg leading-relaxed text-stone-300 sm:text-xl"
          style="--rise-delay: 160ms"
        >
          {tok.subtitle}
        </p>
      </div>
      <div
        class="hero-rise border-l-2 border-emerald-400/70 pl-5 lg:col-span-4 lg:col-start-9 lg:pl-6"
        style="--rise-delay: 240ms"
      >
        <p class="text-xs font-semibold tracking-widest uppercase text-stone-400">
          {tok.heroQuoteLabel}
        </p>
        <p class="mt-2 text-2xl font-medium italic tracking-tight text-white sm:text-3xl">
          “{tok.heroQuote}”
        </p>
      </div>
    </div>
  </section>

  <!-- Course anatomy: bento of themes, areas, and figures -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-12">
      <div class="max-w-3xl" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{tok.courseLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
          {tok.courseTitle}
        </h2>
        <p class="mt-5 max-w-2xl leading-relaxed text-stone-600">{tok.courseIntro}</p>
      </div>

      <div class="mt-12 grid gap-4 sm:mt-16 lg:grid-cols-12 lg:gap-5">
        <div
          class="flex flex-col rounded-3xl bg-emerald-800 p-8 text-white sm:p-10 lg:col-span-5"
          data-reveal
        >
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-200"
            >{tok.coreLabel}</span
          >
          <h3 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{tok.coreTheme}</h3>
          <p class="mt-auto pt-10 leading-relaxed text-emerald-50/90">{tok.coreBody}</p>
        </div>

        <div
          class="rounded-3xl border border-stone-200 p-8 sm:p-10 lg:col-span-7"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
              >{tok.optionalLabel}</span
            >
            <span class="text-sm text-stone-500">{tok.optionalNote}</span>
          </div>
          <ol class="mt-6 grid gap-x-10 sm:grid-cols-2">
            {
              tok.optionalThemes.map((theme, i) => (
                <li class="flex items-baseline gap-4 border-t border-stone-200 py-3.5">
                  <span class="text-xs font-semibold text-stone-400 tabular-nums">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="font-medium text-stone-900">{theme}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div
          class="rounded-3xl border border-stone-200 p-8 sm:p-10 lg:col-span-7"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
              >{tok.aokLabel}</span
            >
            <span class="text-sm text-stone-500">{tok.aokNote}</span>
          </div>
          <ul class="mt-6 flex flex-wrap gap-2.5">
            {
              tok.aoks.map((aok) => (
                <li class="rounded-full bg-stone-100 px-4 py-2 text-sm font-medium text-stone-800">
                  {aok}
                </li>
              ))
            }
          </ul>
        </div>

        <dl
          class="grid grid-cols-2 gap-6 rounded-3xl bg-stone-100 p-8 sm:p-10 lg:col-span-5"
          data-reveal
          style="--reveal-delay: 160ms"
        >
          <div>
            <dd
              class="text-5xl font-extrabold tracking-tighter text-stone-900 tabular-nums sm:text-6xl"
            >
              {tok.hoursValue}
            </dd>
            <dt class="mt-2 text-sm leading-snug text-stone-500">{tok.hoursLabel}</dt>
          </div>
          <div>
            <dd
              class="text-5xl font-extrabold tracking-tighter text-stone-900 tabular-nums sm:text-6xl"
            >
              {tok.pointsValue}
            </dd>
            <dt class="mt-2 text-sm leading-snug text-stone-500">{tok.pointsLabel}</dt>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Assessment: column widths carry the weighting (one third exhibition, two thirds essay) -->
  <section class="border-t border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-12">
      <div class="max-w-2xl" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{tok.assessLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          {tok.assessTitle}
        </h2>
      </div>
      <div
        class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-stone-200 bg-stone-200 lg:grid-cols-3"
      >
        <div class="bg-white p-8 sm:p-10 lg:col-span-1" data-reveal>
          <p
            class="text-5xl font-extrabold tracking-tighter text-emerald-700 tabular-nums sm:text-6xl"
          >
            1<span class="mx-0.5 font-light text-emerald-300">/</span>3
          </p>
          <p class="mt-1 text-xs font-semibold tracking-widest uppercase text-stone-400">
            {tok.exhibitionShare}
          </p>
          <h3 class="mt-8 text-2xl font-bold tracking-tight">{tok.exhibitionTitle}</h3>
          <p class="mt-3 leading-relaxed text-stone-600">{tok.exhibitionBody}</p>
        </div>
        <div class="bg-white p-8 sm:p-10 lg:col-span-2" data-reveal style="--reveal-delay: 100ms">
          <p
            class="text-5xl font-extrabold tracking-tighter text-emerald-700 tabular-nums sm:text-6xl"
          >
            2<span class="mx-0.5 font-light text-emerald-300">/</span>3
          </p>
          <p class="mt-1 text-xs font-semibold tracking-widest uppercase text-stone-400">
            {tok.essayShare}
          </p>
          <h3 class="mt-8 text-2xl font-bold tracking-tight">{tok.essayTitle}</h3>
          <p class="mt-3 max-w-xl leading-relaxed text-stone-600">{tok.essayBody}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Essays and materials written for the course -->
  <section class="border-t border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-12">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">{tok.heading}</h2>
        <p class="mt-4 leading-relaxed text-stone-600">{tok.essaysIntro}</p>
      </div>

      {
        allEssays.length === 0 ? (
          <div class="mt-12">
            <EmptyState message={tok.noMaterials} />
          </div>
        ) : (
          <ol class:list={['mt-12 grid gap-5', essayCols]}>
            {allEssays.map((e, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                <a
                  href={`/${locale}/tok/${e.slug}`}
                  class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-stone-50 p-8 transition-[transform,border-color,background-color] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:border-emerald-300 hover:bg-white sm:p-10"
                >
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
                    <span class="rounded-full bg-emerald-100 px-2.5 py-1 font-semibold text-emerald-800">
                      {e.entry.theme}
                    </span>
                    {e.entry.date && <time class="text-stone-400">{fmtDate(e.entry.date)}</time>}
                  </div>
                  <h3 class="mt-6 text-2xl font-semibold italic leading-[1.15] tracking-tight text-stone-900 transition-colors group-hover:text-emerald-800 sm:text-3xl">
                    “{pick(locale, e.entry.sk.title, e.entry.title)}”
                  </h3>
                  <p class="mt-4 max-w-[60ch] leading-relaxed text-stone-600">
                    {pick(locale, e.entry.sk.description, e.entry.description)}
                  </p>
                  <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-emerald-700">
                    {tok.readEssay}
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <!-- TOK Handbook: dark closing band -->
  <section class="bg-stone-900 text-white">
    <div
      class="mx-auto grid max-w-7xl items-start gap-10 px-6 py-20 sm:py-24 lg:grid-cols-12 lg:gap-12 lg:px-12"
    >
      <div class="lg:col-span-5" data-reveal>
        <span
          class="inline-flex items-center gap-3 text-xs font-semibold tracking-widest uppercase text-emerald-300"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>{tok.handbookLabel}
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{tok.handbookTitle}</h2>
        <p class="mt-4 max-w-[60ch] leading-relaxed text-stone-300">{tok.handbookIntro}</p>
        <a
          href={l('/policies', locale)}
          class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 transition-colors hover:text-white"
        >
          {tok.handbookMore}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay: 100ms">
        <DocumentList
          items={guideDocuments.filter((doc) => doc.file === 'tok-handbook.pdf')}
          locale={locale}
          tone="dp"
        />
      </div>
    </div>
  </section>
</Layout>
