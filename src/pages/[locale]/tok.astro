---
import { reader, pick } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allEssays = await reader.collections.tok.all();
---

<Layout title={dict.tok.title} description="Theory of Knowledge materials and essays" locale={locale}>
  <PageHeader title={dict.tok.title} subtitle={dict.tok.subtitle} label="IB Core" />

  <div class="mx-auto max-w-5xl px-4 py-12">
    <section data-reveal>
      <h2 class="text-xl font-semibold mb-4 text-emerald-800 flex items-center gap-3">
        <span class="inline-block h-6 w-1 rounded-full bg-emerald-600" />
        {dict.tok.heading}
      </h2>
      {allEssays.length === 0 ? (
        <p class="text-sm text-stone-400">{dict.tok.noMaterials}</p>
      ) : (
        <div class="grid gap-3 sm:grid-cols-2">
          {allEssays
            .sort((a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime())
            .map((e) => (
              <a
                href={`/${locale}/tok/${e.slug}`}
                class="block rounded-2xl border border-stone-200 bg-white p-5 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <div class="flex items-center justify-between gap-3 mb-1">
                  <h3 class="font-semibold">{pick(locale, e.entry.sk.title, e.entry.title)}</h3>
                  <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full shrink-0">{e.entry.theme}</span>
                </div>
                <time class="text-xs text-stone-400">
                  {e.entry.date && new Date(e.entry.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB')}
                </time>
                <p class="text-sm text-stone-600 mt-1">{pick(locale, e.entry.sk.description, e.entry.description)}</p>
              </a>
            ))}
        </div>
      )}
    </section>
  </div>
</Layout>
