---
import { reader, pick } from '../../../lib/keystatic';
import { renderMarkdoc, hasContent } from '../../../lib/markdoc';
import Layout from '../../../layouts/Layout.astro';
import { t, l } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export async function getStaticPaths() {
  const slugs = await reader.collections.tok.list();
  return (['en', 'sk'] as const).flatMap((locale) =>
    slugs.map((slug) => ({ params: { locale, slug } })),
  );
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const slug = Astro.params.slug!;
const dict = t(locale);

const material = await reader.collections.tok.read(slug);
if (!material) return Astro.redirect(l('/tok', locale));

const title = pick(locale, material.sk.title, material.title);
const description = pick(locale, material.sk.description, material.description);

const enHtml = await renderMarkdoc(material.content);
const skHtml = await renderMarkdoc(material.sk.body);
const bodyHtml = locale === 'sk' && hasContent(skHtml) ? skHtml : enHtml;

const dateLabel = material.date
  ? new Date(material.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const others = (await reader.collections.tok.all())
  .filter((e) => e.slug !== slug)
  .sort((a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime())
  .slice(0, 4);
---

<Layout
  title={title}
  description={description}
  locale={locale}
  ogType="article"
  publishedTime={material.date}
  pageSchemaType="Article"
  pageSchema={{
    headline: title,
    datePublished: material.date,
    about: material.theme,
    author: { '@id': new URL('/#school', Astro.site).href },
    publisher: { '@id': new URL('/#school', Astro.site).href },
  }}
>
  <!-- Masthead: wide shell, oversized quoted title -->
  <header class="relative overflow-hidden border-b border-stone-200 bg-stone-900 text-white">
    <span
      class="absolute -top-16 right-0 text-[18rem] font-extrabold leading-none text-white/[0.04] select-none sm:text-[26rem]"
      aria-hidden="true">?</span
    >
    <div class="relative mx-auto max-w-7xl px-6 pt-10 pb-14 sm:pt-14 sm:pb-20 lg:px-12">
      <a
        href={l('/tok', locale)}
        class="hero-rise inline-flex items-center gap-1.5 text-sm font-medium text-emerald-300 transition-colors hover:text-white"
      >
        <span aria-hidden="true">&larr;</span>
        {dict.detail.backTok}
      </a>
      <div
        class="hero-rise mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold uppercase tracking-widest"
        style="--rise-delay: 60ms"
      >
        <span class="rounded-full bg-emerald-400/15 px-2.5 py-1 text-emerald-200">
          {material.theme}
        </span>
        {dateLabel && <time class="text-stone-400">{dateLabel}</time>}
      </div>
      <h1
        class="hero-rise mt-5 max-w-5xl text-4xl font-semibold italic leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
        style="--rise-delay: 120ms"
      >
        “{title}”
      </h1>
      {
        description && (
          <p
            class="hero-rise mt-6 max-w-2xl text-lg leading-relaxed text-stone-300 sm:text-xl"
            style="--rise-delay: 200ms"
          >
            {description}
          </p>
        )
      }
    </div>
  </header>

  <!-- Body: sticky meta rail on the left, essay on the right -->
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-14 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:px-12">
    <aside class="lg:col-span-3 lg:self-start lg:sticky lg:top-28" data-reveal>
      <dl class="border-t border-stone-300">
        <div
          class="grid grid-cols-[6rem_1fr] gap-4 border-b border-stone-300 py-4 lg:grid-cols-1 lg:gap-1"
        >
          <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">
            {dict.detail.theme}
          </dt>
          <dd class="font-medium text-stone-900">{material.theme}</dd>
        </div>
        {
          dateLabel && (
            <div class="grid grid-cols-[6rem_1fr] gap-4 border-b border-stone-300 py-4 lg:grid-cols-1 lg:gap-1">
              <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">
                {dict.news.published}
              </dt>
              <dd class="font-medium text-stone-900">{dateLabel}</dd>
            </div>
          )
        }
      </dl>
    </aside>

    <article
      class="rich-text max-w-[70ch] text-lg lg:col-span-8 lg:col-start-5"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      {
        hasContent(bodyHtml) ? (
          <Fragment set:html={bodyHtml} />
        ) : (
          <p class="text-stone-400">{dict.detail.comingSoon}</p>
        )
      }
    </article>
  </div>

  {
    others.length > 0 && (
      <section class="border-t border-stone-200 bg-stone-50">
        <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{dict.tok.heading}</h2>
            <a
              href={l('/tok', locale)}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 transition-colors hover:text-emerald-800"
            >
              {dict.detail.backTok}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class:list={['mt-8 grid gap-5', others.length > 1 && 'sm:grid-cols-2']}>
            {others.map((e, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms`}>
                <a
                  href={`/${locale}/tok/${e.slug}`}
                  class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-7 transition-[transform,border-color] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:border-emerald-300"
                >
                  <span class="self-start rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800">
                    {e.entry.theme}
                  </span>
                  <span class="mt-4 text-xl font-semibold italic leading-snug tracking-tight text-stone-900 transition-colors group-hover:text-emerald-800">
                    “{pick(locale, e.entry.sk.title, e.entry.title)}”
                  </span>
                  <span class="mt-3 line-clamp-2 text-sm leading-relaxed text-stone-600">
                    {pick(locale, e.entry.sk.description, e.entry.description)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
