---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DocumentList from '../../components/DocumentList.astro';
import { school } from '../../assets/school';
import { t, l, contact } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { admissionsDocuments, dpFees } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const admissions = dict.admissions;

const steps = [
  { number: '01', title: admissions.step1Title, body: admissions.step1Body },
  { number: '02', title: admissions.step2Title, body: admissions.step2Body },
  { number: '03', title: admissions.step3Title, body: admissions.step3Body },
];
---

<Layout
  title={admissions.title}
  description={admissions.subtitle}
  locale={locale}
  pageSchemaType="FAQPage"
  pageSchema={{
    mainEntity: admissions.faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  }}
>
  <PageHeader title={admissions.title} subtitle={admissions.subtitle} label={admissions.label} />

  <div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <section class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16 items-start">
      <div data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{admissions.label}</span
        >
        <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight">{admissions.introTitle}</h2>
        <p class="mt-5 max-w-xl text-stone-600 leading-relaxed">
          {admissions.introBody}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`mailto:${contact.email}`}
            data-umami-event="mail-click"
            class="rounded-full bg-emerald-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-800"
          >
            {admissions.emailButton}
          </a>
          <a
            href={`tel:${contact.phone.replace(/\s/g, '')}`}
            data-umami-event="tel-click"
            class="rounded-full border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-700 transition-colors hover:border-emerald-500 hover:text-emerald-700"
          >
            {admissions.callButton}
          </a>
        </div>
      </div>

      <div class="relative" data-reveal style="--reveal-delay: 100ms">
        <Image
          src={school.entranceBanner}
          alt="Entrance to Súkromné Gymnázium Česká"
          class="h-72 sm:h-96 w-full rounded-3xl object-cover shadow-lg"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 52vw, 100vw"
          loading="lazy"
        />
        <div
          class="absolute -bottom-5 left-5 right-5 rounded-2xl bg-stone-900 px-5 py-4 text-sm text-stone-200 shadow-xl sm:left-auto sm:max-w-xs"
        >
          <p class="font-semibold text-white">{contact.address}</p>
          <p class="mt-1 text-stone-400">{contact.email}</p>
        </div>
      </div>
    </section>

    <section class="mt-28">
      <div data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{admissions.programmesLabel}</span
        >
        <h2 class="mt-2 text-3xl font-bold tracking-tight">{admissions.programmesTitle}</h2>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <a
          href={l('/myp', locale)}
          class="block rounded-3xl bg-myp-50 p-7 sm:p-9 transition-transform hover:-translate-y-1"
          data-reveal
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-myp-700">MYP</p>
          <h3 class="mt-3 text-2xl font-semibold">{admissions.mypTitle}</h3>
          <p class="mt-2 text-sm font-semibold text-myp-800">
            {admissions.mypAges}
          </p>
          <p class="mt-5 text-stone-600 leading-relaxed">
            {admissions.mypBody}
          </p>
        </a>
        <a
          href={l('/dp', locale)}
          class="block rounded-3xl bg-emerald-800 p-7 text-white transition-transform hover:-translate-y-1 sm:p-9"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-200">DP</p>
          <h3 class="mt-3 text-2xl font-semibold">{admissions.dpTitle}</h3>
          <p class="mt-2 text-sm font-semibold text-emerald-200">{admissions.dpAges}</p>
          <p class="mt-5 text-emerald-50/80 leading-relaxed">{admissions.dpBody}</p>
        </a>
      </div>
    </section>

    <section class="mt-28 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{admissions.stepsLabel}</span
        >
        <h2 class="mt-2 text-3xl font-bold tracking-tight">{admissions.stepsTitle}</h2>
      </div>
      <ol class="border-t border-stone-300">
        {
          steps.map((step, i) => (
            <li
              class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-stone-300 py-7"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="text-xs font-semibold text-emerald-700 pt-1">{step.number}</span>
              <div>
                <h3 class="text-lg font-semibold">{step.title}</h3>
                <p class="mt-2 text-sm text-stone-600 leading-relaxed">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="mt-28 grid gap-6 rounded-3xl bg-stone-900 p-7 text-white sm:p-10 lg:grid-cols-2 lg:gap-14"
      data-reveal
    >
      <div>
        <h2 class="text-2xl font-semibold">{admissions.prepareTitle}</h2>
        <ul class="mt-6 space-y-3 text-sm text-stone-300">
          {
            admissions.prepareItems.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="border-t border-stone-700 pt-6 lg:border-l lg:border-t-0 lg:pl-14 lg:pt-0">
        <h2 class="text-2xl font-semibold">{admissions.directTitle}</h2>
        <p class="mt-4 text-stone-300 leading-relaxed">{admissions.directBody}</p>
        <div class="mt-6 space-y-2 text-sm">
          <p>
            <a
              class="font-semibold text-emerald-300 hover:text-emerald-200"
              href={`mailto:${contact.email}`}
              data-umami-event="mail-click">{contact.email}</a
            >
          </p>
          <p>
            <a
              class="font-semibold text-emerald-300 hover:text-emerald-200"
              href={`tel:${contact.phone.replace(/\s/g, '')}`}
              data-umami-event="tel-click">{contact.phone}</a
            >
          </p>
          <p>
            <a
              class="font-semibold text-emerald-300 hover:text-emerald-200"
              href="https://www.gymnaziumceska.sk"
              target="_blank"
              rel="noopener"
            >
              {admissions.schoolWebsite} ↗
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="mt-28 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal>
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700"
          >{admissions.faqLabel}</span
        >
        <h2 class="mt-2 text-3xl font-bold tracking-tight">{admissions.faqTitle}</h2>
      </div>
      <div class="border-t border-stone-200">
        {
          admissions.faqItems.map((item, i) => (
            <details
              class="group border-b border-stone-200"
              data-reveal
              style={`--reveal-delay: ${Math.min(i, 4) * 60}ms`}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-semibold text-stone-900 transition-colors hover:text-emerald-700 [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-stone-400 transition-transform duration-200 group-open:rotate-45 group-hover:text-emerald-600"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </summary>
              <p class="pb-5 -mt-1 text-stone-600 leading-relaxed">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- School fees (HTML table, reconstructed from the school's fee schedule) -->
    <section class="mt-28" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">
            {admissions.feesLabel}
          </span>
          <h2 class="mt-2 text-3xl font-bold tracking-tight">{admissions.feesTitle}</h2>
          <p class="mt-5 max-w-md text-stone-600 leading-relaxed">{admissions.feesIntro}</p>
        </div>
        <div class="overflow-x-auto rounded-3xl border border-stone-200">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-stone-50 text-left">
                <th class="px-5 py-4 font-semibold text-stone-900">{admissions.feesItem}</th>
                <th class="px-5 py-4 text-right font-semibold text-stone-900"
                  >{admissions.feesDp1}</th
                >
                <th class="px-5 py-4 text-right font-semibold text-stone-900"
                  >{admissions.feesDp2}</th
                >
              </tr>
            </thead>
            <tbody>
              {
                dpFees.map((row) => (
                  <tr class="border-t border-stone-200 align-top">
                    <td class="px-5 py-4">
                      <p class="font-medium text-stone-900">{row.item[locale]}</p>
                      {row.detail && (
                        <p class="mt-1 text-xs leading-relaxed text-stone-500">
                          {row.detail[locale]}
                        </p>
                      )}
                    </td>
                    <td class="px-5 py-4 text-right font-semibold text-stone-900 whitespace-nowrap">
                      {row.dp1}
                    </td>
                    <td class="px-5 py-4 text-right font-semibold text-stone-900 whitespace-nowrap">
                      {row.dp2}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-xs leading-relaxed text-stone-500">{admissions.feesNote}</p>
    </section>

    <!-- Admissions documents & forms -->
    <section class="mt-28" data-reveal>
      <div class="max-w-2xl">
        <span class="text-xs font-semibold tracking-widest uppercase text-emerald-700">
          {admissions.documentsLabel}
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">{admissions.documentsTitle}</h2>
        <p class="mt-5 text-stone-600 leading-relaxed">{admissions.documentsIntro}</p>
      </div>
      {
        admissionsDocuments.map((group) => (
          <div class="mt-10">
            <h3 class="text-sm font-bold uppercase tracking-widest text-stone-500">
              {group.group === 'dp' ? admissions.documentsDpLabel : admissions.documentsMypLabel}
            </h3>
            <div class="mt-4">
              <DocumentList items={group.items} locale={locale} tone="dp" />
            </div>
          </div>
        ))
      }
    </section>
  </div>
</Layout>
