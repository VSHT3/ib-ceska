---
import ProgrammeOverview from '../../components/ProgrammeOverview.astro';
import { school } from '../../assets/school';
import { t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dp = t(locale).dp;
---

<ProgrammeOverview
  locale={locale}
  programme={dp}
  tone="dp"
  image={school.projectPresentation}
  imageAlt="Students presenting project work at Česká"
  logo="/ib-dp-logo.png"
  promo={{
    title: dp.builderTitle,
    body: dp.builderBody,
    cta: dp.builderCta,
    href: '/build-your-diploma',
  }}
/>
