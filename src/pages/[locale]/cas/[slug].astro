---
import { reader, pick } from '../../../lib/keystatic';
import { renderMarkdoc, hasContent } from '../../../lib/markdoc';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { t, l } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export async function getStaticPaths() {
  const slugs = await reader.collections.cas.list();
  return (['en', 'sk'] as const).flatMap((locale) =>
    slugs.map((slug) => ({ params: { locale, slug } }))
  );
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const slug = Astro.params.slug!;
const dict = t(locale);

const activity = await reader.collections.cas.read(slug);
if (!activity) return Astro.redirect(l('/cas', locale));

const strandStyles: Record<string, string> = {
  Creativity: 'bg-amber-100 text-amber-800',
  Activity: 'bg-sky-100 text-sky-800',
  Service: 'bg-emerald-100 text-emerald-800',
};

const title = pick(locale, activity.sk.title, activity.title);
const description = pick(locale, activity.sk.description, activity.description);

const enHtml = await renderMarkdoc(activity.content);
const skHtml = await renderMarkdoc(activity.sk.body);
const bodyHtml = locale === 'sk' && hasContent(skHtml) ? skHtml : enHtml;
---

<Layout title={title} description={description} locale={locale}>
  <PageHeader title={title} subtitle={description} label={`CAS: ${activity.strand}`} />

  <div class="mx-auto max-w-5xl px-4 py-12">
    <a
      href={l('/cas', locale)}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 hover:text-emerald-800 transition-colors"
    >
      <span aria-hidden="true">&larr;</span> {dict.detail.backCas}
    </a>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_280px]">
      <article class="rich-text min-w-0" data-reveal>
        {hasContent(bodyHtml) ? (
          <Fragment set:html={bodyHtml} />
        ) : (
          <p class="text-stone-400">{dict.detail.comingSoon}</p>
        )}
      </article>

      <aside class="lg:order-last order-first" data-reveal>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 space-y-4 lg:sticky lg:top-24">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">{dict.detail.strand}</p>
            <span class:list={['inline-block mt-1 text-xs px-2.5 py-1 rounded-full font-semibold', strandStyles[activity.strand] ?? 'bg-stone-100 text-stone-700']}>
              {activity.strand}
            </span>
          </div>
          {activity.date && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Date</p>
              <time class="text-sm font-medium text-stone-800 mt-1 block">
                {new Date(activity.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </div>
          )}
          {activity.learningOutcomes.length > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">{dict.detail.learningOutcomes}</p>
              <ul class="space-y-1.5">
                {activity.learningOutcomes.map((lo) => (
                  <li class="text-sm text-stone-700 flex gap-2">
                    <span class="text-emerald-600 mt-0.5" aria-hidden="true">✓</span>
                    {lo}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>
