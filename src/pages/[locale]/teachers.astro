---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { teachers } from '../../data/teachers';
import { reader, pick } from '../../lib/keystatic';
import { t, l, contact } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import type { Teacher } from '../../data/teachers';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const copy = dict.teachers;

// Map each teacher name → the subject pages they teach (matched on the
// subject's `teacher` field). Used to make teacher cards link to their subject.
const allSubjects = await reader.collections.subjects.all();
const subjectsByTeacher = new Map<string, { slug: string; title: string }[]>();
for (const s of allSubjects) {
  const name = s.entry.teacher?.trim();
  if (!name) continue;
  const title = pick(locale, s.entry.sk.title, s.entry.title);
  const list = subjectsByTeacher.get(name) ?? [];
  list.push({ slug: s.slug, title });
  subjectsByTeacher.set(name, list);
}
const subjectsOf = (teacher: Teacher) => subjectsByTeacher.get(teacher.name.trim()) ?? [];

// Only show teachers who have a photo (others stay in the data for subject pages).
const withPhoto = teachers.filter((teacher) => teacher.image);
const leadership = withPhoto.filter((teacher) => teacher.leadership);
const faculty = withPhoto.filter((teacher) => !teacher.leadership);

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);

const roleOf = (teacher: Teacher) => [
  ...teacher.areas[locale],
  ...teacher.responsibilities[locale],
];

const peopleSchemas = withPhoto.map((teacher) => ({
  '@type': 'Person',
  name: teacher.name,
  jobTitle: roleOf(teacher),
  worksFor: { '@id': new URL('/#school', Astro.site).href },
  ...(teacher.image ? { image: new URL(teacher.image.src, Astro.site).href } : {}),
}));
---

<Layout
  title={copy.title}
  description={copy.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
  structuredData={peopleSchemas}
>
  <PageHeader title={copy.title} subtitle={copy.subtitle} label={copy.label} />

  <!-- Leadership (asymmetric sticky split, editorial feature rows) -->
  <section class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-[0.52fr_1.48fr] lg:gap-16 items-start">
      <div class="lg:sticky lg:top-24 self-start" data-reveal>
        <p
          class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-emerald-700"
        >
          <span class="h-px w-10 bg-current" aria-hidden="true"></span>
          {copy.leadershipLabel}
        </p>
        <h2 class="mt-3 max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">
          {copy.leadershipTitle}
        </h2>
      </div>

      <ul class="border-t border-stone-200 divide-y divide-stone-200">
        {
          leadership.map((teacher, index) => (
            <li
              class="grid gap-6 py-10 sm:grid-cols-[minmax(0,220px)_1fr] sm:gap-x-10 sm:gap-y-3 lg:grid-cols-[minmax(0,220px)_1fr_1fr] first:pt-0 lg:first:pt-2"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <div class="group aspect-[4/5] max-w-[260px] overflow-hidden rounded-2xl bg-stone-100 sm:row-span-2 lg:row-span-1">
                {teacher.image ? (
                  <Image
                    src={teacher.image}
                    alt={teacher.name}
                    class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                    widths={[320, 480, 640]}
                    sizes="(min-width: 640px) 220px, 100vw"
                    loading={index < 2 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <div class="flex h-full items-center justify-center bg-emerald-100 text-5xl font-bold text-emerald-700">
                    {initials(teacher.name)}
                  </div>
                )}
              </div>
              <div>
                <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{teacher.name}</h3>
              </div>
              <ul class="space-y-1.5 sm:col-start-2 lg:col-start-3 lg:row-start-1 lg:border-l lg:border-stone-200 lg:pl-8">
                {roleOf(teacher).map((role) => (
                  <li class="text-sm leading-relaxed text-stone-600">{role}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Faculty (full-bleed neutral band, hairline portrait grid) -->
  <section class="bg-stone-100 border-y border-stone-200/70">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-28">
      <div data-reveal>
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700">
          {copy.facultyLabel}
        </p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
          {copy.facultyTitle}
        </h2>
      </div>

      <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          faculty.map((teacher, index) => {
            const subs = subjectsOf(teacher);
            const single = subs.length === 1 ? subs[0] : null;
            const CardTag = single ? 'a' : 'article';
            return (
              <li data-reveal style={`--reveal-delay: ${Math.min(index, 5) * 60}ms`}>
                <CardTag
                  href={single ? l(`/subjects/${single.slug}`, locale) : undefined}
                  class="group flex h-full flex-col"
                >
                  <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-stone-200">
                    {teacher.image ? (
                      <Image
                        src={teacher.image}
                        alt={teacher.name}
                        class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-emerald-100 text-5xl font-bold text-emerald-700">
                        {initials(teacher.name)}
                      </div>
                    )}
                  </div>
                  <div class="mt-4 flex flex-1 flex-col border-t border-stone-300 pt-4">
                    <h3 class="text-lg font-bold tracking-tight transition-colors group-hover:text-emerald-700">
                      {teacher.name}
                    </h3>
                    {subs.length > 1 ? (
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {subs.map((s) => (
                          <a
                            href={l(`/subjects/${s.slug}`, locale)}
                            class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-stone-200 transition-colors hover:bg-emerald-50 hover:text-emerald-900"
                          >
                            {s.title}
                          </a>
                        ))}
                      </div>
                    ) : (
                      teacher.areas[locale].length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {teacher.areas[locale].map((area) => (
                            <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-stone-200">
                              {area}
                            </span>
                          ))}
                        </div>
                      )
                    )}
                    {teacher.responsibilities[locale].length > 0 && (
                      <ul class="mt-3 space-y-1.5">
                        {teacher.responsibilities[locale].map((role) => (
                          <li class="text-sm leading-snug text-stone-500">{role}</li>
                        ))}
                      </ul>
                    )}
                    {single && (
                      <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-emerald-700">
                        {copy.viewSubject}
                        <span
                          class="transition-transform group-hover:translate-x-1"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </span>
                    )}
                  </div>
                </CardTag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Contact (true full-bleed dark band) -->
  <section class="bg-stone-900 text-white">
    <div
      class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-24 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between"
      data-reveal
    >
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">
          {copy.contactLabel}
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{copy.contactTitle}</h2>
        <p class="mt-4 text-sm leading-relaxed text-stone-300">{copy.contactBody}</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a
          href={l('/admissions', locale)}
          class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-500"
        >
          {copy.admissionsLink}
        </a>
        <a
          href={`mailto:${contact.email}`}
          data-umami-event="mail-click"
          class="rounded-full border border-stone-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-emerald-400 hover:text-emerald-300"
        >
          {copy.emailLink}
        </a>
      </div>
    </div>
  </section>
</Layout>
