---
import { reader, pick } from '../../../lib/keystatic';
import { renderMarkdoc, hasContent } from '../../../lib/markdoc';
import Layout from '../../../layouts/Layout.astro';
import { t, l } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export async function getStaticPaths() {
  const slugs = await reader.collections.news.list();
  return (['en', 'sk'] as const).flatMap((locale) =>
    slugs.map((slug) => ({ params: { locale, slug } })),
  );
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const slug = Astro.params.slug!;
const dict = t(locale);

const article = await reader.collections.news.read(slug);
if (!article) return Astro.redirect(l('/news', locale));

const title = pick(locale, article.sk.title, article.title);
const excerpt = pick(locale, article.sk.excerpt, article.excerpt);

const enHtml = await renderMarkdoc(article.content);
const skHtml = await renderMarkdoc(article.sk.body);
const bodyHtml = locale === 'sk' && hasContent(skHtml) ? skHtml : enHtml;

const dateLabel = article.date
  ? new Date(article.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<Layout
  title={title}
  description={excerpt}
  locale={locale}
  ogType="article"
  publishedTime={article.date}
  author={article.author}
  pageSchemaType="NewsArticle"
  pageSchema={{
    headline: title,
    datePublished: article.date,
    author: article.author
      ? { '@type': 'Person', name: article.author }
      : { '@id': new URL('/#school', Astro.site).href },
    publisher: { '@id': new URL('/#school', Astro.site).href },
  }}
>
  <!-- Article masthead -->
  <header class="border-b border-stone-200/80 bg-white">
    <div class="mx-auto max-w-4xl px-4 pt-10 pb-10 sm:px-6 sm:pt-14">
      <a
        href={l('/news', locale)}
        class="hero-rise inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 transition-colors hover:text-emerald-800"
      >
        <span aria-hidden="true">&larr;</span>
        {dict.detail.backNews}
      </a>

      <div
        class="hero-rise mt-9 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold uppercase tracking-[0.2em]"
        style="--rise-delay: 60ms"
      >
        <span class="rounded bg-stone-100 px-2 py-0.5 text-stone-500">
          {dict.news.articleBadge}
        </span>
        {dateLabel && <time class="text-stone-400">{dateLabel}</time>}
      </div>
      <h1
        class="hero-rise mt-5 text-4xl font-bold tracking-tighter leading-[1.02] sm:text-5xl lg:text-6xl"
        style="--rise-delay: 120ms"
      >
        {title}
      </h1>
      {
        excerpt && (
          <p
            class="hero-rise mt-6 max-w-3xl text-xl leading-relaxed text-stone-600"
            style="--rise-delay: 200ms"
          >
            {excerpt}
          </p>
        )
      }
      {
        article.author && (
          <p class="hero-rise mt-7 text-sm font-medium text-stone-400" style="--rise-delay: 260ms">
            {article.author} · {dict.site.title}
          </p>
        )
      }
      <div class="hero-rise mt-9" style="--rise-delay: 300ms" aria-hidden="true">
        <div class="border-t-4 border-stone-900"></div>
        <div class="mt-[3px] border-t border-stone-900"></div>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
    <article
      class:list={['rich-text article-body', hasContent(bodyHtml) && 'has-dropcap']}
      data-reveal
    >
      {
        hasContent(bodyHtml) ? (
          <Fragment set:html={bodyHtml} />
        ) : (
          <p class="text-stone-400">{dict.detail.comingSoon}</p>
        )
      }
    </article>

    <footer
      class="mt-12 flex flex-wrap items-baseline justify-between gap-4 border-t border-stone-200 pt-6"
      data-reveal
    >
      {article.author && <p class="text-sm text-stone-400">{article.author}</p>}
      <a
        href={l('/news', locale)}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 transition-colors hover:text-emerald-800"
      >
        <span aria-hidden="true">&larr;</span>
        {dict.detail.backNews}
      </a>
    </footer>
  </div>

  <style>
    /* Print-style drop cap on the opening paragraph */
    .article-body.has-dropcap :global(article > p:first-of-type)::first-letter {
      float: left;
      margin: 0.08em 0.14em 0 0;
      font-size: 3.3em;
      line-height: 0.78;
      font-weight: 800;
      color: var(--color-stone-900);
    }
  </style>
</Layout>
