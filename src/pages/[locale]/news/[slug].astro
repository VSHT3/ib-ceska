---
import { reader, pick } from '../../../lib/keystatic';
import { renderMarkdoc, hasContent } from '../../../lib/markdoc';
import Layout from '../../../layouts/Layout.astro';
import { t, l } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export async function getStaticPaths() {
  const slugs = await reader.collections.news.list();
  return (['en', 'sk'] as const).flatMap((locale) =>
    slugs.map((slug) => ({ params: { locale, slug } })),
  );
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const slug = Astro.params.slug!;
const dict = t(locale);
const loc = locale === 'sk' ? 'sk-SK' : 'en-GB';

const article = await reader.collections.news.read(slug);
if (!article) return Astro.redirect(l('/news', locale));

const title = pick(locale, article.sk.title, article.title);
const excerpt = pick(locale, article.sk.excerpt, article.excerpt);

const enHtml = await renderMarkdoc(article.content);
const skHtml = await renderMarkdoc(article.sk.body);
const bodyHtml = locale === 'sk' && hasContent(skHtml) ? skHtml : enHtml;

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(loc, { year: 'numeric', month: 'long', day: 'numeric' })
    : null;
const dateLabel = fmtDate(article.date);

const more = (await reader.collections.news.all())
  .filter((n) => n.slug !== slug)
  .sort((a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime())
  .slice(0, 3);
---

<Layout
  title={title}
  description={excerpt}
  locale={locale}
  ogType="article"
  publishedTime={article.date}
  author={article.author}
  pageSchemaType="NewsArticle"
  pageSchema={{
    headline: title,
    datePublished: article.date,
    author: article.author
      ? { '@type': 'Person', name: article.author }
      : { '@id': new URL('/#school', Astro.site).href },
    publisher: { '@id': new URL('/#school', Astro.site).href },
  }}
>
  <!-- Masthead: wide shell, oversized headline, double rule -->
  <header class="bg-white">
    <div class="mx-auto max-w-7xl px-6 pt-10 pb-10 sm:pt-14 lg:px-12">
      <a
        href={l('/news', locale)}
        class="hero-rise inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 transition-colors hover:text-emerald-800"
      >
        <span aria-hidden="true">&larr;</span>
        {dict.detail.backNews}
      </a>

      <div
        class="hero-rise mt-9 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold uppercase tracking-[0.2em]"
        style="--rise-delay: 60ms"
      >
        <span class="rounded bg-stone-100 px-2 py-0.5 text-stone-500">{dict.news.articleBadge}</span
        >
        {dateLabel && <time class="text-stone-400">{dateLabel}</time>}
      </div>
      <h1
        class="hero-rise mt-5 max-w-5xl text-4xl font-bold tracking-tighter leading-[0.98] text-balance sm:text-5xl lg:text-6xl xl:text-7xl"
        style="--rise-delay: 120ms"
      >
        {title}
      </h1>
      {
        excerpt && (
          <p
            class="hero-rise mt-7 max-w-3xl text-xl leading-relaxed text-stone-600 sm:text-2xl"
            style="--rise-delay: 200ms"
          >
            {excerpt}
          </p>
        )
      }
      <div
        class="hero-rise mt-10 border-t border-stone-900"
        style="--rise-delay: 280ms"
        aria-hidden="true"
      >
      </div>
    </div>
  </header>

  <!-- Body: sticky byline rail on the left, article on the right -->
  <div
    class="mx-auto grid max-w-7xl gap-10 px-6 pt-4 pb-16 sm:pb-20 lg:grid-cols-12 lg:gap-16 lg:px-12"
  >
    <aside class="lg:col-span-3 lg:self-start lg:sticky lg:top-28" data-reveal>
      <dl class="grid grid-cols-2 gap-x-6 lg:grid-cols-1">
        {
          dateLabel && (
            <div class="border-b border-stone-200 py-4">
              <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">
                {dict.news.published}
              </dt>
              <dd class="mt-1 font-medium text-stone-900">{dateLabel}</dd>
            </div>
          )
        }
        {
          article.author && (
            <div class="border-b border-stone-200 py-4">
              <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">
                {dict.news.author}
              </dt>
              <dd class="mt-1 font-medium text-stone-900">{article.author}</dd>
            </div>
          )
        }
      </dl>
      <p class="mt-4 text-sm text-stone-400">{dict.site.title} · Bratislava</p>
    </aside>

    <article
      class:list={[
        'rich-text article-body max-w-[68ch] text-lg lg:col-span-8 lg:col-start-5',
        hasContent(bodyHtml) && 'has-dropcap',
      ]}
      data-reveal
      style="--reveal-delay: 80ms"
    >
      {
        hasContent(bodyHtml) ? (
          <Fragment set:html={bodyHtml} />
        ) : (
          <p class="text-stone-400">{dict.detail.comingSoon}</p>
        )
      }
    </article>
  </div>

  {
    more.length > 0 && (
      <section class="border-t border-stone-200 bg-stone-50">
        <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{dict.news.moreNews}</h2>
            <a
              href={l('/news', locale)}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 transition-colors hover:text-emerald-800"
            >
              {dict.detail.backNews}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul
            class:list={[
              'mt-8 grid gap-5',
              more.length > 1 && 'sm:grid-cols-2',
              more.length > 2 && 'lg:grid-cols-3',
            ]}
          >
            {more.map((n, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                <a
                  href={`/${locale}/news/${n.slug}`}
                  class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-7 transition-[transform,border-color] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:border-emerald-300"
                >
                  {n.entry.date && (
                    <time class="text-xs font-semibold uppercase tracking-widest text-stone-400">
                      {fmtDate(n.entry.date)}
                    </time>
                  )}
                  <span class="mt-3 text-xl font-semibold leading-snug tracking-tight text-stone-900 transition-colors group-hover:text-emerald-700">
                    {pick(locale, n.entry.sk.title, n.entry.title)}
                  </span>
                  {n.entry.excerpt && (
                    <span class="mt-3 line-clamp-3 text-sm leading-relaxed text-stone-600">
                      {pick(locale, n.entry.sk.excerpt, n.entry.excerpt)}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <style>
    /* Print-style drop cap on the opening paragraph */
    .article-body.has-dropcap :global(article > p:first-of-type)::first-letter {
      float: left;
      margin: 0.08em 0.14em 0 0;
      font-size: 3.3em;
      line-height: 0.78;
      font-weight: 800;
      color: var(--color-stone-900);
    }
  </style>
</Layout>
