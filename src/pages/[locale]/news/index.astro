---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allNews = await reader.collections.news.all();
---

<Layout title={dict.news.title} description="IB programme announcements" locale={locale}>
  <PageHeader title={dict.news.title} subtitle={dict.news.subtitle} />

  <div class="mx-auto max-w-5xl px-4 py-12">
    {allNews.length === 0 ? (
      <p class="text-stone-400">{dict.news.noNews}</p>
    ) : (
      <div class="grid gap-5">
        {allNews
          .sort((a, b) => new Date(b.entry.date ?? 0).getTime() - new Date(a.entry.date ?? 0).getTime())
          .map((n, i) => (
            <a
              href={`/${locale}/news/${n.slug}`}
              class="block rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              data-reveal
              style={`--reveal-delay: ${Math.min(i, 4) * 80}ms`}
            >
              {n.entry.date && (
                <time class="text-xs font-medium text-emerald-700 bg-emerald-50 rounded-full px-2.5 py-1">
                  {new Date(n.entry.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              )}
              <h2 class="text-xl font-semibold mt-3 mb-2">{pick(locale, n.entry.sk.title, n.entry.title)}</h2>
              {n.entry.excerpt && <p class="text-stone-600">{pick(locale, n.entry.sk.excerpt, n.entry.excerpt)}</p>}
              {n.entry.author && <p class="text-xs text-stone-400 mt-3">{n.entry.author}</p>}
            </a>
          ))}
      </div>
    )}
  </div>
</Layout>
