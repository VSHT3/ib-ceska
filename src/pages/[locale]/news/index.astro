---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'sk' } },
  ];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);

const allNews = await reader.collections.news.all();
---

<Layout title={dict.news.title} description="IB programme announcements" locale={locale}>
  <h1 class="text-3xl font-bold mb-8">{dict.news.title}</h1>

  {allNews.length === 0 ? (
    <p class="text-stone-400">{dict.news.noNews}</p>
  ) : (
    <div class="grid gap-6">
      {allNews
        .sort((a, b) => new Date(b.entry.date).getTime() - new Date(a.entry.date).getTime())
        .map((n) => (
          <article class="rounded-xl border border-stone-200 bg-white p-6">
            <time class="text-xs text-stone-400">
              {new Date(n.entry.date).toLocaleDateString(locale === 'sk' ? 'sk-SK' : 'en-GB', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="text-xl font-semibold mt-1 mb-2">{pick(locale, n.entry.sk.title, n.entry.title)}</h2>
            {n.entry.excerpt && <p class="text-stone-600">{pick(locale, n.entry.sk.excerpt, n.entry.excerpt)}</p>}
            {n.entry.author && <p class="text-xs text-stone-400 mt-2">{n.entry.author}</p>}
          </article>
        ))}
    </div>
  )}
</Layout>
