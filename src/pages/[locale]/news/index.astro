---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const loc = locale === 'sk' ? 'sk-SK' : 'en-GB';

type FeedItem =
  | {
      type: 'article';
      slug: string;
      date: string | null;
      title: string;
      excerpt: string | null;
      author: string | null;
    }
  | {
      type: 'event';
      slug: string;
      date: string | null;
      title: string;
      description: string | null;
      time: string | null;
      location: string | null;
    };

const newsItems: FeedItem[] = (await reader.collections.news.all()).map((n) => ({
  type: 'article' as const,
  slug: n.slug,
  date: n.entry.date,
  title: pick(locale, n.entry.sk.title, n.entry.title),
  excerpt: n.entry.excerpt ? pick(locale, n.entry.sk.excerpt, n.entry.excerpt) : null,
  author: n.entry.author,
}));

const eventItems: FeedItem[] = (await reader.collections.events.all()).map((e) => ({
  type: 'event' as const,
  slug: e.slug,
  date: e.entry.date,
  title: pick(locale, e.entry.sk.title, e.entry.title),
  description: e.entry.description ? pick(locale, e.entry.sk.description, e.entry.description) : null,
  time: e.entry.time,
  location: e.entry.location,
}));

const feed = [...newsItems, ...eventItems].sort(
  (a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime(),
);

const featured = feed.find((f) => f.type === 'article') as
  | Extract<FeedItem, { type: 'article' }>
  | undefined;
const rest = featured ? feed.filter((f) => f !== featured) : feed;

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(loc, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
const fmtShort = (date: string | null) =>
  date ? new Date(date).toLocaleDateString(loc, { day: '2-digit', month: 'short' }) : null;
const yearOf = (date: string | null) => (date ? new Date(date).getFullYear() : null);
---

<Layout
  title={dict.news.title}
  description={dict.news.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  {
    feed.length === 0 ? (
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-24">
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight">{dict.news.title}</h1>
        <div class="mt-10">
          <EmptyState message={dict.news.noNews} />
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <header class="flex items-end justify-between gap-6 border-b-4 border-stone-900 pb-5">
          <h1 class="hero-rise text-5xl sm:text-7xl font-bold tracking-tighter leading-none">
            {dict.news.title}
          </h1>
          <p
            class="hero-rise hidden sm:block max-w-xs text-sm text-stone-500 leading-relaxed text-right"
            style="--rise-delay: 80ms"
          >
            {dict.news.subtitle}
          </p>
        </header>

        {featured && (
          <a
            href={`/${locale}/news/${featured.slug}`}
            class="group block border-b border-stone-200 py-10 sm:py-14"
            data-reveal
          >
            <div class="grid lg:grid-cols-[auto_1fr] gap-x-10 gap-y-4 items-start">
              <span class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-emerald-700">
                <span
                  class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse"
                  aria-hidden="true"
                />
                {dict.news.latest}
              </span>
              <div class="min-w-0">
                {featured.date && (
                  <time class="block text-sm text-stone-400 mb-3">
                    {fmtDate(featured.date)}
                  </time>
                )}
                <h2 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.05] text-stone-900 group-hover:text-emerald-700 transition-colors">
                  {featured.title}
                </h2>
                {featured.excerpt && (
                  <p class="mt-5 max-w-2xl text-lg text-stone-600 leading-relaxed">
                    {featured.excerpt}
                  </p>
                )}
                <div class="mt-6 flex items-center gap-4">
                  {featured.author && (
                    <span class="text-sm text-stone-400">{featured.author}</span>
                  )}
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700">
                    {dict.news.readMore}
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                      →
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <section class="mt-12">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">
              {dict.news.allArticles}
            </h2>
            <ol>
              {rest.map((item, i) => {
                const year = yearOf(item.date);
                const prevDate = i === 0 ? featured?.date ?? null : rest[i - 1].date;
                const prevYear = yearOf(prevDate);
                const showYear = year !== null && year !== prevYear;
                return (
                  <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 60}ms`}>
                    {showYear && (
                      <div class="pt-8 pb-1 text-sm font-bold tracking-tight text-stone-300 select-none">
                        {year}
                      </div>
                    )}
                    {item.type === 'article' ? (
                      <a
                        href={`/${locale}/news/${item.slug}`}
                        class="group grid grid-cols-[1fr_auto] sm:grid-cols-[7rem_1fr_auto] items-baseline gap-x-4 sm:gap-x-8 gap-y-1 border-b border-stone-200 py-6"
                      >
                        <time class="hidden sm:block text-sm text-stone-400 tabular-nums group-hover:text-emerald-600 transition-colors">
                          {fmtShort(item.date)}
                        </time>
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="inline-block rounded bg-stone-100 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-stone-500">
                              {dict.news.articleBadge}
                            </span>
                          </div>
                          <h3 class="mt-1 text-xl sm:text-2xl font-semibold tracking-tight text-stone-900 group-hover:text-emerald-700 transition-colors">
                            {item.title}
                          </h3>
                          {item.excerpt && (
                            <p class="mt-1.5 text-sm sm:text-base text-stone-500 leading-relaxed max-w-2xl line-clamp-2">
                              {item.excerpt}
                            </p>
                          )}
                          <div class="mt-2 flex items-center gap-3 text-xs text-stone-400 sm:hidden">
                            {item.date && <time>{fmtDate(item.date)}</time>}
                            {item.author && <span>· {item.author}</span>}
                          </div>
                        </div>
                        <span
                          class="text-emerald-700 font-semibold opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </a>
                    ) : (
                      <div class="group grid grid-cols-[1fr_auto] sm:grid-cols-[7rem_1fr_auto] items-baseline gap-x-4 sm:gap-x-8 gap-y-1 border-b border-stone-200 py-6">
                        <time class="hidden sm:block text-sm text-stone-400 tabular-nums">
                          {fmtShort(item.date)}
                        </time>
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="inline-block rounded bg-emerald-50 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-emerald-700">
                              {dict.news.eventBadge}
                            </span>
                            {item.time && (
                              <span class="text-xs text-stone-400">{item.time}</span>
                            )}
                          </div>
                          <h3 class="mt-1 text-xl sm:text-2xl font-semibold tracking-tight text-stone-900">
                            {item.title}
                          </h3>
                          {item.description && (
                            <p class="mt-1.5 text-sm sm:text-base text-stone-500 leading-relaxed max-w-2xl line-clamp-2">
                              {item.description}
                            </p>
                          )}
                          {item.location && (
                            <p class="mt-1 text-xs text-stone-400">📍 {item.location}</p>
                          )}
                          <div class="mt-2 flex items-center gap-3 text-xs text-stone-400 sm:hidden">
                            {item.date && <time>{fmtDate(item.date)}</time>}
                          </div>
                        </div>
                        <span class="text-stone-300" aria-hidden="true">
                          ◷
                        </span>
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </div>
    )
  }
</Layout>
