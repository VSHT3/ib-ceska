---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const loc = locale === 'sk' ? 'sk-SK' : 'en-GB';

type FeedItem =
  | {
      type: 'article';
      slug: string;
      date: string | null;
      title: string;
      excerpt: string | null;
      author: string | null;
    }
  | {
      type: 'event';
      slug: string;
      date: string | null;
      title: string;
      description: string | null;
      time: string | null;
      location: string | null;
    };

const newsItems: FeedItem[] = (await reader.collections.news.all()).map((n) => ({
  type: 'article' as const,
  slug: n.slug,
  date: n.entry.date,
  title: pick(locale, n.entry.sk.title, n.entry.title),
  excerpt: n.entry.excerpt ? pick(locale, n.entry.sk.excerpt, n.entry.excerpt) : null,
  author: n.entry.author,
}));

const eventItems: FeedItem[] = (await reader.collections.events.all()).map((e) => ({
  type: 'event' as const,
  slug: e.slug,
  date: e.entry.date,
  title: pick(locale, e.entry.sk.title, e.entry.title),
  description: e.entry.description
    ? pick(locale, e.entry.sk.description, e.entry.description)
    : null,
  time: e.entry.time,
  location: e.entry.location,
}));

const feed = [...newsItems, ...eventItems].sort(
  (a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime(),
);

const featured = feed[0];
const rest = feed.slice(1);

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(loc, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : null;
const fmtShort = (date: string | null) =>
  date ? new Date(date).toLocaleDateString(loc, { day: '2-digit', month: 'short' }) : null;
const yearOf = (date: string | null) => (date ? new Date(date).getFullYear() : null);
---

<Layout
  title={dict.news.title}
  description={dict.news.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  {
    feed.length === 0 ? (
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-24">
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight">{dict.news.title}</h1>
        <div class="mt-10">
          <EmptyState message={dict.news.noNews} />
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        {/* Masthead: folio line, nameplate, double rule */}
        <header>
          <div class="hero-rise flex items-baseline justify-between gap-4 border-b border-stone-300 pb-2.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-500">
            <span class="truncate">{dict.site.title}</span>
            <span class="hidden sm:block">Bratislava</span>
            <a
              href="/rss.xml"
              class="shrink-0 rounded-full border border-stone-300 px-2.5 py-0.5 text-[10px] font-bold tracking-widest text-stone-500 transition-colors hover:border-emerald-400 hover:text-emerald-700"
            >
              RSS
            </a>
          </div>
          <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 pt-7">
            <h1
              class="hero-rise text-6xl sm:text-8xl font-bold tracking-tighter leading-[0.9]"
              style="--rise-delay: 80ms"
            >
              {dict.news.title}
            </h1>
            <p
              class="hero-rise max-w-xs pb-1.5 text-sm text-stone-500 leading-relaxed sm:text-right"
              style="--rise-delay: 160ms"
            >
              {dict.news.subtitle}
            </p>
          </div>
          <div class="hero-rise mt-8" style="--rise-delay: 220ms" aria-hidden="true">
            <div class="border-t-4 border-stone-900" />
            <div class="mt-[3px] border-t border-stone-900" />
          </div>
        </header>

        {featured && (
          <a
            href={
              featured.type === 'event'
                ? `/${locale}/events/${featured.slug}`
                : `/${locale}/news/${featured.slug}`
            }
            class="group block border-b border-stone-200 py-10 sm:py-14"
            data-reveal
          >
            <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[1.4fr_1fr]">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold uppercase tracking-widest">
                  <span class="inline-flex items-center gap-2 text-emerald-700">
                    <span
                      class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-600"
                      aria-hidden="true"
                    />
                    {dict.news.latest}
                  </span>
                  {featured.date && <time class="text-stone-400">{fmtDate(featured.date)}</time>}
                </div>
                <h2 class="mt-5 text-4xl font-bold tracking-tighter leading-[0.98] text-stone-900 transition-colors group-hover:text-emerald-700 sm:text-6xl">
                  {featured.title}
                </h2>
              </div>
              <div class="lg:border-l lg:border-stone-200 lg:pl-10 lg:pt-1">
                <p class="text-lg text-stone-600 leading-relaxed">
                  {featured.type === 'event' ? featured.description : featured.excerpt}
                </p>
                <div class="mt-6 flex flex-wrap items-center gap-4">
                  {featured.type === 'article' && featured.author && (
                    <span class="text-sm text-stone-400">{featured.author}</span>
                  )}
                  {featured.type === 'event' && featured.location && (
                    <span class="text-sm text-stone-400">{featured.location}</span>
                  )}
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700">
                    {featured.type === 'event' ? dict.news.readEvent : dict.news.readMore}
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                      →
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <section class="mt-12">
            <h2 class="mb-2 flex items-baseline gap-3 text-xs font-semibold uppercase tracking-widest text-stone-400">
              {dict.news.allArticles}
              <span class="text-stone-300">·</span>
              <span class="text-stone-300 tabular-nums">{rest.length}</span>
            </h2>
            <ol>
              {rest.map((item, i) => {
                const year = yearOf(item.date);
                const prevDate = i === 0 ? (featured?.date ?? null) : rest[i - 1].date;
                const prevYear = yearOf(prevDate);
                const showYear = year !== null && year !== prevYear;
                return (
                  <li data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 60}ms`}>
                    {showYear && (
                      <div
                        class="year-marker select-none pt-10 pb-2 text-6xl font-extrabold leading-none tracking-tighter sm:text-7xl"
                        aria-hidden="true"
                      >
                        {year}
                      </div>
                    )}
                    {item.type === 'article' ? (
                      <a
                        href={`/${locale}/news/${item.slug}`}
                        class="group grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-stone-200 py-6 sm:grid-cols-[7rem_1fr_auto] sm:gap-x-8"
                      >
                        <time class="hidden text-sm text-stone-400 tabular-nums transition-colors group-hover:text-emerald-600 sm:block">
                          {fmtShort(item.date)}
                        </time>
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="inline-block rounded bg-stone-100 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-stone-500">
                              {dict.news.articleBadge}
                            </span>
                          </div>
                          <h3 class="mt-1 text-xl font-semibold tracking-tight text-stone-900 transition-colors group-hover:text-emerald-700 sm:text-2xl">
                            {item.title}
                          </h3>
                          {item.excerpt && (
                            <p class="mt-1.5 max-w-2xl text-sm text-stone-500 leading-relaxed line-clamp-2 sm:text-base">
                              {item.excerpt}
                            </p>
                          )}
                          <div class="mt-2 flex items-center gap-3 text-xs text-stone-400 sm:hidden">
                            {item.date && <time>{fmtDate(item.date)}</time>}
                            {item.author && <span>· {item.author}</span>}
                          </div>
                        </div>
                        <span
                          class="-translate-x-1 font-semibold text-emerald-700 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </a>
                    ) : (
                      <a
                        href={`/${locale}/events/${item.slug}`}
                        class="group grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-stone-200 py-6 sm:grid-cols-[7rem_1fr_auto] sm:gap-x-8"
                      >
                        <time class="hidden text-sm text-stone-400 tabular-nums transition-colors group-hover:text-emerald-600 sm:block">
                          {fmtShort(item.date)}
                        </time>
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="inline-block rounded bg-emerald-50 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-emerald-700">
                              {dict.news.eventBadge}
                            </span>
                            {item.time && <span class="text-xs text-stone-400">{item.time}</span>}
                          </div>
                          <h3 class="mt-1 text-xl font-semibold tracking-tight text-stone-900 transition-colors group-hover:text-emerald-700 sm:text-2xl">
                            {item.title}
                          </h3>
                          {item.description && (
                            <p class="mt-1.5 max-w-2xl text-sm text-stone-500 leading-relaxed line-clamp-2 sm:text-base">
                              {item.description}
                            </p>
                          )}
                          {item.location && (
                            <p class="mt-1 text-xs text-stone-400">{item.location}</p>
                          )}
                          <div class="mt-2 flex items-center gap-3 text-xs text-stone-400 sm:hidden">
                            {item.date && <time>{fmtDate(item.date)}</time>}
                          </div>
                        </div>
                        <span
                          class="-translate-x-1 font-semibold text-emerald-700 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </div>
    )
  }

  <style>
    .year-marker {
      color: var(--color-stone-200);
    }
    @supports (-webkit-text-stroke: 1px black) {
      .year-marker {
        color: transparent;
        -webkit-text-stroke: 2px var(--color-stone-300);
      }
    }
  </style>
</Layout>
