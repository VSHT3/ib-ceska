---
import { reader, pick } from '../../../lib/keystatic';
import Layout from '../../../layouts/Layout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { t } from '../../../i18n/dictionaries';
import type { Locale } from '../../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const loc = locale === 'sk' ? 'sk-SK' : 'en-GB';

type FeedItem =
  | {
      type: 'article';
      slug: string;
      date: string | null;
      title: string;
      excerpt: string | null;
      author: string | null;
    }
  | {
      type: 'event';
      slug: string;
      date: string | null;
      title: string;
      description: string | null;
      time: string | null;
      location: string | null;
    };

const newsItems: FeedItem[] = (await reader.collections.news.all()).map((n) => ({
  type: 'article' as const,
  slug: n.slug,
  date: n.entry.date,
  title: pick(locale, n.entry.sk.title, n.entry.title),
  excerpt: n.entry.excerpt ? pick(locale, n.entry.sk.excerpt, n.entry.excerpt) : null,
  author: n.entry.author,
}));

const eventItems = (await reader.collections.events.all()).map((e) => ({
  type: 'event' as const,
  slug: e.slug,
  date: e.entry.date,
  title: pick(locale, e.entry.sk.title, e.entry.title),
  description: e.entry.description
    ? pick(locale, e.entry.sk.description, e.entry.description)
    : null,
  time: e.entry.time,
  location: e.entry.location,
}));

// Events still ahead of the build date live in the rail; past ones stay in the feed.
const today = new Date().toISOString().slice(0, 10);
const upcoming = eventItems
  .filter((e) => e.date && e.date >= today)
  .sort((a, b) => a.date!.localeCompare(b.date!));
const pastEvents: FeedItem[] = eventItems.filter((e) => !e.date || e.date < today);

const feed = [...newsItems, ...pastEvents].sort(
  (a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime(),
);

const featured = feed[0];
const rest = feed.slice(1);

const fmtDate = (date: string | null) =>
  date
    ? new Date(date).toLocaleDateString(loc, { year: 'numeric', month: 'long', day: 'numeric' })
    : null;
const dayOf = (date: string) => new Date(date).toLocaleDateString(loc, { day: '2-digit' });
const monthOf = (date: string) =>
  new Date(date).toLocaleDateString(loc, { month: 'short' }).replace(/\.$/, '');
const yearOf = (date: string | null) => (date ? new Date(date).getFullYear() : null);
const hrefOf = (item: FeedItem) =>
  item.type === 'event' ? `/${locale}/events/${item.slug}` : `/${locale}/news/${item.slug}`;
---

<Layout
  title={dict.news.title}
  description={dict.news.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <div class="mx-auto max-w-7xl px-6 py-12 sm:py-16 lg:px-12">
    {/* Masthead: folio line, nameplate, double rule */}
    <header>
      <div
        class="hero-rise flex items-baseline justify-between gap-4 border-b border-stone-300 pb-2.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-500"
      >
        <span class="truncate">{dict.site.title}</span>
        <span>Bratislava</span>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 pt-7">
        <h1
          class="hero-rise text-6xl font-bold tracking-tighter leading-[0.9] sm:text-8xl lg:text-9xl"
          style="--rise-delay: 80ms"
        >
          {dict.news.title}
        </h1>
        <p
          class="hero-rise max-w-xs pb-2 text-sm leading-relaxed text-stone-500 sm:text-right"
          style="--rise-delay: 160ms"
        >
          {dict.news.subtitle}
        </p>
      </div>
      <div class="hero-rise mt-8" style="--rise-delay: 220ms" aria-hidden="true">
        <div class="border-t-4 border-stone-900"></div>
        <div class="mt-[3px] border-t border-stone-900"></div>
      </div>
    </header>

    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      {/* Feed */}
      <div class="min-w-0 lg:col-span-8">
        {
          !featured ? (
            <div class="py-16">
              <EmptyState message={dict.news.noNews} />
            </div>
          ) : (
            <a
              href={hrefOf(featured)}
              class="group block border-b border-stone-200 py-10 sm:py-14"
              data-reveal
            >
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold uppercase tracking-widest">
                <span class="inline-flex items-center gap-2 text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-600" aria-hidden="true" />
                  {dict.news.latest}
                </span>
                <span class="text-stone-400">
                  {featured.type === 'event' ? dict.news.eventBadge : dict.news.articleBadge}
                </span>
                {featured.date && <time class="text-stone-400">{fmtDate(featured.date)}</time>}
              </div>
              <h2 class="mt-6 max-w-4xl text-4xl font-bold tracking-tighter leading-[0.98] text-balance text-stone-900 transition-colors group-hover:text-emerald-700 sm:text-5xl lg:text-6xl">
                {featured.title}
              </h2>
              <p class="mt-6 max-w-2xl text-lg leading-relaxed text-stone-600">
                {featured.type === 'event' ? featured.description : featured.excerpt}
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
                {featured.type === 'article' && featured.author && (
                  <span class="text-stone-400">{featured.author}</span>
                )}
                {featured.type === 'event' && featured.location && (
                  <span class="text-stone-400">{featured.location}</span>
                )}
                <span class="inline-flex items-center gap-1.5 font-semibold text-emerald-700">
                  {featured.type === 'event' ? dict.news.readEvent : dict.news.readMore}
                  <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </span>
              </div>
            </a>
          )
        }

        {
          rest.length > 0 && (
            <section class="mt-10">
              <h2 class="flex items-baseline gap-3 text-xs font-semibold uppercase tracking-widest text-stone-400">
                {dict.news.allArticles}
                <span class="text-stone-300">·</span>
                <span class="text-stone-300 tabular-nums">{rest.length}</span>
              </h2>
              <ol class="mt-2">
                {rest.map((item, i) => {
                  const year = yearOf(item.date);
                  const prevDate = i === 0 ? (featured?.date ?? null) : rest[i - 1].date;
                  const showYear = year !== null && year !== yearOf(prevDate);
                  const isEvent = item.type === 'event';
                  return (
                    <li data-reveal style={`--reveal-delay: ${(i % 4) * 60}ms`}>
                      {showYear && (
                        <div
                          class="year-marker select-none pt-10 pb-2 text-6xl font-extrabold leading-none tracking-tighter sm:text-7xl"
                          aria-hidden="true"
                        >
                          {year}
                        </div>
                      )}
                      <a
                        href={hrefOf(item)}
                        class="group grid gap-x-6 gap-y-3 border-b border-stone-200 py-7 sm:grid-cols-[5.5rem_1fr_auto] sm:py-8"
                      >
                        {item.date ? (
                          <time class="flex items-baseline gap-1.5 sm:block">
                            <span class="text-3xl font-extrabold leading-none tracking-tighter text-stone-900 tabular-nums transition-colors group-hover:text-emerald-700 sm:text-4xl">
                              {dayOf(item.date)}
                            </span>
                            <span class="text-xs font-semibold uppercase tracking-widest text-stone-400 sm:mt-1.5 sm:block">
                              {monthOf(item.date)}
                            </span>
                          </time>
                        ) : (
                          <span />
                        )}
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-wide">
                            <span
                              class:list={[
                                'inline-block rounded px-1.5 py-0.5',
                                isEvent
                                  ? 'bg-emerald-50 text-emerald-700'
                                  : 'bg-stone-100 text-stone-500',
                              ]}
                            >
                              {isEvent ? dict.news.eventBadge : dict.news.articleBadge}
                            </span>
                            {isEvent && item.time && (
                              <span class="normal-case tracking-normal text-stone-400">
                                {item.time}
                              </span>
                            )}
                          </div>
                          <h3 class="mt-2 text-xl font-semibold tracking-tight text-stone-900 transition-colors group-hover:text-emerald-700 sm:text-2xl">
                            {item.title}
                          </h3>
                          {(isEvent ? item.description : item.excerpt) && (
                            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-500 line-clamp-2 sm:text-base">
                              {isEvent ? item.description : item.excerpt}
                            </p>
                          )}
                          <p class="mt-2 text-xs text-stone-400">
                            {isEvent ? item.location : item.author}
                          </p>
                        </div>
                        <span
                          class="hidden -translate-x-1 self-center font-semibold text-emerald-700 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100 sm:block"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </section>
          )
        }
      </div>

      {/* Rail: upcoming events + subscribe */}
      <aside class="lg:col-span-4 lg:self-start lg:sticky lg:top-28 lg:pt-10">
        <section class="rounded-3xl bg-stone-900 p-7 text-white sm:p-8" data-reveal>
          <h2
            class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-emerald-300"
          >
            <span class="h-px w-8 bg-current" aria-hidden="true"></span>
            {dict.news.upcoming}
          </h2>
          {
            upcoming.length === 0 ? (
              <p class="mt-5 text-sm leading-relaxed text-stone-400">{dict.news.upcomingEmpty}</p>
            ) : (
              <ol class="mt-5 divide-y divide-white/10">
                {upcoming.map((e) => (
                  <li>
                    <a
                      href={`/${locale}/events/${e.slug}`}
                      class="group grid grid-cols-[3.75rem_1fr] gap-4 py-5 first:pt-1 last:pb-1"
                    >
                      <time class="text-center">
                        <span class="block text-4xl font-extrabold leading-none tracking-tighter tabular-nums">
                          {dayOf(e.date!)}
                        </span>
                        <span class="mt-1 block text-[11px] font-semibold uppercase tracking-widest text-stone-400">
                          {monthOf(e.date!)}
                        </span>
                      </time>
                      <span class="min-w-0">
                        <span class="block font-semibold leading-snug tracking-tight transition-colors group-hover:text-emerald-300">
                          {e.title}
                        </span>
                        <span class="mt-1.5 block text-xs leading-relaxed text-stone-400">
                          {[e.time, e.location].filter(Boolean).join(' · ')}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
        </section>

        <a
          href="/rss.xml"
          class="group mt-5 flex items-center justify-between gap-4 rounded-3xl border border-stone-200 bg-white p-6 transition-colors hover:border-emerald-300"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <span>
            <span class="block font-semibold text-stone-900">{dict.news.subscribe}</span>
            <span class="mt-1 block text-sm text-stone-500">{dict.news.rssNote}</span>
          </span>
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-stone-100 text-xs font-bold tracking-widest text-stone-600 transition-colors group-hover:bg-emerald-100 group-hover:text-emerald-800"
          >
            RSS
          </span>
        </a>
      </aside>
    </div>
  </div>

  <style>
    .year-marker {
      color: var(--color-stone-200);
    }
    @supports (-webkit-text-stroke: 1px black) {
      .year-marker {
        color: transparent;
        -webkit-text-stroke: 2px var(--color-stone-300);
      }
    }
  </style>
</Layout>
