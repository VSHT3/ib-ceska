---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DocumentList from '../../components/DocumentList.astro';
import { t, l } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';
import { guideDocuments, parentDocuments, policyDocuments } from '../../data/documents';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const dict = t(locale);
const policies = dict.policies;

const groups = [
  { title: policies.policiesTitle, intro: policies.policiesIntro, items: policyDocuments },
  { title: policies.guidesTitle, intro: policies.guidesIntro, items: guideDocuments },
  { title: policies.parentsTitle, intro: policies.parentsIntro, items: parentDocuments },
];
---

<Layout
  title={policies.title}
  description={policies.subtitle}
  locale={locale}
  pageSchemaType="CollectionPage"
>
  <PageHeader title={policies.title} subtitle={policies.subtitle} label={policies.label} />

  <!-- Document groups: hairline-separated rows, sticky left rail with ghost numerals -->
  <div class="mx-auto max-w-7xl px-6 lg:px-12 pt-16 sm:pt-20 pb-20 sm:pb-28">
    <div class="divide-y divide-stone-200">
      {
        groups.map((group, index) => (
          <section
            class="grid items-start gap-8 py-14 first:pt-0 sm:py-16 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <div class="lg:sticky lg:top-24 self-start">
              <span
                class="select-none text-6xl sm:text-7xl font-extrabold leading-none tracking-tighter text-stone-200"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-stone-900">
                {group.title}
              </h2>
              <p class="mt-4 max-w-md text-sm text-stone-600 leading-relaxed">{group.intro}</p>
            </div>
            <DocumentList items={group.items} locale={locale} tone="dp" />
          </section>
        ))
      }
    </div>
  </div>

  <!-- Admissions hand-off: full-bleed dark band, content in shell -->
  <section class="bg-stone-900 text-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 py-20 sm:py-24" data-reveal>
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">
            {policies.admissionsTitle}
          </h2>
          <p class="mt-4 max-w-xl text-stone-300 leading-relaxed">{policies.admissionsBody}</p>
        </div>
        <div class="flex flex-col items-start gap-4 lg:col-span-4 lg:col-start-9 lg:items-end">
          <a
            href={l('/admissions', locale)}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-600"
          >
            {policies.admissionsCta}
          </a>
          <a
            href={l('/mission', locale)}
            class="group inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 hover:text-emerald-200 transition-colors"
          >
            {policies.missionCta}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
