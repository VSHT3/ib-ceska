---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { contact, t } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/dictionaries';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'sk' } }];
}

const locale = (Astro.params.locale ?? 'en') as Locale;
const copy = t(locale).privacy;
---

<Layout title={copy.title} description={copy.subtitle} locale={locale}>
  <PageHeader tone="stone" title={copy.title} subtitle={copy.subtitle} />

  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-12">
    <article class="rich-text max-w-[68ch]">
      <p class="text-sm text-stone-500">{copy.updated}</p>
      <h2>{copy.controllerHeading}</h2>
      <p>
        {copy.controllerBody}{' '}
        <a href={`mailto:${contact.email}`} data-umami-event="mail-click">{contact.email}</a>.
      </p>
      {
        copy.sections.map(({ heading, body }) => (
          <>
            <h2>{heading}</h2>
            <p>{body}</p>
          </>
        ))
      }
    </article>
  </div>
</Layout>
