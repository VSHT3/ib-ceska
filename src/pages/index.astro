---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Home"
    description="IB Diploma Programme at Súkromné Gymnázium Česká — subjects, CAS, TOK, Extended Essay and news"
>
    <section class="py-12 text-center">
        <h1 class="text-4xl font-bold tracking-tight mb-4">
            International Baccalaureate — Súkromné Gymnázium "Česká"
        </h1>
        <p class="text-lg text-stone-600 max-w-2xl mx-auto">
            Welcome to the IB programme site. Here you will find information
            about the diploma subjects, CAS activities, Theory of Knowledge,
            Extended Essay and school news.
        </p>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        <a
            href="/subjects"
            class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md hover:border-emerald-300 transition-all"
        >
            <h2 class="text-xl font-semibold mb-2">Subjects</h2>
            <p class="text-stone-600 text-sm">
                Overview of IB subjects by group (1–6), including syllabuses and
                teachers.
            </p>
        </a>
        <a
            href="/cas"
            class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md hover:border-emerald-300 transition-all"
        >
            <h2 class="text-xl font-semibold mb-2">CAS</h2>
            <p class="text-stone-600 text-sm">
                Creativity, Activity, Service — student projects and activities.
            </p>
        </a>
        <a
            href="/tok"
            class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md hover:border-emerald-300 transition-all"
        >
            <h2 class="text-xl font-semibold mb-2">TOK</h2>
            <p class="text-stone-600 text-sm">
                Theory of Knowledge — essays, themes and discussion materials.
            </p>
        </a>
        <a
            href="/ee"
            class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md hover:border-emerald-300 transition-all"
        >
            <h2 class="text-xl font-semibold mb-2">Extended Essay</h2>
            <p class="text-stone-600 text-sm">
                Guide to writing the EE, deadlines, forms and sample essays.
            </p>
        </a>
        <a
            href="/news"
            class="block rounded-xl border border-stone-200 bg-white p-6 hover:shadow-md hover:border-emerald-300 transition-all"
        >
            <h2 class="text-xl font-semibold mb-2">News</h2>
            <p class="text-stone-600 text-sm">
                Announcements, exam dates and important notices.
            </p>
        </a>
    </section>
</Layout>
