---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const essays = await getCollection("tok");
---

<Layout
    title="Theory of Knowledge"
    description="TOK — Theory of Knowledge materials and essays"
>
    <h1 class="text-3xl font-bold mb-2">Theory of Knowledge</h1>
    <p class="text-stone-600 mb-8">
        TOK examines the nature of knowledge and the ways we know what we claim
        to know. Students critically reflect on different areas of knowledge and
        ways of knowing.
    </p>

    <section>
        <h2 class="text-xl font-semibold mb-4 text-emerald-800">
            TOK essays and materials
        </h2>
        {
            essays.length === 0 ? (
                <p class="text-sm text-stone-400">No materials yet.</p>
            ) : (
                <div class="grid gap-3">
                    {essays
                        .sort(
                            (a, b) =>
                                b.data.date.getTime() - a.data.date.getTime(),
                        )
                        .map((e) => (
                            <div class="rounded-lg border border-stone-200 bg-white p-4">
                                <div class="flex items-center justify-between mb-1">
                                    <h3 class="font-semibold">
                                        {e.data.title}
                                    </h3>
                                    <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">
                                        {e.data.theme}
                                    </span>
                                </div>
                                <time class="text-xs text-stone-400">
                                    {e.data.date.toLocaleDateString("en-GB")}
                                </time>
                                <p class="text-sm text-stone-600 mt-1">
                                    {e.data.description}
                                </p>
                            </div>
                        ))}
                </div>
            )
        }
    </section>
</Layout>
