---
import { reader } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';

const allSubjects = await reader.collections.subjects.all();
const groups = [
  { key: '1', label: 'Group 1 — Studies in Language and Literature' },
  { key: '2', label: 'Group 2 — Language Acquisition' },
  { key: '3', label: 'Group 3 — Individuals and Societies' },
  { key: '4', label: 'Group 4 — Sciences' },
  { key: '5', label: 'Group 5 — Mathematics' },
  { key: '6', label: 'Group 6 — The Arts' },
  { key: 'core', label: 'Core — TOK, CAS, EE' },
];
---

<Layout title="Subjects" description="IB subject listings by group">
  <h1 class="text-3xl font-bold mb-8">IB Subjects</h1>

  {
    groups.map((group) => {
      const groupSubjects = allSubjects
        .filter((s) => s.entry.group === group.key)
        .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0));

      if (groupSubjects.length === 0) return null;

      return (
        <section class="mb-10">
          <h2 class="text-xl font-semibold mb-3 text-emerald-800">
            {group.label}
          </h2>
          <div class="grid gap-3">
            {groupSubjects.map((s) => (
              <div class="rounded-lg border border-stone-200 bg-white p-4">
                <div class="flex items-center justify-between mb-1">
                  <h3 class="font-semibold">{s.entry.title}</h3>
                  {s.entry.level && (
                    <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-medium">
                      {s.entry.level}
                    </span>
                  )}
                </div>
                <p class="text-sm text-stone-600">{s.entry.description}</p>
                {s.entry.teacher && (
                  <p class="text-xs text-stone-400 mt-1">
                    Teacher: {s.entry.teacher}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
