---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Extended Essay"
    description="Extended Essay — independent 4,000-word research project"
>
    <h1 class="text-3xl font-bold mb-2">Extended Essay</h1>
    <p class="text-stone-600 mb-8">
        The Extended Essay is an independent 4,000-word research project.
        Students select a topic from one of the IB subjects and work under the
        guidance of a supervisor.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-xl border border-stone-200 bg-white p-6">
            <h2 class="text-lg font-semibold mb-2">Timeline</h2>
            <ul class="text-sm text-stone-600 space-y-2">
                <li>October – topic and supervisor selection</li>
                <li>November – research proposal submission</li>
                <li>January – first draft</li>
                <li>March – final version</li>
                <li>April – viva voce (oral defense)</li>
            </ul>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-6">
            <h2 class="text-lg font-semibold mb-2">Downloads</h2>
            <ul class="text-sm text-stone-600 space-y-2">
                <li>
                    <a href="#" class="text-emerald-700 hover:underline">
                        EE Guide (PDF)
                    </a>
                </li>
                <li>
                    <a href="#" class="text-emerald-700 hover:underline">
                        RPPF Form
                    </a>
                </li>
                <li>
                    <a href="#" class="text-emerald-700 hover:underline">
                        Assessment criteria
                    </a>
                </li>
            </ul>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-6">
            <h2 class="text-lg font-semibold mb-2">Useful resources</h2>
            <ul class="text-sm text-stone-600 space-y-2">
                <li>
                    <a
                        href="https://www.ibo.org/programmes/diploma-programme/curriculum/dp-core/extended-essay/"
                        class="text-emerald-700 hover:underline"
                        target="_blank"
                    >
                        Official IBO page
                    </a>
                </li>
                <li>
                    <a href="#" class="text-emerald-700 hover:underline">
                        Sample successful EEs
                    </a>
                </li>
                <li>
                    <a href="#" class="text-emerald-700 hover:underline">
                        Citation guide
                    </a>
                </li>
            </ul>
        </div>
    </div>
</Layout>
