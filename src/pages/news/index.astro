---
import { reader } from '../../lib/keystatic';
import Layout from '../../layouts/Layout.astro';

const allNews = await reader.collections.news.all();
---

<Layout title="News" description="IB programme announcements and updates">
  <h1 class="text-3xl font-bold mb-8">News</h1>

  {allNews.length === 0 ? (
    <p class="text-stone-400">No news yet.</p>
  ) : (
    <div class="grid gap-6">
      {allNews
        .sort((a, b) => new Date(b.entry.date).getTime() - new Date(a.entry.date).getTime())
        .map((n) => (
          <article class="rounded-xl border border-stone-200 bg-white p-6">
            <time class="text-xs text-stone-400">
              {new Date(n.entry.date).toLocaleDateString('en-GB', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="text-xl font-semibold mt-1 mb-2">{n.entry.title}</h2>
            {n.entry.excerpt && (
              <p class="text-stone-600">{n.entry.excerpt}</p>
            )}
            {n.entry.author && (
              <p class="text-xs text-stone-400 mt-2">{n.entry.author}</p>
            )}
          </article>
        ))}
    </div>
  )}
</Layout>
