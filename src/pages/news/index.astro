---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const news = await getCollection("news");
---

<Layout
    title="News"
    description="Updates and announcements from the IB programme"
>
    <h1 class="text-3xl font-bold mb-8">News</h1>

    {
        news.length === 0 ? (
            <p class="text-stone-400">No news yet.</p>
        ) : (
            <div class="grid gap-6">
                {news
                    .sort(
                        (a, b) => b.data.date.getTime() - a.data.date.getTime(),
                    )
                    .map((n) => (
                        <article class="rounded-xl border border-stone-200 bg-white p-6">
                            <time class="text-xs text-stone-400">
                                {n.data.date.toLocaleDateString("en-GB", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </time>
                            <h2 class="text-xl font-semibold mt-1 mb-2">
                                {n.data.title}
                            </h2>
                            {n.data.excerpt && (
                                <p class="text-stone-600">{n.data.excerpt}</p>
                            )}
                            {n.data.author && (
                                <p class="text-xs text-stone-400 mt-2">
                                    {n.data.author}
                                </p>
                            )}
                        </article>
                    ))}
            </div>
        )
    }
</Layout>
