{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "preset": "recommended"
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "*.config.ts",
      "*.config.mjs",
      "package.json",
      "!**/dist",
      "!**/node_modules",
      "!**/.astro",
      "!src/content"
    ]
  }
}
