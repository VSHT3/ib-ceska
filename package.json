{
  "name": "ib-ceska",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "prebuild": "astro sync",
    "prebuild:cloudflare": "astro sync",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,mdx,ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "biome check --write"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@markdoc/markdoc": "^0.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "animejs": "^4.5.0",
    "astro": "^7.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.128.0"
  }
}
